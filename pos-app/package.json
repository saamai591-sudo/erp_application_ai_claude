{
  "name": "erp-pos",
  "productName": "ERP Pos",
  "version": "1.5.1",
  "description": "برنامه‌ی دسکتاپ صندوق: ERP + کارتخوان و چاپ مستقیم",
  "main": "main.mjs",
  "type": "module",
  "private": true,
  "author": "Saam",
  "scripts": {
    "prepare": "node scripts/prepare.mjs",
    "start": "node scripts/prepare.mjs && electron .",
    "dist": "node scripts/prepare.mjs && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ir.saam.erp.pos",
    "productName": "ERP Pos",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.mjs", "preload.cjs", "preload-main.cjs", "setup.html", "offline.html", "drivers/**/*", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon.png", "signAndEditExecutable": false },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
