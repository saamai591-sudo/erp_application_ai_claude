# برای docker-compose.prod.yml: این فایل را به نام .env کپی کنید و مقادیر را با رشته‌های تصادفی قوی پر کنید
# (مثلاً: openssl rand -base64 32). .env هرگز نباید commit شود.
POSTGRES_PASSWORD=
JWT_SECRET=

# (اختیاری) کلید رمزنگاری کلید خصوصی «حافظه مالیاتی»؛ اگر خالی باشد از JWT_SECRET مشتق می‌شود. بعد از ساخت اولین حافظه مالیاتی عوض نکنید.
# TAX_KEY_ENCRYPTION_SECRET=

# (اختیاری) ارسال صورتحساب به سامانه مودیان. پیش‌فرض خاموش؛ با true ارسال «واقعی» (و قانونی) روشن می‌شود.
# آدرس پایه‌ی API نسخه‌ی قبلی (self-tsp)؛ همان مقدارِ تنظیم «TaxRealApiUrl» سیستم قبلی (سام) را بگذارید.
# اگر زنجیره‌ی گواهی سایت سازمان در سرور شناخته نیست، TAX_API_INSECURE_TLS=true (مثل SDK رسمی) یا NODE_EXTRA_CA_CERTS را تنظیم کنید.
# TAX_TRANSPORT_ENABLED=false
# TAX_API_BASE_URL=https://tp.tax.gov.ir/req/api/
# TAX_API_INSECURE_TLS=false
