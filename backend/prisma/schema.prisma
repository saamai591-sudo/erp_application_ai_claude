generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Permission {
  id        Int              @id @default(autoincrement())
  module    String
  form      String
  operation String
  code      String           @unique
  roles     RolePermission[]
}

model Role {
  id          Int              @id @default(autoincrement())
  code        Int              @unique
  title       String           @unique
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id                       Int                     @id @default(autoincrement())
  code                     Int                     @unique
  mobile                   String                  @unique @db.VarChar(10)
  firstName                String
  lastName                 String
  isActive                 Boolean                 @default(true)
  passwordHash             String
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  hasTransactions          Boolean                 @default(false)
  partyId                  Int?
  goodsRequestsApproved    GoodsRequest[]          @relation("GoodsRequestApprover")
  goodsRequestsReviewed    GoodsRequest[]          @relation("GoodsRequestReviewer")
  purchaseRequestsApproved PurchaseRequest[]       @relation("PurchaseRequestApprover")
  purchaseRequestsReviewed PurchaseRequest[]       @relation("PurchaseRequestReviewer")
  supplyRequestsApproved   SupplyRequest[]         @relation("SupplyRequestApprover")
  supplyRequestsReviewed   SupplyRequest[]         @relation("SupplyRequestReviewer")
  party                    Party?                  @relation(fields: [partyId], references: [id])
  roles                    UserRole[]
  inventoryClosings        InventoryClosing[]
  inventoryClosingAudits   InventoryClosingAudit[]
  goodsPricingStatuses     GoodsPricingStatus[]
  purchaseInvoicesApproved PurchaseInvoice[]       @relation("PurchaseInvoiceApprover")
}

model UserRole {
  userId Int
  roleId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Currency {
  id               Int                  @id @default(autoincrement())
  code             String               @unique
  title            String               @unique
  decimalPlaces    Int                  @default(2)
  isBase           Boolean              @default(false)
  rateDirection    RateDirection?
  baseVolume       Int                  @default(1)
  hasTransactions  Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  closingLines     AccountClosingLine[]
  cheques          ChequeItem[]
  rates            ExchangeRate[]
  journalLines     JournalEntryLine[]
  payments         Payment[]
  priceInquiries   PriceInquiry[]
  purchaseInvoices PurchaseInvoice[]
  purchaseOrders   PurchaseOrder[]
  receipts         Receipt[]
  salesInvoices    SalesInvoice[]
  salesOrders      SalesOrder[]
  salesQuotes      SalesQuote[]
}

model ExchangeRate {
  id         Int      @id @default(autoincrement())
  date       DateTime @db.Date
  currencyId Int
  rate       Decimal  @db.Decimal(18, 6)
  createdAt  DateTime @default(now())
  currency   Currency @relation(fields: [currencyId], references: [id])

  @@unique([date, currencyId])
}

model FiscalPeriod {
  id                        Int                        @id @default(autoincrement())
  code                      String                     @unique
  title                     String                     @unique @db.VarChar(4)
  fromDate                  DateTime                   @db.Date
  toDate                    DateTime                   @db.Date
  hasTransactions           Boolean                    @default(false)
  createdAt                 DateTime                   @default(now())
  accountClosings           AccountClosing[]
  chequeDeposits            ChequeDeposit[]
  chequeDepositReturns      ChequeDepositReturn[]
  chequeClearingReceivables ChequeClearingReceivable[]
  chequeClearingPayables    ChequeClearingPayable[]
  deliveryAuthorizations    DeliveryAuthorization[]
  goodsRequests             GoodsRequest[]
  initialInventories        InitialInventory[]
  inquiryAuthorizations     InquiryAuthorization[]
  inquiryEvaluations        InquiryEvaluation[]
  journalEntries            JournalEntry[]
  openingClosingEntries     OpeningClosingEntry[]
  payments                  Payment[]
  priceInquiries            PriceInquiry[]
  purchaseInvoices          PurchaseInvoice[]
  purchaseOrders            PurchaseOrder[]
  purchasePlannings         PurchasePlanning[]
  purchaseRequests          PurchaseRequest[]
  receipts                  Receipt[]
  salesDeliveries           SalesDelivery[]
  salesInvoices             SalesInvoice[]
  salesOrders               SalesOrder[]
  salesQuotes               SalesQuote[]
  supplyRequests            SupplyRequest[]
  warehouseAdjustments      WarehouseAdjustment[]
  warehouseIssues           WarehouseIssue[]
  warehouseReceipts         WarehouseReceipt[]
  warehouseTransfers        WarehouseTransfer[]
  inventoryDocuments        InventoryDocument[]
  reportingPeriods          ReportingPeriod[]
}

enum ReportingPeriodStatus {
  OPEN
  CLOSED
}

model ReportingPeriod {
  id             Int                   @id @default(autoincrement())
  fiscalPeriodId Int
  code           String
  title          String
  fromDate       DateTime              @db.Date
  toDate         DateTime              @db.Date
  status         ReportingPeriodStatus @default(OPEN)
  hasBeenClosed  Boolean               @default(false)
  createdAt      DateTime              @default(now())
  fiscalPeriod   FiscalPeriod          @relation(fields: [fiscalPeriodId], references: [id])
  pricingStatuses GoodsPricingStatus[]

  @@unique([fiscalPeriodId, code])
}

model OrgStructure {
  id       Int            @id @default(autoincrement())
  parentId Int?
  code     String
  title    String
  parent   OrgStructure?  @relation("OrgTree", fields: [parentId], references: [id])
  children OrgStructure[] @relation("OrgTree")
  orgUnits OrgUnit[]

  @@unique([parentId, code])
}

model GeoRegion {
  id        Int            @id @default(autoincrement())
  parentId  Int?
  level     GeoLevel
  code      String
  title     String
  parent    GeoRegion?     @relation("GeoTree", fields: [parentId], references: [id])
  children  GeoRegion[]    @relation("GeoTree")
  addresses PartyAddress[]

  @@unique([parentId, code])
}

model DetailType {
  id                Int               @id @default(autoincrement())
  code              Int               @unique
  title             String            @unique
  codeLength        Int               @default(5)
  startNumber       Int
  endNumber         Int
  manualEntry       Boolean           @default(false)
  accountsAsDetail1 Account[]         @relation("AccountDetailType1")
  accountsAsDetail2 Account[]         @relation("AccountDetailType2")
  accountsAsDetail3 Account[]         @relation("AccountDetailType3")
  codes             DetailCodeUsage[]
}

model DetailCodeUsage {
  id           Int        @id @default(autoincrement())
  code         String     @unique
  detailTypeId Int
  entityTable  String
  entityId     Int
  createdAt    DateTime   @default(now())
  detailType   DetailType @relation(fields: [detailTypeId], references: [id])
}

model Party {
  id                 Int                 @id @default(autoincrement())
  detailCode         String              @unique
  category           PartyCategory
  nationality        Nationality         @default(LOCAL)
  nationalId         String?
  foreignId          String?
  economicCode       String?
  firstName          String?
  lastName           String?
  legalType          LegalPartyType?
  name               String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  hasTransactions    Boolean             @default(false)
  isActive           Boolean             @default(true)
  bankAccountsAsBank BankAccount[]       @relation("BankAccountBankParty")
  bankBranches       BankBranch[]        @relation("BankParty")
  cheques            ChequeItem[]
  customer           Customer?
  goodsRequestLines  GoodsRequestLine[]
  addresses          PartyAddress[]
  bankAccounts       PartyBankAccount[]
  phones             PartyPhone[]
  payments           Payment[]
  purchaseExpert     PurchaseExpert?
  purchaseInvoices   PurchaseInvoice[]
  receipts           Receipt[]
  supplier           Supplier?
  users              User[]
  warehousesManaged  Warehouse[]         @relation("WarehouseManager")
  warehouseReceipts  WarehouseReceipt[]
  batchesAsSupplier  Batch[]             @relation("BatchSupplier")
  inventoryDocuments InventoryDocument[]
}

model PartyAddress {
  id         Int         @id @default(autoincrement())
  partyId    Int
  type       AddressType
  cityId     Int
  address    String?
  postalCode String?
  isPrimary  Boolean     @default(false)
  city       GeoRegion   @relation(fields: [cityId], references: [id])
  party      Party       @relation(fields: [partyId], references: [id], onDelete: Cascade)
}

model PartyPhone {
  id        Int       @id @default(autoincrement())
  partyId   Int
  type      PhoneType
  number    String
  isPrimary Boolean   @default(false)
  party     Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)
}

model PartyBankAccount {
  id            Int     @id @default(autoincrement())
  partyId       Int
  bankPartyId   Int?
  accountNumber String?
  iban          String?
  cardNumber    String?
  party         Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)
}

model BankAccountType {
  id            Int           @id @default(autoincrement())
  code          Int           @unique
  title         String        @unique
  hasChequeBook Boolean       @default(false)
  bankAccounts  BankAccount[]
}

model BankBranch {
  id                           Int                     @id @default(autoincrement())
  code                         Int
  title                        String                  @unique
  bankPartyId                  Int
  hasTransactions              Boolean                 @default(false)
  bankAccounts                 BankAccount[]
  bankParty                    Party                   @relation("BankParty", fields: [bankPartyId], references: [id])
  cheques                      ChequeItem[]
  paymentInstrumentChequeLines PaymentInstrumentLine[] @relation("PaymentInstrumentChequeBankBranch")
  receiptInstrumentChequeLines ReceiptInstrumentLine[] @relation("ReceiptInstrumentChequeBankBranch")

  @@unique([bankPartyId, code])
}

model BankAccount {
  id                     Int                     @id @default(autoincrement())
  detailCode             String                  @unique
  accountTypeId          Int
  bankBranchId           Int
  accountNumber          String
  currencyId             Int?
  bankPartyId            Int?
  hasTransactions        Boolean                 @default(false)
  accountType            BankAccountType         @relation(fields: [accountTypeId], references: [id])
  bankBranch             BankBranch              @relation(fields: [bankBranchId], references: [id])
  bankParty              Party?                  @relation("BankAccountBankParty", fields: [bankPartyId], references: [id])
  chequesOwned           ChequeItem[]
  paymentInstrumentLines PaymentInstrumentLine[] @relation("PaymentInstrumentBankAccount")
  receiptInstrumentLines ReceiptInstrumentLine[] @relation("ReceiptInstrumentBankAccount")
  chequeDeposits         ChequeDeposit[]

  @@unique([bankPartyId, accountNumber])
}

model CostCenter {
  id                 Int                 @id @default(autoincrement())
  detailCode         String              @unique
  title              String              @unique
  type               CostCenterType      @default(ADMIN)
  orgUnitId          Int
  hasTransactions    Boolean             @default(false)
  orgUnit            OrgUnit             @relation(fields: [orgUnitId], references: [id])
  goodsRequestLines  GoodsRequestLine[]
  warehouseIssues    WarehouseIssue[]
  inventoryDocuments InventoryDocument[]
}

model OrgUnit {
  id               Int               @id @default(autoincrement())
  code             Int               @unique
  title            String            @unique
  orgStructureId   Int
  hasTransactions  Boolean           @default(false)
  costCenters      CostCenter[]
  goodsRequests    GoodsRequest[]
  orgStructure     OrgStructure      @relation(fields: [orgStructureId], references: [id])
  purchaseRequests PurchaseRequest[]
  supplyRequests   SupplyRequest[]
}

model CashBox {
  id                     Int                     @id @default(autoincrement())
  detailCode             String                  @unique
  title                  String                  @unique
  hasTransactions        Boolean                 @default(false)
  paymentInstrumentLines PaymentInstrumentLine[]
  receiptInstrumentLines ReceiptInstrumentLine[]
}

model ReportingLevel {
  id         Int       @id @default(autoincrement())
  order      Int       @unique
  title      String    @unique
  codeLength Int
  accounts   Account[]
}

model OlapReport {
  id        Int      @id @default(autoincrement())
  title     String   @unique
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                             Int                             @id @default(autoincrement())
  parentId                       Int?
  levelId                        Int
  code                           String
  title                          String
  natureGroup                    AccountNatureGroup?
  natureDetail                   AccountNatureDetail?
  balanceNature                  BalanceNature?
  isCurrency                     Boolean                         @default(false)
  isRevaluable                   Boolean                         @default(false)
  detailType1Id                  Int?
  detailType2Id                  Int?
  detailType3Id                  Int?
  hasTransactions                Boolean                         @default(false)
  createdAt                      DateTime                        @default(now())
  detailType1                    DetailType?                     @relation("AccountDetailType1", fields: [detailType1Id], references: [id])
  detailType2                    DetailType?                     @relation("AccountDetailType2", fields: [detailType2Id], references: [id])
  detailType3                    DetailType?                     @relation("AccountDetailType3", fields: [detailType3Id], references: [id])
  level                          ReportingLevel                  @relation(fields: [levelId], references: [id])
  parent                         Account?                        @relation("AccountTree", fields: [parentId], references: [id])
  children                       Account[]                       @relation("AccountTree")
  closingDestinations            AccountClosing[]                @relation("ClosingDestination")
  closingLines                   AccountClosingLine[]            @relation("ClosingLineAccount")
  goodsServiceAccountingSettings GoodsServiceAccountingSetting[]
  lines                          JournalEntryLine[]

  @@unique([parentId, code])
}

model DocumentType {
  id             Int            @id @default(autoincrement())
  code           Int            @unique
  title          String         @unique
  isSystem       Boolean        @default(false)
  systemKey      String?        @unique
  journalEntries JournalEntry[]
}

model JournalEntry {
  id                  Int                  @id @default(autoincrement())
  fiscalPeriodId      Int
  number              Int
  referenceNumber     Int
  dailyNumber         Int
  date                DateTime             @db.Date
  documentTypeId      Int
  description         String?
  status              JournalEntryStatus   @default(DRAFT)
  isManual            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  issuingSystem       IssuingSystem        @default(ACCOUNTING)
  accountClosing      AccountClosing?
  documentType        DocumentType         @relation(fields: [documentTypeId], references: [id])
  fiscalPeriod        FiscalPeriod         @relation(fields: [fiscalPeriodId], references: [id])
  lines               JournalEntryLine[]
  sources             JournalEntrySource[]
  openingClosingEntry OpeningClosingEntry?

  @@unique([fiscalPeriodId, number])
}

model JournalEntrySource {
  id             Int          @id @default(autoincrement())
  journalEntryId Int
  label          String
  path           String
  createdAt      DateTime     @default(now())
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
}

model JournalEntryLine {
  id             Int          @id @default(autoincrement())
  journalEntryId Int
  accountId      Int
  detail1Code    String?
  detail2Code    String?
  detail3Code    String?
  currencyId     Int
  debit          Decimal      @default(0) @db.Decimal(18, 2)
  credit         Decimal      @default(0) @db.Decimal(18, 2)
  fxRate         Decimal      @default(1) @db.Decimal(18, 6)
  baseDebit      Decimal      @default(0) @db.Decimal(18, 2)
  baseCredit     Decimal      @default(0) @db.Decimal(18, 2)
  description    String?
  rowOrder       Int          @default(0)
  account        Account      @relation(fields: [accountId], references: [id])
  currency       Currency     @relation(fields: [currencyId], references: [id])
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
}

model AccountClosing {
  id                   Int                  @id @default(autoincrement())
  fiscalPeriodId       Int
  number               Int
  date                 DateTime             @db.Date
  destinationAccountId Int
  detail1Code          String?
  detail2Code          String?
  detail3Code          String?
  description          String
  totalDebit           Decimal              @default(0) @db.Decimal(18, 2)
  totalCredit          Decimal              @default(0) @db.Decimal(18, 2)
  difference           Decimal              @default(0) @db.Decimal(18, 2)
  journalEntryId       Int?                 @unique
  createdAt            DateTime             @default(now())
  destinationAccount   Account              @relation("ClosingDestination", fields: [destinationAccountId], references: [id])
  fiscalPeriod         FiscalPeriod         @relation(fields: [fiscalPeriodId], references: [id])
  journalEntry         JournalEntry?        @relation(fields: [journalEntryId], references: [id])
  lines                AccountClosingLine[]

  @@unique([fiscalPeriodId, number])
}

model AccountClosingLine {
  id          Int            @id @default(autoincrement())
  closingId   Int
  accountId   Int
  detail1Code String?
  detail2Code String?
  detail3Code String?
  currencyId  Int
  debit       Decimal        @default(0) @db.Decimal(18, 2)
  credit      Decimal        @default(0) @db.Decimal(18, 2)
  fxRate      Decimal        @default(1) @db.Decimal(18, 6)
  baseDebit   Decimal        @default(0) @db.Decimal(18, 2)
  baseCredit  Decimal        @default(0) @db.Decimal(18, 2)
  account     Account        @relation("ClosingLineAccount", fields: [accountId], references: [id])
  closing     AccountClosing @relation(fields: [closingId], references: [id], onDelete: Cascade)
  currency    Currency       @relation(fields: [currencyId], references: [id])
}

model OpeningClosingEntry {
  id             Int                @id @default(autoincrement())
  fiscalPeriodId Int
  number         Int
  date           DateTime           @db.Date
  type           OpeningClosingType
  description    String
  journalEntryId Int?               @unique
  createdAt      DateTime           @default(now())
  fiscalPeriod   FiscalPeriod       @relation(fields: [fiscalPeriodId], references: [id])
  journalEntry   JournalEntry?      @relation(fields: [journalEntryId], references: [id])

  @@unique([fiscalPeriodId, type])
  @@unique([fiscalPeriodId, number])
}

model ImportJob {
  id            Int      @id @default(autoincrement())
  entityType    String
  status        String   @default("PENDING")
  totalRows     Int      @default(0)
  processedRows Int      @default(0)
  successCount  Int      @default(0)
  errorCount    Int      @default(0)
  resultData    Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model UnitOfMeasure {
  id                         Int                         @id @default(autoincrement())
  code                       Int                         @unique
  title                      String                      @unique
  isWeight                   Boolean                     @default(false)
  kgEquivalent               Decimal?                    @db.Decimal(18, 6)
  hasTransactions            Boolean                     @default(false)
  createdAt                  DateTime                    @default(now())
  deliveryAuthorizationLines DeliveryAuthorizationLine[]
  mainOfItems                GoodsItem[]                 @relation("GoodsItemMainUnit")
  weightOfItems              GoodsItem[]                 @relation("GoodsItemWeightUnit")
  goodsRequestLines          GoodsRequestLine[]
  initialInventoryLines      InitialInventoryLine[]
  priceInquiryItemLines      PriceInquiryItemLine[]
  purchaseInvoiceLines       PurchaseInvoiceLine[]
  purchaseOrderLines         PurchaseOrderLine[]
  purchasePlanningStage1Rows PurchasePlanningStage1Row[]
  purchasePlanningStage2Rows PurchasePlanningStage2Row[]
  purchaseRequestLines       PurchaseRequestLine[]
  salesDeliveryLines         SalesDeliveryLine[]
  salesInvoiceLines          SalesInvoiceLine[]
  salesOrderLines            SalesOrderLine[]
  salesQuoteLines            SalesQuoteLine[]
  supplyRequestLines         SupplyRequestLine[]
  warehouseAdjustmentLines   WarehouseAdjustmentLine[]
  warehouseIssueLines        WarehouseIssueLine[]
  warehouseReceiptLines      WarehouseReceiptLine[]
  warehouseTransferLines     WarehouseTransferLine[]
  inventoryDocumentLines     InventoryDocumentLine[]
}

model WarehouseGroup {
  id                 Int                             @id @default(autoincrement())
  code               Int                             @unique
  title              String                          @unique
  isActive           Boolean                         @default(true)
  hasTransactions    Boolean                         @default(false)
  createdAt          DateTime                        @default(now())
  accountingSettings GoodsServiceAccountingSetting[]
  warehouses         Warehouse[]
}

model Warehouse {
  id                         Int                     @id @default(autoincrement())
  code                       Int                     @unique
  title                      String                  @unique
  warehouseGroupId           Int
  address                    String?
  phone                      String?
  managerId                  Int?
  stockControl               Boolean                 @default(true)
  isActive                   Boolean                 @default(true)
  hasTransactions            Boolean                 @default(false)
  createdAt                  DateTime                @default(now())
  initialInventories         InitialInventory[]
  salesDeliveries            SalesDelivery[]
  manager                    Party?                  @relation("WarehouseManager", fields: [managerId], references: [id])
  warehouseGroup             WarehouseGroup          @relation(fields: [warehouseGroupId], references: [id])
  warehouseAdjustments       WarehouseAdjustment[]
  warehouseIssues            WarehouseIssue[]
  warehouseReceipts          WarehouseReceipt[]
  warehouseTransfersAsDest   WarehouseTransfer[]     @relation("WarehouseTransferDest")
  warehouseTransfersAsSource WarehouseTransfer[]     @relation("WarehouseTransferSource")
  physicalLocations          PhysicalLocation[]
  inventoryDocuments         InventoryDocument[]     @relation("InventoryDocWarehouse")
  inventoryDocsAsSource      InventoryDocument[]     @relation("InventoryDocSourceWarehouse")
  inventoryDocsAsDest        InventoryDocument[]     @relation("InventoryDocDestWarehouse")
  inventoryClosings          InventoryClosing[]
  inventoryClosingAudits     InventoryClosingAudit[]
}

// درخت محل فیزیکی — طبق stockAnalysis.md بند ۲۱: هر انبار درخت محل فیزیکی مستقل خودش را دارد
// (کد/عنوان فقط در همان انبار یکتاست، نه سراسری) — دقیقاً همان الگوی درخت GoodsGroup، با یک سطح
// اسکوپ اضافه (warehouseId) روی ریشه‌ها.
model PhysicalLocation {
  id              Int                     @id @default(autoincrement())
  warehouseId     Int
  parentId        Int?
  code            String
  title           String
  isActive        Boolean                 @default(true)
  hasTransactions Boolean                 @default(false)
  createdAt       DateTime                @default(now())
  warehouse       Warehouse               @relation(fields: [warehouseId], references: [id])
  parent          PhysicalLocation?       @relation("PhysicalLocationTree", fields: [parentId], references: [id])
  children        PhysicalLocation[]      @relation("PhysicalLocationTree")
  inventoryLines  InventoryDocumentLine[]
  closingLines    InventoryClosingLine[]

  @@unique([warehouseId, parentId, code])
}

model GoodsGroupLevel {
  id               Int          @id @default(autoincrement())
  code             Int          @unique
  title            String       @unique
  order            Int          @unique
  codeLength       Int
  affectsGoodsCode Boolean      @default(true)
  createdAt        DateTime     @default(now())
  groups           GoodsGroup[]
}

model GoodsGroup {
  id                Int                   @id @default(autoincrement())
  parentId          Int?
  levelId           Int
  code              String
  title             String
  isLastBranch      Boolean               @default(false)
  affectsGoodsTitle Boolean               @default(false)
  childCodeLength   Int?
  isActive          Boolean               @default(true)
  hasTransactions   Boolean               @default(false)
  createdAt         DateTime              @default(now())
  level             GoodsGroupLevel       @relation(fields: [levelId], references: [id])
  parent            GoodsGroup?           @relation("GoodsGroupTree", fields: [parentId], references: [id])
  children          GoodsGroup[]          @relation("GoodsGroupTree")
  attributes        GoodsGroupAttribute[]
  items             GoodsItem[]

  @@unique([parentId, code])
}

model GoodsGroupAttribute {
  id           Int                       @id @default(autoincrement())
  goodsGroupId Int
  attributeId  Int
  order        Int                       @default(0)
  affectsCode  Boolean                   @default(true)
  titleEffect  GoodsAttributeTitleEffect @default(NONE)
  attribute    GoodsAttribute            @relation(fields: [attributeId], references: [id])
  goodsGroup   GoodsGroup                @relation(fields: [goodsGroupId], references: [id], onDelete: Cascade)

  @@unique([goodsGroupId, attributeId])
}

model GoodsAttribute {
  id              Int                       @id @default(autoincrement())
  code            Int                       @unique
  title           String                    @unique
  itemCodeLength  Int
  hasTransactions Boolean                   @default(false)
  createdAt       DateTime                  @default(now())
  items           GoodsAttributeItem[]
  groupLinks      GoodsGroupAttribute[]
  itemValues      GoodsItemAttributeValue[]
}

model GoodsAttributeItem {
  id          Int                       @id @default(autoincrement())
  attributeId Int
  code        String
  title       String
  attribute   GoodsAttribute            @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  itemValues  GoodsItemAttributeValue[]

  @@unique([attributeId, code])
}

model GoodsItem {
  id                            Int                            @id @default(autoincrement())
  kind                          GoodsItemKind
  goodsGroupId                  Int
  code                          String
  fullCode                      String                         @unique
  rawTitle                      String
  title                         String
  mainUnitId                    Int
  weightUnitId                  Int?
  weightRatio                   Decimal?                       @db.Decimal(18, 6)
  technicalSpec                 String?
  barcode                       String?
  reorderControl                Boolean                        @default(false)
  reorderPoint                  Decimal?                       @db.Decimal(18, 6)
  hasSerialNumber               Boolean                        @default(false)
  hasExpiryDate                 Boolean                        @default(false)
  isSerialTracked               Boolean                        @default(false)
  isExpiryTracked               Boolean                        @default(false)
  isBatchTracked                Boolean                        @default(false)
  isLocationTracked             Boolean                        @default(false)
  accountingGroupId             Int
  isSpecial                     Boolean                        @default(false)
  taxRate                       Decimal?                       @db.Decimal(9, 4)
  isActive                      Boolean                        @default(true)
  hasTransactions               Boolean                        @default(false)
  createdAt                     DateTime                       @default(now())
