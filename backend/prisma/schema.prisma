  description    String?
  status         TreasuryDocStatus              @default(DRAFT)
  // سند حسابداری صادرشده (اکشن دستی «صدور سند حسابداری» روی سند تاییدشده) — هم‌الگوی ChequeDeposit
  journalEntryId Int?                           @unique
  journalEntry   JournalEntry?                  @relation(fields: [journalEntryId], references: [id])
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @default(now()) @updatedAt
  fiscalPeriod   FiscalPeriod                   @relation(fields: [fiscalPeriodId], references: [id])
  lines          ChequeClearingReceivableLine[]

  @@unique([fiscalPeriodId, number])
}

model ChequeClearingReceivableLine {
  id                         Int                      @id @default(autoincrement())
  chequeClearingReceivableId Int
  rowOrder                   Int                      @default(0)
  chequeItemId               Int
  outcome                    ChequeClearingOutcome
  chequeStep                 Int?
  chequeClearingReceivable   ChequeClearingReceivable @relation(fields: [chequeClearingReceivableId], references: [id], onDelete: Cascade)
  chequeItem                 ChequeItem               @relation(fields: [chequeItemId], references: [id])
}

model ChequeClearingPayable {
  id             Int                         @id @default(autoincrement())
  fiscalPeriodId Int
  number         Int
  date           DateTime                    @db.Date
  description    String?
  status         TreasuryDocStatus           @default(DRAFT)
  // سند حسابداری صادرشده (اکشن دستی «صدور سند حسابداری» روی سند تاییدشده) — هم‌الگوی ChequeDeposit
  journalEntryId Int?                        @unique
  journalEntry   JournalEntry?               @relation(fields: [journalEntryId], references: [id])
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @default(now()) @updatedAt
  fiscalPeriod   FiscalPeriod                @relation(fields: [fiscalPeriodId], references: [id])
  lines          ChequeClearingPayableLine[]

  @@unique([fiscalPeriodId, number])
}

model ChequeClearingPayableLine {
  id                      Int                   @id @default(autoincrement())
  chequeClearingPayableId Int
  rowOrder                Int                   @default(0)
  chequeItemId            Int
  outcome                 ChequeClearingOutcome
  chequeStep              Int?
  chequeClearingPayable   ChequeClearingPayable @relation(fields: [chequeClearingPayableId], references: [id], onDelete: Cascade)
  chequeItem              ChequeItem            @relation(fields: [chequeItemId], references: [id])
}

// ==================== خزانه‌داری > افتتاحیه دریافت و پرداخت / بستن سال ====================
// طبق Documents/افتتاحیه دریافت و پرداخت و بستن سال.md: به‌ازای هر دوره مالی یک فرم افتتاحیه با چهار تب: چک‌های دریافتی و
// پرداختی (خودِ ChequeItemهایی با isOpening=true در همان دوره — نگاه کنید به ChequeItem)، حساب‌های بانکی و صندوق‌ها (مانده‌ی
// اول دوره، هم به ارز حساب/صندوق و هم به ارز پایه). هم برای استقرار اولیه (ورود دستی) و هم برای انتقال پایان سال (ایجاد
// خودکار توسط «بستن سال دریافت و پرداخت») استفاده می‌شود.
model TreasuryOpening {
  id              Int                          @id @default(autoincrement())
  fiscalPeriodId  Int                          @unique
  date            DateTime                     @db.Date
  /// true = افتتاحیه را «عملیات پایان دوره»ی دوره‌ی قبل ساخته؛ کاملاً فقط‌خواندنی است (ایجاد/ویرایش/حذف فقط با بستن/بازگشایی در دوره‌ی قبل).
  /// false = افتتاحیه‌ی دستی (استقرار اولیه): در کل سیستم فقط یکی، و فقط وقتی هیچ افتتاحیه‌ی سیستمی وجود ندارد قابل ایجاد است.
  isSystemGenerated Boolean                   @default(false)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @default(now()) @updatedAt
  fiscalPeriod    FiscalPeriod                 @relation(fields: [fiscalPeriodId], references: [id])
  bankAccountLines TreasuryOpeningBankAccount[]
  cashBoxLines    TreasuryOpeningCashBox[]
  pettyCashLines  TreasuryOpeningPettyCash[]
}

model TreasuryOpeningBankAccount {
  id            Int             @id @default(autoincrement())
  openingId     Int
  rowOrder      Int             @default(0)
  bankAccountId Int
  currencyId    Int
  balance       Decimal         @db.Decimal(18, 2)
  baseBalance   Decimal         @db.Decimal(18, 2)
  // true = ردیف را «بستن سال دریافت و پرداخت» خودکار ساخته است؛ کاربر نمی‌تواند آن را ویرایش/حذف کند (routes/treasuryOpenings.ts)
  isSystemGenerated Boolean     @default(false)
  opening       TreasuryOpening @relation(fields: [openingId], references: [id], onDelete: Cascade)
  bankAccount   BankAccount     @relation(fields: [bankAccountId], references: [id])
  currency      Currency        @relation(fields: [currencyId], references: [id])

  @@unique([openingId, bankAccountId])
}

model TreasuryOpeningCashBox {
  id          Int             @id @default(autoincrement())
  openingId   Int
  rowOrder    Int             @default(0)
  cashBoxId   Int
  currencyId  Int
  balance     Decimal         @db.Decimal(18, 2)
  baseBalance Decimal         @db.Decimal(18, 2)
  // همان معنای TreasuryOpeningBankAccount.isSystemGenerated
  isSystemGenerated Boolean   @default(false)
  opening     TreasuryOpening @relation(fields: [openingId], references: [id], onDelete: Cascade)
  cashBox     CashBox         @relation(fields: [cashBoxId], references: [id])
  currency    Currency        @relation(fields: [currencyId], references: [id])

  @@unique([openingId, cashBoxId, currencyId])
}

/// مانده‌ی اول دوره‌ی یک «تنخواه‌دار» (هم‌الگوی TreasuryOpeningBankAccount): به‌ازای هر تنخواه‌دار یک ردیف (تنخواهِ او از رابطه‌ی تنخواه‌دار معلوم است و
/// pettyCashId فقط برای سادگی کوئری نگه داشته می‌شود)، به ارز خودِ تنخواه (و ارز پایه). اگر برای دوره ردیفی
/// باشد، «مانده‌ی جاری» آن تنخواه‌دار (و در مجموع تنخواه) در آن دوره از همین مقدار شروع می‌شود (services/pettyCashBalanceService.ts، services/pettyCashReviewService.ts).
model TreasuryOpeningPettyCash {
  id                Int             @id @default(autoincrement())
  openingId         Int
  rowOrder          Int             @default(0)
  pettyCashId       Int
  custodianId       Int
  currencyId        Int
  balance           Decimal         @db.Decimal(18, 2)
  baseBalance       Decimal         @db.Decimal(18, 2)
  /// true = ردیف را «عملیات پایان دوره»ی سال قبل (بستن تنخواه‌ها) خودکار ساخته است
  isSystemGenerated Boolean         @default(false)
  opening           TreasuryOpening @relation(fields: [openingId], references: [id], onDelete: Cascade)
  pettyCash         PettyCash       @relation(fields: [pettyCashId], references: [id])
  custodian         PettyCashCustodian @relation(fields: [custodianId], references: [id])
  currency          Currency        @relation(fields: [currencyId], references: [id])

  @@unique([openingId, custodianId])
}

// «بستن سال دریافت و پرداخت» — هر بخش به‌صورت مستقل بسته می‌شود؛ ردیف این جدول یعنی آن بخش از دوره‌ی مالیِ fiscalPeriodId
// بسته و به افتتاحیه‌ی دوره‌ی بعد منتقل شده است.
enum TreasuryCloseSection {
  BANK_ACCOUNTS
  CASH_BOXES
  /// مانده‌ی پایان سال هر تنخواه (به ارز خودِ تنخواه) که به افتتاحیه‌ی سال بعد منتقل می‌شود (TreasuryOpeningPettyCash)
  PETTY_CASHES
  RECEIVABLE_CHEQUES
  PAYABLE_CHEQUES
}

model TreasuryYearClose {
  id             Int                  @id @default(autoincrement())
  fiscalPeriodId Int
  section        TreasuryCloseSection
  closedAt       DateTime             @default(now())
  fiscalPeriod   FiscalPeriod         @relation(fields: [fiscalPeriodId], references: [id])

  @@unique([fiscalPeriodId, section])
}

// =========================================================================
// «رویه‌ها و تنظیمات حسابداری» (Documents/رویه ها و تنظیمات حسابداری.md) — تنظیمات تاریخ‌محور سطح حسابداری.
// هر رکورد «تاریخ شروع اعتبار» (یکتا) دارد؛ مقدار معتبر برای یک تاریخ = آخرین رکوردِ با تاریخ شروع ≤ آن تاریخ.
// =========================================================================

enum AdvanceReceiptFxMethod {
  HISTORICAL_RATE          // نرخ تاریخی پیش‌دریافت
  TRANSACTION_DATE_RATE    // نرخ تاریخ معامله/فاکتور (اختلاف نرخ = تفاوت تسعیر ارز)
}

model AccountingVatRate {
  id          Int      @id @default(autoincrement())
  startDate   DateTime @unique @db.Date
  /// درصد (مثلاً ۱۰ یعنی ۱۰٪)
  ratePercent Decimal  @db.Decimal(5, 2)
  createdAt   DateTime @default(now())
}

model AccountingAdvanceReceiptSetting {
  id        Int                    @id @default(autoincrement())
  startDate DateTime               @unique @db.Date
  method    AdvanceReceiptFxMethod
  createdAt DateTime               @default(now())
}

// رویه‌ی مستقل تسعیر پیش‌پرداخت خرید (Documents/تخصیص پیش‌پرداخت در فاکتور خرید.md) — همان مدل تاریخ‌محور و همان دو مقدار
// AdvanceReceiptFxMethod (تاریخی/تاریخ معامله)، ولی رویه‌ای کاملاً جدا از رویه‌ی تسعیر پیش‌دریافت فروش، هرگز با هم ترکیب نمی‌شوند.
enum AdvancePaymentFxMethod {
  HISTORICAL_RATE       // نرخ تاریخی پیش‌پرداخت — اختلاف نرخ روی مبلغ خرید (قیمت تمام‌شده‌ی موجودی) اثر می‌گذارد
  TRANSACTION_DATE_RATE // نرخ تاریخ معامله/فاکتور — اختلاف نرخ به‌عنوان سود و زیان تسعیر ارز شناسایی می‌شود
}

model AccountingAdvancePaymentSetting {
  id        Int                    @id @default(autoincrement())
  startDate DateTime               @unique @db.Date
  method    AdvancePaymentFxMethod
  createdAt DateTime               @default(now())
}

// تخصیص پیش‌پرداخت به فاکتور خرید (Documents/تخصیص پیش‌پرداخت در فاکتور خرید.md): مبلغ (به ارز فاکتور) از یک ردیف موضوع پرداختِ
// «پیش‌پرداخت» (PaymentSettlementLine با ماهیت نوع پرداخت ADVANCE_PAYMENT روی پرداخت تاییدشده) به یک فاکتور خرید. یک پیش‌پرداخت
// می‌تواند به چند فاکتور و یک فاکتور از چند پیش‌پرداخت استفاده کند؛ مجموع تخصیص‌های یک پیش‌پرداخت از مبلغ آن و مجموع تخصیص‌های
// یک فاکتور از مبلغ قابل تخصیص فاکتور بیشتر نمی‌شود (کنترل در services/purchaseInvoiceAdvanceService.ts). برخلاف پیش‌دریافت فروش
// فقط یک ماهیت دارد (بدون معادل ارزش‌افزوده)، پس فیلد nature ندارد.
model PurchaseInvoiceAdvanceAllocation {
  id                      Int                   @id @default(autoincrement())
  purchaseInvoiceId       Int
  paymentSettlementLineId Int
  /// به ارز فاکتور (= ارز پیش‌پرداخت)؛ تفاوت نرخ ارز هرگز روی آن اثر نمی‌گذارد
  amount                  Decimal               @db.Decimal(18, 2)
  /// ماهیت پیش‌پرداختِ تخصیص‌یافته (از نوع پرداخت): مبلغ پیش‌پرداخت عادی و پیش‌پرداخت ارزش افزوده جدا از هم کنترل می‌شوند
  nature                  PurchaseAdvanceAllocationNature @default(ADVANCE_PAYMENT)
  createdAt               DateTime              @default(now())
  purchaseInvoice         PurchaseInvoice       @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  paymentSettlementLine   PaymentSettlementLine @relation(fields: [paymentSettlementLineId], references: [id], onDelete: Restrict)

  @@unique([purchaseInvoiceId, paymentSettlementLineId])
}

enum PurchaseAdvanceAllocationNature {
  ADVANCE_PAYMENT
  ADVANCE_VAT_PAYMENT
}

/// تخصیص پیش‌پرداخت به فاکتور خرید خدمات — هم‌الگوی PurchaseInvoiceAdvanceAllocation (services/purchaseInvoiceAdvanceService.ts، نوع SERVICE)
model ServicePurchaseInvoiceAdvanceAllocation {
  id                       Int                     @id @default(autoincrement())
  servicePurchaseInvoiceId Int
  paymentSettlementLineId  Int
  /// به ارز فاکتور (= ارز پیش‌پرداخت)؛ تفاوت نرخ ارز هرگز روی آن اثر نمی‌گذارد
  amount                   Decimal                 @db.Decimal(18, 2)
  nature                   PurchaseAdvanceAllocationNature @default(ADVANCE_PAYMENT)
  createdAt                DateTime                @default(now())
  servicePurchaseInvoice   ServicePurchaseInvoice  @relation(fields: [servicePurchaseInvoiceId], references: [id], onDelete: Cascade, map: "SPIAdvanceAlloc_invoiceId_fkey")
  paymentSettlementLine    PaymentSettlementLine   @relation(fields: [paymentSettlementLineId], references: [id], onDelete: Restrict, map: "SPIAdvanceAlloc_lineId_fkey")

  @@unique([servicePurchaseInvoiceId, paymentSettlementLineId], map: "SPIAdvanceAlloc_invoice_line_key")
}

// تخصیص پیش‌دریافت به فاکتور فروش (Documents/تخصیص پیش دریافت.md): مبلغ (به ارز فاکتور) از یک ردیف موضوع دریافتِ «پیش‌دریافت» به یک فاکتور.
// یک پیش‌دریافت می‌تواند به چند فاکتور و یک فاکتور از چند پیش‌دریافت استفاده کند؛ مجموع تخصیص‌های یک پیش‌دریافت از مبلغ آن و مجموع تخصیص‌های
// یک فاکتور از مبلغ فاکتور بیشتر نمی‌شود (کنترل در services/salesInvoiceAdvanceService.ts).
model SalesInvoiceAdvanceAllocation {
  id                      Int                   @id @default(autoincrement())
  salesInvoiceId          Int
  receiptSettlementLineId Int
  /// به ارز فاکتور (= ارز پیش‌دریافت)؛ تفاوت نرخ ارز هرگز روی آن اثر نمی‌گذارد
  amount                  Decimal               @db.Decimal(18, 2)
  /// ماهیت پیش‌دریافتِ تخصیص‌یافته (هنگام ثبت از نوع دریافت رسید): مبلغ پیش‌دریافت عادی و پیش‌دریافت ارزش افزوده جدا از هم نگهداری و کنترل می‌شوند
  nature                  AdvanceAllocationNature @default(ADVANCE_RECEIPT)
  createdAt               DateTime              @default(now())
  salesInvoice            SalesInvoice          @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  receiptSettlementLine   ReceiptSettlementLine @relation(fields: [receiptSettlementLineId], references: [id], onDelete: Restrict)

  @@unique([salesInvoiceId, receiptSettlementLineId])
}

enum AdvanceAllocationNature {
  ADVANCE_RECEIPT
  ADVANCE_VAT_RECEIPT
}

// «شرح‌های پرکاربرد»: متن‌هایی که کاربر با آیکن «ذخیره» کنار فیلد شرح یک فرم ذخیره می‌کند تا هنگام تایپ در همان
// فیلد همان فرم پیشنهاد شوند. برای همه‌ی کاربران مشترک است. هر رکورد به «فرم + فیلد + متن» وابسته است:
// formKey = کلید فرم در navConfig/registry (مثلاً payments)، fieldKey = نام فیلد (فعلاً همیشه description).
// یکتایی (فرم، فیلد، متن) در سطح دیتابیس تضمین می‌شود تا ذخیره‌ی تکراری (حتی هم‌زمان) رکورد دوم نسازد.
model FrequentDescription {
  id          Int      @id @default(autoincrement())
  formKey     String
  fieldKey    String   @default("description")
  text        String
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([formKey, fieldKey, text])
  @@index([formKey, fieldKey])
}

/// «حافظه مالیاتی» (امور مالیاتی › تنظیمات). جفت‌کلید RSA 2048 هنگام اولین ذخیره ساخته می‌شود؛ کلید خصوصی فقط به‌صورت رمزشده (AES-256-GCM،
/// services/taxMemoryService.ts) ذخیره و هرگز از طریق API/لاگ/UI بیرون نمی‌آید. publicKeyPem/csrPem از روی همان جفت‌کلید تولید می‌شوند و کاربر نمی‌تواند آن‌ها را جایگزین کند.
model TaxMemory {
  numberingPatterns   NumberingPattern[]
  id                  Int      @id @default(autoincrement())
  persianCompanyName  String
  englishCompanyName  String
  nationalId          String
  /// همیشه IR (سرور هر مقدار دیگری را رد می‌کند)
  countryId           String   @default("IR")
  email               String
  /// شناسه یکتای حافظه مالیاتی — بعد از دریافت از سامانه مودیان دستی وارد می‌شود
  taxMemoryUniqueId   String?
  publicKeyPem        String
  csrPem              String
  /// کلید خصوصی PKCS#8 PEM رمزشده با AES-256-GCM. قالب v1: iv:tag:data. قالب v2: v2:<سریال لایسنس>:iv:tag:data با سریال به‌عنوان داده‌ی احرازشده (AAD)
  privateKeyEncrypted String
  /// سریال لایسنسی که این حافظه با آن ساخته/علامت‌گذاری شده؛ ارسال فقط وقتی مجاز است که با سریال لایسنس جاری یکی باشد (null = قدیمی، هنگام اولین لایسنسِ دارای سریال علامت می‌خورد)
  licenseSerial       String?
  /// آخرین سریال صورتحساب این حافظه (جزء ۱۰ رقمی شماره مالیاتی)؛ صعودی و غیرتکراری — هنگام ارسال اتمی افزایش می‌یابد
  lastSerial          BigInt   @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  taxInvoices         TaxInvoice[]
}

enum TaxInvoiceStatus {
  IN_PROGRESS
  SUCCESS
  FAILED
  TIMEOUT
}

/// صورتحساب الکترونیکی ارسال‌شده به سامانه مودیان: عکس ثابتِ JSON ارسالی + نتیجه‌ی استعلام (services/taxInvoiceBuilder.ts می‌سازد)
/// حالت یک «کار زمان‌بندی‌شده»: خاموش، آزمایشی (فقط گزارش؛ هیچ نوشتنی ندارد) یا واقعی
enum ScheduledJobMode {
  OFF
  DRY_RUN
  LIVE
}

enum ScheduledJobScheduleType {
  /// هر N دقیقه
  INTERVAL
  /// هر روز در ساعت مشخص
  DAILY
  /// روزهای مشخصِ هفته در ساعت مشخص
  WEEKLY
}

enum ScheduledJobRunStatus {
  RUNNING
  SUCCESS
  /// بعضی موارد شکست خورده‌اند
  PARTIAL
  /// کل اجرا با خطا متوقف شد
  FAILED
}

enum ScheduledJobTrigger {
  SCHEDULE
  MANUAL
}

/// تنظیمات یک کار زمان‌بندی‌شده. خودِ کار در کد تعریف می‌شود (backend/src/jobs، با کلید یکتای key)؛ این رکورد فقط
/// حالت، زمان‌بندی (به وقت تهران) و مقدار پارامترهای قابل‌تنظیم آن را نگه می‌دارد. نگاه کنید به jobs/runner.ts.
model ScheduledJob {
  id              Int                       @id @default(autoincrement())
  key             String                    @unique
  mode            ScheduledJobMode          @default(OFF)
  scheduleType    ScheduledJobScheduleType  @default(WEEKLY)
  intervalMinutes Int?
  /// "HH:mm" به وقت تهران (DAILY/WEEKLY)
  timeOfDay       String?
  /// روزهای هفته برای WEEKLY: ۰=شنبه … ۶=جمعه
  weekdays        Int[]
  /// مقدار پارامترهای کار به‌همان شکلی که کاربر وارد کرده (مثلاً بازه‌ی نسبیِ «از N روز قبل تا M روز قبل»)
  params          Json                      @default("{}")
  /// کاربری که اجرای زمان‌بندی‌شده با نام او ثبت می‌شود
  runAsUserId     Int?
  nextRunAt       DateTime?
  lastRunAt       DateTime?
  lastRunStatus   ScheduledJobRunStatus?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  runAsUser       User?                     @relation(fields: [runAsUserId], references: [id], onDelete: SetNull)
  runs            ScheduledJobRun[]
}

/// یک بار اجرای یک کار. از هر کار حداکثر یک اجرای RUNNING وجود دارد (ایندکس یکتای جزئی در migration — Prisma آن را مدل نمی‌کند).
model ScheduledJobRun {
  id          Int                     @id @default(autoincrement())
  jobId       Int
  trigger     ScheduledJobTrigger
  /// آزمایشی بودن همین اجرا (هیچ تغییری روی داده‌ها نمی‌دهد)
  dryRun      Boolean
  status      ScheduledJobRunStatus   @default(RUNNING)
  startedAt   DateTime                @default(now())
  finishedAt  DateTime?
  startedById Int?
  runAsUserId Int?
  /// مقدار واقعی پارامترها در این اجرا (بازه‌های نسبی به تاریخ مشخص تبدیل شده‌اند)
  params      Json                    @default("{}")
  summary     String?
  /// {done, wouldDo, skipped, failed}
  counts      Json?
  /// ریز موارد پردازش‌شده: [{ref, label, result, message}] (با سقف تعداد)
  items       Json?
  error       String?
  job         ScheduledJob            @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, startedAt])
}

model TaxInvoice {
  id               Int              @id @default(autoincrement())
  taxMemoryId      Int
  salesInvoiceId   Int
  /// موضوع صورتحساب (ins): ۱ اصلی، ۲ اصلاحی، ۳ ابطالی، ۴ برگشت از فروش — فعلاً فقط ۱
  subject          Int              @default(1)
  /// نوع صورتحساب (inty): ۱ یا ۲
  invoiceType      Int
  /// روش تسویه (setm): ۱ نقدی، ۲ نسیه
  settlementMethod Int
  isArticle9       Boolean          @default(false)
  taxId            String           @unique
  serial           BigInt
  /// تاریخ و زمان صدور (indatim) به میلی‌ثانیه‌ی یونیکس
  issuedAt         BigInt
  referenceTaxId   String?
  payload          Json
  requestTraceId   String           @unique
  status           TaxInvoiceStatus @default(IN_PROGRESS)
  referenceNumber  String?
  errors           Json?
  warnings         Json?
  sentAt           DateTime         @default(now())
  checkedAt        DateTime?
  /// ممیزی: سریال لایسنس و هش هویت سرور هنگام ارسال
  licenseSerial    String?
  serverBindingHash String?
  taxMemory        TaxMemory        @relation(fields: [taxMemoryId], references: [id])
  salesInvoice     SalesInvoice     @relation(fields: [salesInvoiceId], references: [id])

  @@unique([taxMemoryId, serial])
  @@index([salesInvoiceId])
}

enum NumberingForm {
  SALES_INVOICE
  SALES_RETURN
}

/// «الگوی شماره‌گذاری» (تنظیمات): مالکِ دنباله‌ی شماره‌ی مشترک بین همه‌ی اقلام (فرم + نوع فروش + مرکز فروش) خودش است — نه حافظه مالیاتی.
/// تخصیص شماره‌ی اتمی/امن در برابر هم‌زمانی: services/numberingPatternService.ts (شمارنده‌ی NumberingPatternCounter).
model NumberingPattern {
  id                     Int                     @id @default(autoincrement())
  title                  String                  @unique
  hasTaxMemory           Boolean                 @default(false)
  taxMemoryId            Int?
  /// true = شماره‌گذاری برای هر سال مالی مستقل است و اول هر سال از نو شروع می‌شود
  resetPerFiscalYear     Boolean                 @default(false)
  /// true = تاریخ سند جدید نباید از آخرین تاریخ اسناد ثبت‌شده با همین الگو کوچک‌تر باشد
  restrictEarlierDates   Boolean                 @default(false)
  /// «آخرین شماره» برای مهاجرت از سیستم قبلی: شماره‌ی بعدی = این مقدار + ۱ (در حالت ریست سالانه فقط برای سال مالیِ seedFiscalPeriodId؛ سال‌های دیگر از صفر)
  lastNumber             Int                     @default(0)
  seedFiscalPeriodId     Int?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  taxMemory              TaxMemory?              @relation(fields: [taxMemoryId], references: [id])
  items                  NumberingPatternItem[]
  counters               NumberingPatternCounter[]
  salesInvoices          SalesInvoice[]
  salesReturnInvoices    SalesReturnInvoice[]
}

model NumberingPatternItem {
  id            Int              @id @default(autoincrement())
  patternId     Int
  form          NumberingForm
  salesTypeId   Int
  salesCenterId Int
  pattern       NumberingPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)
  salesType     SalesType        @relation(fields: [salesTypeId], references: [id])
  salesCenter   SalesCenter      @relation(fields: [salesCenterId], references: [id])

  /// یک ترکیب «فرم + پارامترها» فقط در یک الگو (و فقط یک‌بار) مجاز است — در سطح دیتابیس هم تضمین می‌شود
  @@unique([form, salesTypeId, salesCenterId])
}

/// شمارنده‌ی هر الگو (scopeKey = شناسه‌ی دوره مالی در حالت ریست سالانه، وگرنه ۰). افزایش فقط با یک دستور اتمی INSERT … ON CONFLICT DO UPDATE … RETURNING
/// داخل تراکنشِ ثبت سند انجام می‌شود؛ قفل ردیف تا پایان تراکنش، تخصیص‌های هم‌زمان را پشت سر هم می‌چیند (بدون شماره‌ی تکراری و بدون حفره در صورت rollback).
model NumberingPatternCounter {
  id         Int              @id @default(autoincrement())
  patternId  Int
  scopeKey   Int
  lastNumber Int
  pattern    NumberingPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@unique([patternId, scopeKey])
}

/// «تجمیع اسناد» (حسابداری › عملیات): روش انتخاب محدوده‌ی تجمیع — «از تاریخ تا تاریخ» یا «از سند تا سند» (هم‌زمان قابل استفاده نیستند)
enum ConsolidationRangeMode {
  BY_DATE
  BY_DOCUMENT
}

/// نوع تجمیع: روزانه یا ماهانه (ماه شمسی)
enum ConsolidationType {
  DAILY
  MONTHLY
}

/// یک بار «صدور اسناد تجمیعی» (کل عملیات در یک تراکنش انجام می‌شود؛ یا همه‌ی اسناد این اجرا ثبت می‌شوند یا هیچ‌کدام)
model JournalConsolidationRun {
  id             Int                    @id @default(autoincrement())
  fiscalPeriodId Int
  rangeMode      ConsolidationRangeMode
  type           ConsolidationType
  fromDate       DateTime?              @db.Date
  toDate         DateTime?              @db.Date
  fromNumber     Int?
  toNumber       Int?
  createdById    Int?
  createdAt      DateTime               @default(now())
  fiscalPeriod   FiscalPeriod           @relation(fields: [fiscalPeriodId], references: [id])
  documents      ConsolidatedDocument[]
}

/// سند تجمیعی: فقط «هدر» (بدون آیتم)، جدا از جدول اسناد حسابداری؛ شماره‌گذاری مستقل در هر دوره مالی.
/// date = تاریخ آخرین سند مبنا؛ fromDate/toDate و fromNumber/toNumber = کمینه/بیشینه‌ی تاریخ و شماره‌ی اسناد مبنا.
/// boundaryKey = systemKey نوع سند مرزی (OPENING / CLOSING_ACCOUNTS / CLOSING) برای سندی که به‌تنهایی تجمیع شده؛ برای تجمیع عادی null.
model ConsolidatedDocument {
  id             Int                          @id @default(autoincrement())
  fiscalPeriodId Int
  runId          Int
  number         Int
  date           DateTime                     @db.Date
  type           ConsolidationType
  boundaryKey    String?
  description    String?
  sourceCount    Int
  fromDate       DateTime                     @db.Date
  toDate         DateTime                     @db.Date
  fromNumber     Int
  toNumber       Int
  /// گردش بدهکار/بستانکار (ارز پایه) = جمع ردیف‌های اسناد مبنا؛ هنگام صدور محاسبه و همین‌جا ذخیره می‌شود تا در فهرست بار محاسباتی نداشته باشد
  totalDebit     Decimal                      @default(0) @db.Decimal(18, 2)
  totalCredit    Decimal                      @default(0) @db.Decimal(18, 2)
  createdAt      DateTime                     @default(now())
  fiscalPeriod   FiscalPeriod                 @relation(fields: [fiscalPeriodId], references: [id])
  run            JournalConsolidationRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  sources        ConsolidatedDocumentSource[]
  tradeLedgerLink TradeLedgerDocument?

  @@unique([fiscalPeriodId, number])
  @@index([runId])
}

/// ارتباط دوطرفه‌ی سند تجمیعی با اسناد مبنا (فقط شناسه). یکتایی journalEntryId = هر سند حسابداری فقط یک‌بار تجمیع می‌شود (قفل نهایی برابر همروندی).
model ConsolidatedDocumentSource {
  id                     Int                  @id @default(autoincrement())
  consolidatedDocumentId Int
  journalEntryId         Int                  @unique
  consolidatedDocument   ConsolidatedDocument @relation(fields: [consolidatedDocumentId], references: [id], onDelete: Cascade)
  journalEntry           JournalEntry         @relation(fields: [journalEntryId], references: [id])

  @@index([consolidatedDocumentId])
}

enum TradeLedgerStatus {
  DRAFT
  APPROVED
}

/// «دفاتر تجاری» (امور مالیاتی › عملیات): گروهی از اسناد تجمیعی یک بازه؛ مبالغ هنگام خروجی CSV از اسناد مبنا به‌ازای حساب کل محاسبه می‌شود
model TradeLedger {
  id             Int                   @id @default(autoincrement())
  fiscalPeriodId Int
  number         Int
  fromDate       DateTime              @db.Date
  toDate         DateTime              @db.Date
  status         TradeLedgerStatus     @default(DRAFT)
  approvedAt     DateTime?
  approvedById   Int?
  createdById    Int?
  createdAt      DateTime              @default(now())
  fiscalPeriod   FiscalPeriod          @relation(fields: [fiscalPeriodId], references: [id])
  documents      TradeLedgerDocument[]

  @@unique([fiscalPeriodId, number])
}

/// یکتایی consolidatedDocumentId = هر سند تجمیعی فقط در یک دفتر؛ onDelete پیش‌فرض (Restrict) = سندِ داخل دفتر در سطح پایگاه داده هم حذف‌شدنی نیست
model TradeLedgerDocument {
  id                     Int                  @id @default(autoincrement())
  tradeLedgerId          Int
  consolidatedDocumentId Int                  @unique
  tradeLedger            TradeLedger          @relation(fields: [tradeLedgerId], references: [id], onDelete: Cascade)
  consolidatedDocument   ConsolidatedDocument @relation(fields: [consolidatedDocumentId], references: [id])

  @@index([tradeLedgerId])
}

/// «تفصیل‌های سند» (هدر): برای هر نوع سند (کلید متنی: انواع InventoryDocumentType و انواع دیگر مثل SERVICE_PURCHASE_INVOICE — services/docDetailService.ts)،
/// تفصیل‌های اضافه‌ی علاوه بر تفصیل پایه‌ی سند. جدول فیزیکی همان WarehouseDocDetailSetting است (نام قدیمی؛ فقط @@map)
model DocDetailSetting {
  id           Int                   @id @default(autoincrement())
  documentType String                @unique
  createdAt    DateTime              @default(now())
  items        DocDetailSettingItem[]

  @@map("WarehouseDocDetailSetting")
}

/// دیتیل: یک نوع تفصیل اضافه. showInItem=false ⇒ فیلد هدر سند؛ showInItem=true ⇒ هدر (مقدار پیش‌فرض) + ستون ردیف
model DocDetailSettingItem {
  id           Int              @id @default(autoincrement())
  settingId    Int
  detailTypeId Int
  showInItem   Boolean          @default(false)
  setting      DocDetailSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)
  detailType   DetailType       @relation(fields: [detailTypeId], references: [id])

  @@unique([settingId, detailTypeId])
  @@map("WarehouseDocDetailSettingItem")
}

/// مقدار تفصیل‌های اضافه‌ی سند انبار: lineId خالی = مقدار هدر، پر = مقدار ردیف. یکتایی (ایندکس جزئی) در مایگریشن است
model InventoryDocumentDetail {
  id           Int                    @id @default(autoincrement())
  documentId   Int
  lineId       Int?
  detailTypeId Int
  detailCode   String
  document     InventoryDocument      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  line         InventoryDocumentLine? @relation(fields: [lineId], references: [id], onDelete: Cascade)
  detailType   DetailType             @relation(fields: [detailTypeId], references: [id])

  @@index([documentId])
  @@index([lineId])
}

enum DetailRuleSource {
  FIXED
  FROM_DOCUMENT
  /// دیگر استفاده نمی‌شود (قاعده‌ی تفصیل خزانه برداشته شد)؛ مقدار enum در پایگاه داده می‌ماند چون PostgreSQL حذف مقدار enum را پشتیبانی نمی‌کند
  FROM_BASE_DOCUMENT
}

/// «قواعد تفصیل» (هدر): برای یک رکورد «حسابداری کالا و خدمت» در یک تاریخ اجرا؛ شرط‌های تفکیک (انبار / گروه کالا / طرف حساب) را هدر مشخص می‌کند
model DetailRuleHeader {
  id            Int             @id @default(autoincrement())
  settingId     Int
  effectiveDate DateTime        @db.Date
  byWarehouse   Boolean         @default(false)
  byGoodsGroup  Boolean         @default(false)
  byParty       Boolean         @default(false)
  createdAt     DateTime        @default(now())
  setting       GoodsServiceAccountingSetting @relation(fields: [settingId], references: [id], onDelete: Restrict)
  rows          DetailRuleRow[]

  @@unique([settingId, effectiveDate])
}

/// دیتیل: مقدار شرط‌ها (همه‌ی شرط‌های انتخاب‌شده‌ی هدر پر، یا همه خالی = ردیف «بقیه») + منبع هر یک از سه سطح تفصیل
/// (ایندکس یکتای ترکیب شرط‌ها با NULLS NOT DISTINCT در مایگریشن است)
model DetailRuleRow {
  id             Int               @id @default(autoincrement())
  headerId       Int
  warehouseId    Int?
  goodsGroupId   Int?
  partyDetailCode String?
  slot1Source    DetailRuleSource?
  slot1Code      String?
  slot2Source    DetailRuleSource?
  slot2Code      String?
  slot3Source    DetailRuleSource?
  slot3Code      String?
  header         DetailRuleHeader  @relation(fields: [headerId], references: [id], onDelete: Cascade)
  warehouse      Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  goodsGroup     GoodsGroup?       @relation(fields: [goodsGroupId], references: [id], onDelete: Restrict)

  @@index([headerId])
}

/// مقدار تفصیل‌های اضافه‌ی فاکتور خرید خدمت (تنظیم «تفصیل‌های سند»، نوع SERVICE_PURCHASE_INVOICE): lineId خالی = هدر، پر = ردیف هزینه.
/// یکتایی (ایندکس جزئی) در مایگریشن است
model ServicePurchaseInvoiceDetail {
  id           Int                    @id @default(autoincrement())
  invoiceId    Int
  lineId       Int?
  detailTypeId Int
  detailCode   String
  invoice      ServicePurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  line         PurchaseCostLine?      @relation(fields: [lineId], references: [id], onDelete: Cascade)
  detailType   DetailType             @relation(fields: [detailTypeId], references: [id])

  @@index([invoiceId])
  @@index([lineId])
}

/// مقدار تفصیل‌های اضافه‌ی فاکتور خرید کالا (تنظیم «تفصیل‌های سند»، نوع PURCHASE_INVOICE): هدر (هر دو lineId/costLineId خالی)، ردیف کالا (lineId) یا
/// ردیف «سایر هزینه‌ها» (costLineId). یکتایی (ایندکس جزئی) در مایگریشن است
model PurchaseInvoiceDetail {
  id           Int                  @id @default(autoincrement())
  invoiceId    Int
  lineId       Int?
  costLineId   Int?
  detailTypeId Int
  detailCode   String
  invoice      PurchaseInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  line         PurchaseInvoiceLine? @relation(fields: [lineId], references: [id], onDelete: Cascade)
  costLine     PurchaseCostLine?    @relation(fields: [costLineId], references: [id], onDelete: Cascade)
  detailType   DetailType           @relation(fields: [detailTypeId], references: [id])

  @@index([invoiceId])
  @@index([lineId])
  @@index([costLineId])
}

enum AccountingApprovalStatus {
  NONE
  APPROVED
}

/// نقش ردیف حسابداریِ یک ردیف فرم: ابزار (INSTRUMENT)، موضوع (SUBJECT)، تسعیر موضوع (FX)، کارمزد بانکی ابزار پرداخت (FEE)
enum AccountingLineRole {
  INSTRUMENT
  SUBJECT
  FX
  FEE
}

/// «ردیف حسابداری» رسید دریافت = پیش‌نویس سند در سطح فرم: فرزند ردیف ابزار یا ردیف موضوع (حذف پدر ⇒ حذف فرزند). فقط معین و تفصیل‌ها نگه داشته می‌شود؛
/// مبلغ همیشه از ردیف پدر محاسبه می‌شود (services/receiptAccountingService.ts). یکتایی (پدر، نقش) با ایندکس جزئی در مایگریشن است
model ReceiptAccountingLine {
  id                Int                    @id @default(autoincrement())
  receiptId         Int
  role              AccountingLineRole
  instrumentLineId  Int?
  settlementLineId  Int?
  accountId         Int
  /// رکورد «تعیین حسابهای معین» / «حسابداری کالا و خدمت» که معین از آن آمده (برای قفل رکورد و کنترل هم‌خوانی هنگام صدور)
  treasurySettingId Int?
  goodsSettingId    Int?
  detail1Code       String?
  detail2Code       String?
  detail3Code       String?
  /// منبع مقدار هر سطح: AUTO = سیستم پر کرده (پایه/قاعده؛ قفل)، MANUAL = حسابدار (یا خالی)
  detail1Source     DetailValueSource      @default(MANUAL)
  detail2Source     DetailValueSource      @default(MANUAL)
  detail3Source     DetailValueSource      @default(MANUAL)
  receipt           Receipt                @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  instrumentLine    ReceiptInstrumentLine? @relation(fields: [instrumentLineId], references: [id], onDelete: Cascade)
  settlementLine    ReceiptSettlementLine? @relation(fields: [settlementLineId], references: [id], onDelete: Cascade)
  account           Account                @relation(fields: [accountId], references: [id])

  @@index([receiptId])
  @@index([treasurySettingId])
}

/// هم‌الگوی ReceiptAccountingLine برای اعلامیه پرداخت
model PaymentAccountingLine {
  id                Int                     @id @default(autoincrement())
  paymentId         Int
  role              AccountingLineRole
  instrumentLineId  Int?
  settlementLineId  Int?
  accountId         Int
  treasurySettingId Int?
  goodsSettingId    Int?
  detail1Code       String?
  detail2Code       String?
  detail3Code       String?
  /// منبع مقدار هر سطح: AUTO = سیستم پر کرده (پایه/قاعده؛ قفل)، MANUAL = حسابدار (یا خالی)
  detail1Source     DetailValueSource      @default(MANUAL)
  detail2Source     DetailValueSource      @default(MANUAL)
  detail3Source     DetailValueSource      @default(MANUAL)
  payment           Payment                 @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  instrumentLine    PaymentInstrumentLine?  @relation(fields: [instrumentLineId], references: [id], onDelete: Cascade)
  settlementLine    PaymentSettlementLine?  @relation(fields: [settlementLineId], references: [id], onDelete: Cascade)
  account           Account                 @relation(fields: [accountId], references: [id])

  @@index([paymentId])
  @@index([treasurySettingId])
}

enum DetailValueSource {
  AUTO
  MANUAL
}

/// قفل زنده‌ی رکوردهای «حسابداری کالا و خدمت» و «تعیین حسابهای معین»: هر ردیف = «این سند حسابداری از این رکورد استفاده کرده».
/// با حذف سند حسابداری ردیف‌ها cascade پاک می‌شوند و قفل خودکار آزاد می‌شود؛ حذف رکورد مورداستفاده با RESTRICT رد می‌شود.
/// دقیقاً یکی از goodsSettingId / treasurySettingId پر است (CHECK در مایگریشن). (services/settingUsageService.ts)
model AccountingSettingUsage {
  id                Int                           @id @default(autoincrement())
  journalEntryId    Int
  goodsSettingId    Int?
  treasurySettingId Int?
  journalEntry      JournalEntry                  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  goodsSetting      GoodsServiceAccountingSetting? @relation(fields: [goodsSettingId], references: [id], onDelete: Restrict)
  treasurySetting   TreasuryAccountSetting?       @relation(fields: [treasurySettingId], references: [id], onDelete: Restrict)

  @@unique([journalEntryId, goodsSettingId])
  @@unique([journalEntryId, treasurySettingId])
  @@index([goodsSettingId])
  @@index([treasurySettingId])
}

// ─────────────────────────────────────────────────────────────────────────────
// قالب‌های چاپ (پیش‌فاکتور و بعداً سایر اسناد) و مشخصات شرکت
// ─────────────────────────────────────────────────────────────────────────────

enum PrintDocumentType {
  SALES_QUOTE
  SALES_INVOICE
  JOURNAL_ENTRY
}

enum PrintPaper {
  A4
  A5
}

enum PrintOrientation {
  PORTRAIT
  LANDSCAPE
}

/// ارقام خروجی چاپ: انگلیسی (0-9) یا فارسی (۰-۹)
enum PrintDigits {
  LATIN
  PERSIAN
}

/// تصویر قابل‌استفاده در قالب‌های چاپ و مشخصات شرکت (لوگو، مهر و امضا …)؛ داده‌ی خام در دیتابیس
model PrintAsset {
  id          Int              @id @default(autoincrement())
  name        String
  mimeType    String
  data        Bytes
  createdAt   DateTime         @default(now())
  logoOf      CompanyProfile[] @relation("CompanyLogo")
  stampOf     CompanyProfile[] @relation("CompanyStamp")
}

/// مشخصات شرکت — فقط یک رکورد (id=1) در هر نصب؛ در قالب‌های چاپ به‌عنوان «فروشنده» (company.*) در دسترس است
model CompanyProfile {
  id                 Int         @id @default(1)
  name               String
  economicCode       String?
  registrationNumber String?
  nationalId         String?
  phone              String?
  address            String?
  postalCode         String?
  website            String?
  logoAssetId        Int?
  stampAssetId       Int?
  /// حساب‌های بانکی قابل چاپ: [{ bankName, branch, accountNumber, iban }]
  bankAccounts       Json        @default("[]")
  updatedAt          DateTime    @updatedAt
  logoAsset          PrintAsset? @relation("CompanyLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)
  stampAsset         PrintAsset? @relation("CompanyStamp", fields: [stampAssetId], references: [id], onDelete: SetNull)
}

/// قالب چاپ یک نوع سند: HTML/CSS با متغیرهای Handlebars ({{doc.number}}، {{#each lines}} …). برای هر نوع سند حداکثر یک قالب پیش‌فرض
/// (ایندکس یکتای جزئی در مایگریشن، Prisma نمی‌تواند مدلش کند)
model PrintTemplate {
  id           Int               @id @default(autoincrement())
  documentType PrintDocumentType
  title        String
  paper        PrintPaper        @default(A4)
  orientation  PrintOrientation  @default(PORTRAIT)
  /// حاشیه‌ی صفحه (میلی‌متر)
  marginMm     Int               @default(10)
  /// ارقام پیش‌فرضِ این قالب؛ کاربر هنگام چاپ می‌تواند عوض کند
  digits       PrintDigits       @default(PERSIAN)
  html         String
  /// متن‌های ثابت قابل‌ویرایش قالب (کلید → متن)، در قالب به‌صورت {{t.کلید}}؛ مثل شرایط فروش، محل تحویل، متن watermark
  texts        Json              @default("{}")
  /// تنظیمات «طراح ساده» (ستون‌ها/بخش‌ها/رنگ/فونت؛ services/printDesign.ts)؛ null = پیش‌فرض نوع سند. فقط قالب‌هایی که در HTML از design.* استفاده می‌کنند اثر می‌گیرند
  design       Json?
  /// چیدمان «طراحی بصری» (services/printLayout.ts)؛ null = قالب HTML دستی. اگر مقدار دارد، html از همین چیدمان تولید و ذخیره می‌شود
  layout       Json?
  isDefault    Boolean           @default(false)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt

  @@unique([documentType, title])
}

/// لینک اشتراک‌گذاریِ یک سند چاپی با مشتری: توکن تصادفی (فقط هش SHA-256 ذخیره می‌شود)، عکس‌فوریِ gzip‌شده‌ی HTML (بدون فونت و لوگو/مهر؛
/// هنگام نمایش از نسخه‌ی مشترک پر می‌شوند)، تاریخ انقضا و آمار بازدید. محتوا بعد از انقضا/لغو پاک می‌شود (contentGz = null) و ردیف برای آمار می‌ماند
model PrintShareLink {
  id            Int               @id @default(autoincrement())
  tokenHash     String            @unique
  documentType  PrintDocumentType
  sourceId      Int
  title         String
  fileName      String
  contentGz     Bytes?
  expiresAt     DateTime
  revokedAt     DateTime?
  createdById   Int?
  createdAt     DateTime          @default(now())
  firstViewedAt DateTime?
  lastViewedAt  DateTime?
  viewCount     Int               @default(0)

  @@index([documentType, sourceId])
  @@index([expiresAt])
}

/// لایسنس این نصب (یک ردیف، id=1): شناسه‌ی نصب برنامه (اولین بالا آمدن ساخته می‌شود) و متن فایل لایسنس امضاشده‌ی ثبت‌شده
model AppLicense {
  id          Int       @id @default(1)
  installId   String    @unique
  licenseText String?
  activatedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

/// سیاست پشتیبان‌گیری خودکار (یک ردیف، id=1). فقط از صفحه‌ی «مدیریت» (/management) تنظیم می‌شود، نه از منوی ERP.
/// frequency: INTERVAL = هر intervalHours ساعت، DAILY = هر روز در timeOfDay، WEEKLY = روزهای weekdays (۰=شنبه) در timeOfDay؛ همه به وقت تهران.
model BackupPolicy {
  id                  Int             @id @default(1)
  enabled             Boolean         @default(false)
  frequency           BackupFrequency @default(DAILY)
  intervalHours       Int             @default(24)
  timeOfDay           String          @default("02:00")
  weekdays            Int[]
  /// تعداد نسخه‌ی موفقِ اخیر که همیشه نگه داشته می‌شود (حداقل ۲)
  keepRecent          Int             @default(7)
  /// علاوه بر آن، جدیدترین نسخه‌ی هر یک از این تعداد ماه اخیر (۰ = غیرفعال)
  keepMonthly         Int             @default(0)
  nextRunAt           DateTime?
  /// جای مقصد بیرون از سرور (مثلاً SFTP)؛ فعلاً استفاده نمی‌شود (null)
  externalDestination Json?
  updatedAt           DateTime        @updatedAt
}

enum BackupFrequency {
  INTERVAL
  DAILY
  WEEKLY
}

/// تاریخچه‌ی اجرای پشتیبان‌ها؛ فایل پشتیبان با fileName داخل پوشه‌ی BACKUP_DIR است (fileDeleted = توسط سیاست نگه‌داری حذف شده)
model BackupRun {
  id           Int             @id @default(autoincrement())
  trigger      BackupTrigger
  status       BackupRunStatus @default(RUNNING)
  startedAt    DateTime        @default(now())
  finishedAt   DateTime?
  fileName     String?
  sizeBytes    BigInt?
  appVersion   String?
  errorMessage String?
  fileDeleted  Boolean         @default(false)
  /// نتیجه‌ی آخرین «تست بازگردانی» روی همین فایل
  testedAt     DateTime?
  testOk       Boolean?
  testMessage  String?

  @@index([startedAt])
}

enum BackupTrigger {
  SCHEDULED
  MANUAL
}

enum BackupRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

/// ثبت رویدادهای مدیریتیِ پشتیبان‌گیری: تغییر سیاست، اجرای دستی، دانلود، تست بازگردانی
model BackupAuditLog {
  id     Int      @id @default(autoincrement())
  at     DateTime @default(now())
  action String
  detail String?
  ip     String?

  @@index([at])
}

// ─── منابع انسانی › پرسنلی ─────────────────────────────────────────────────────
// اصل SSOT: هر واقعیت یک خانه دارد. شخص (نام، کد ملی، تاریخ تولد، جنسیت، نشانی، تلفن، حساب بانکی) روی Party؛ «کارمند» فقط واقعیت‌های
// استخدامی و بقیه‌ی مشخصات شخصیِ مرتبط با پرونده‌ی پرسنلی را دارد. کد تفصیلی کارمند همان Party.detailCode است (کد دوم نداریم).

enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum MilitaryStatus {
  NOT_APPLICABLE
  COMPLETED
  EXEMPT
  SUBJECT
  IN_SERVICE
}

/// وضعیت استخدام (منطق محاسبات به آن وابسته است، پس ثابت است): شاغل، مرخصی بدون حقوق، مرخصی استعلاجی، خاتمه همکاری، بازنشسته، تعلیق، ترک کار
enum EmployeeStatus {
  ACTIVE
  UNPAID_LEAVE
  SICK_LEAVE
  TERMINATED
  RETIRED
  SUSPENDED
  ABANDONED
}

enum DependentRelation {
  SPOUSE
  CHILD
  FATHER
  MOTHER
  SIBLING
  OTHER
}

/// نوع همکاری (دائم، قرارداد معین، …)؛ فهرست قابل‌تعریف هر شرکت
model EmploymentType {
  id              Int        @id @default(autoincrement())
  code            Int        @unique
  title           String     @unique
  isActive        Boolean    @default(true)
  hasTransactions Boolean    @default(false)
  decrees         EmploymentDecree[]
}

model EducationLevel {
  id              Int        @id @default(autoincrement())
  code            Int        @unique
  title           String     @unique
  isActive        Boolean    @default(true)
  hasTransactions Boolean    @default(false)
  records         EmployeeEducationRecord[]
}

model TerminationReason {
  id              Int                @id @default(autoincrement())
  code            Int                @unique
  title           String             @unique
  isActive        Boolean            @default(true)
  hasTransactions Boolean            @default(false)
  statusRecords   EmployeeStatusRecord[]
}

/// پست سازمانی. انتصاب هر کارمند همیشه به یک پست است؛ شرکتی که پست ندارد از «پست پیش‌فرض» (isDefault، دقیقاً یکی، حذف‌نشدنی) استفاده می‌کند
/// تا بعداً با شروع استفاده از پست‌ها، داده‌ی یک‌دست بماند (ایندکس یکتای جزئی در مایگریشن).
model Position {
  id              Int                  @id @default(autoincrement())
  code            Int                  @unique
  title           String               @unique
  orgUnitId       Int?
  isDefault       Boolean              @default(false)
  isActive        Boolean              @default(true)
  hasTransactions Boolean              @default(false)
  createdAt       DateTime             @default(now())
  orgUnit         OrgUnit?             @relation(fields: [orgUnitId], references: [id])
  assignments     EmployeeAssignment[]
  employmentDecrees   EmploymentDecree[]
  /// شغل‌های مورد نیاز این پست و تعداد نیاز هر کدام
  jobs            PositionJob[]
}

model Employee {
  payrollIssueSettings PayrollIssueSetting[]
  id                     Int                  @id @default(autoincrement())
  /// کد پرسنلی (دستی؛ خالی = آخرین کد عددی + ۱ با همان طول)
  personnelCode          String               @unique
  partyId                Int                  @unique
  fatherName             String?
  birthCertificateNumber String?
  birthPlaceId           Int?
  issuePlaceId           Int?
  militaryStatus         MilitaryStatus?
  /// شماره بیمه تامین اجتماعی
  insuranceNumber        String?
  hasDisability          Boolean              @default(false)
  notes                  String?
  hasTransactions        Boolean              @default(false)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  party                  Party                @relation(fields: [partyId], references: [id])
  birthPlace             GeoRegion?           @relation("EmployeeBirthPlace", fields: [birthPlaceId], references: [id])
  issuePlace             GeoRegion?           @relation("EmployeeIssuePlace", fields: [issuePlaceId], references: [id])
  photo                  EmployeePhoto?
  educationRecords        EmployeeEducationRecord[]
  decrees                EmploymentDecree[]
  veteranRecords         EmployeeVeteranRecord[]
  maritalRecords         EmployeeMaritalRecord[]
  statusRecords          EmployeeStatusRecord[]
  beneficiaries          EmployeeBeneficiary[]
  assignments            EmployeeAssignment[]
  dependents             EmployeeDependent[]
  payrollSlips           PayrollSlip[]
  payrollInputs          PayrollFactorInput[]
  loans                  Loan[]
  payrollParamValues     PayrollEmployeeParameterValue[]
  /// حساب دریافت حقوق (تاریخ‌دار، به تفکیک نوع پرداخت حقوق)
  salaryAccounts         EmployeeSalaryAccount[]
}

/// عکس کارمند (حداکثر ۳۰۰ کیلوبایت)؛ جدا از Employee تا فهرست‌ها داده‌ی باینری نخوانند
model EmployeePhoto {
  employeeId Int      @id
  mimeType   String
  data       Bytes
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

/// دوره‌ی همکاری؛ استخدام مجدد = دوره‌ی تازه روی همان Employee (کد پرسنلی و سابقه می‌ماند). حداکثر یک دوره‌ی باز (endDate خالی) برای هر کارمند
/// سابقه‌ی وضعیت همکاری کارمند (تنها منبع وضعیت و دوره‌های همکاری): از «تاریخ اعمال» به بعد کارمند در این وضعیت است تا رکورد بعدی.
/// اولین رکورد = شروع همکاری (ACTIVE)؛ وضعیت‌های پایان (خاتمه/بازنشسته/ترک کار) در «اولین روز بعد از همکاری» ثبت می‌شوند و بعد از آن فقط ACTIVE (استخدام مجدد) می‌آید.
/// «دوره‌ی همکاری» ذخیره نمی‌شود و از همین رکوردها مشتق می‌شود (services/employmentStatusService.ts)؛ وضعیت جاری = آخرین رکورد تا امروز.
model EmployeeStatusRecord {
  id                  Int                @id @default(autoincrement())
  employeeId          Int
  effectiveDate       DateTime           @db.Date
  status              EmployeeStatus
  terminationReasonId Int?
  note                String?
  createdAt           DateTime           @default(now())
  employee            Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  terminationReason   TerminationReason? @relation(fields: [terminationReasonId], references: [id])
  /// احکامی که عطف به این شروع همکاری صادر شده‌اند
  decrees             EmploymentDecree[] @relation("DecreeStartRecord")

  @@unique([employeeId, effectiveDate])
}

/// انتصاب تاریخ‌دار: کارمند × پست × واحد سازمانی × (مرکز هزینه / پروژه). یک انتصاب فعال (toDate خالی) در هر زمان؛ تغییر = بستن قبلی + ردیف تازه
model EmployeeAssignment {
  id           Int         @id @default(autoincrement())
  employeeId   Int
  positionId   Int
  orgUnitId    Int
  costCenterId Int?
  fromDate     DateTime    @db.Date
  toDate       DateTime?   @db.Date
  createdAt    DateTime    @default(now())
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  position     Position    @relation(fields: [positionId], references: [id])
  /// شغل کارمند در این پست (از شغل‌های تخصیص‌داده‌شده به پست؛ پستِ بدون شغل = خالی)
  jobId        Int?
  job          Job?        @relation(fields: [jobId], references: [id], onDelete: Restrict)
  orgUnit      OrgUnit     @relation(fields: [orgUnitId], references: [id])
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])
  appliedByDecrees EmploymentDecree[] @relation("DecreeAppliedAssignment")

  @@index([employeeId])
}

/// فرد تحت تکفل؛ به‌ازای هر کارمند جدا ثبت می‌شود (تصمیم کاربر: بدون نگهداری مشترک)
model EmployeeDependent {
  id                        Int               @id @default(autoincrement())
  employeeId                Int
  relation                  DependentRelation
  firstName                 String
  lastName                  String
  nationalId                String?
  birthDate                 DateTime?         @db.Date
  gender                    Gender?
  /// مشمول حق اولاد (فقط برای فرزند معنی دارد)
  eligibleForChildAllowance Boolean           @default(false)
  isStudent                 Boolean           @default(false)
  hasDisability             Boolean           @default(false)
  note                      String?
  employee                  Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

// ─── سوابق تاریخ‌دار پرسنلی (موجودیت مستقل؛ مقدار هر تاریخ = آخرین سابقه با تاریخ اعمال ≤ آن تاریخ) ───
// مقدار «فعلی» هرگز روی Employee ذخیره نمی‌شود (SSOT). برای هر کارمند حداقل یک سابقه‌ی هر نوع لازم است (در ثبت کارمند ساخته می‌شود).

/// سابقه‌ی تحصیلی
model EmployeeEducationRecord {
  id               Int            @id @default(autoincrement())
  employeeId       Int
  effectiveDate    DateTime       @db.Date
  educationLevelId Int
  field            String?
  note             String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  employee         Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  educationLevel   EducationLevel @relation(fields: [educationLevelId], references: [id])

  @@unique([employeeId, effectiveDate])
}

/// سابقه‌ی ایثارگری (درصد اختیاری)
model EmployeeVeteranRecord {
  id            Int      @id @default(autoincrement())
  employeeId    Int
  effectiveDate DateTime @db.Date
  isVeteran     Boolean
  percent       Decimal? @db.Decimal(5, 2)
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, effectiveDate])
}

/// سابقه‌ی وضعیت تاهل
model EmployeeMaritalRecord {
  id            Int           @id @default(autoincrement())
  employeeId    Int
  effectiveDate DateTime      @db.Date
  maritalStatus MaritalStatus
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, effectiveDate])
}

// ─── حکم کارگزینی (قرارداد و حکم یک سند است — تصمیم کاربر) ───────────────────────────────────────────────────────────────────
// اجزای حکم در منابع انسانی تعریف می‌شوند؛ روش محاسبه/مشمولیت بیمه و مالیات در ماژول حقوق (لایه‌ی تاریخ‌دار جدا) می‌آید.
// حکم تاییدشده تغییر نمی‌کند؛ اعتبار آن از تاریخ اعمال تا min(تاریخ پایان، روز قبل از تاریخ اعمال حکم بعدی) محاسبه می‌شود (ذخیره نمی‌شود).

enum DecreeValueType {
  MONTHLY_AMOUNT
  DAILY_AMOUNT
  HOURLY_AMOUNT
  PERCENT
}

enum DecreeType {
  HIRE
  RENEWAL
  ANNUAL_RAISE
  PROMOTION
  AMENDMENT
}

enum DecreeStatus {
  DRAFT
  APPROVED
}

model DecreeComponent {
  fileFieldRefs FileStructureFieldRef[]
  journalTemplates PayrollJournalTemplate[]
  id              Int                  @id @default(autoincrement())
  code            Int                  @unique
  title           String               @unique
  valueType       DecreeValueType
  isActive        Boolean              @default(true)
  hasTransactions Boolean              @default(false)
  lines           EmploymentDecreeLine[]
  methods         PayrollFactorMethod[]
}

model EmploymentDecree {
  id                   Int                  @id @default(autoincrement())
  number               Int                  @unique
  employeeId           Int
  type                 DecreeType
  issueDate            DateTime             @db.Date
  effectiveDate        DateTime             @db.Date
  /// پایان اعتبار (قرارداد)؛ خالی = دائم/بدون پایان
  endDate              DateTime?            @db.Date
  employmentTypeId     Int
  weeklyHours          Decimal?             @db.Decimal(5, 2)
  description          String?
  status               DecreeStatus         @default(DRAFT)
  /// تغییر انتصاب همراه حکم (اختیاری): هنگام تایید با همان تابع انتصاب اعمال می‌شود
  positionId           Int?
  orgUnitId            Int?
  costCenterId         Int?
  /// شغل انتصاب (فقط وقتی پستِ حکم شغل دارد)
  jobId                Int?
  appliedAssignmentId  Int?
  previousAssignmentId Int?
  /// شروع همکاریِ مرجع: رکورد «شروع» (EmployeeStatusRecord) دوره‌ای که این حکم عطف به آن صادر شده (از تاریخ صدور مشتق می‌شود؛ خالی فقط برای احکام قدیمی)
  startRecordId        Int?
  approvedAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  employee             Employee             @relation(fields: [employeeId], references: [id])
  startRecord          EmployeeStatusRecord? @relation("DecreeStartRecord", fields: [startRecordId], references: [id], onDelete: Restrict)
  employmentType       EmploymentType       @relation(fields: [employmentTypeId], references: [id])
  position             Position?            @relation(fields: [positionId], references: [id])
  job                  Job?                 @relation(fields: [jobId], references: [id], onDelete: Restrict)
  orgUnit              OrgUnit?             @relation(fields: [orgUnitId], references: [id])
  costCenter           CostCenter?          @relation(fields: [costCenterId], references: [id])
  appliedAssignment    EmployeeAssignment?  @relation("DecreeAppliedAssignment", fields: [appliedAssignmentId], references: [id], onDelete: SetNull)
  lines                EmploymentDecreeLine[]

  @@index([employeeId, effectiveDate])
  @@index([startRecordId])
  payrollSlips         PayrollSlip[]
}

model EmploymentDecreeLine {
  id          Int              @id @default(autoincrement())
  decreeId    Int
  componentId Int
  value       Decimal          @db.Decimal(20, 4)
  decree      EmploymentDecree @relation(fields: [decreeId], references: [id], onDelete: Cascade)
  component   DecreeComponent  @relation(fields: [componentId], references: [id])

  @@unique([decreeId, componentId])
}

// ─── حقوق و دستمزد › تنظیمات › پارامترهای قانونی ──────────────────────────────────────────────────────────────────────────────
// تعریف پارامتر (کلید ثابت، نوع) + مقدارهای تاریخ‌دار؛ مقدار معتبر هر تاریخ = آخرین مقدار با تاریخ شروع ≤ آن تاریخ.
// تنها خواننده‌ی مقدار: services/payrollParameterService.ts (فرمول‌ها/محاسبه‌ی حقوق از همان می‌خوانند).

enum PayrollParamType {
  NUMBER
  AMOUNT
  BRACKETS
}

model PayrollParameter {
  id          Int                     @id @default(autoincrement())
  /// کلید ثابت برای ارجاع فرمول‌ها (حروف بزرگ انگلیسی)؛ پارامترهای سیستمی تغییر یا حذف نمی‌شوند
  key         String                  @unique
  title       String
  type        PayrollParamType
  description String?
  isSystem    Boolean                 @default(false)
  isActive    Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  /// نوع: مقدار ثابت (مقدارهای تاریخ‌دار) یا مبنا (بدون مقدار؛ جمع مبلغ عامل‌های عضو که در «روش محاسبه عامل» مشخص می‌شوند)
  kind        PayrollParamKind        @default(CONSTANT)
  /// فقط مبنا: DECREE = جمع مقدارِ خام عامل‌های حکم، CALC = جمع مبلغ محاسبه‌شده‌ی عامل‌ها در فیش
  basisSource PayrollBasisSource?
  /// فقط مبنای منبع حکم: مقدار هر عامل حکمِ عضو = آخرین مقدار حکم (LAST) یا میانگین وزنیِ حکم (AVG)
  decreeValueMode PayrollDecreeValueMode?
  values      PayrollParameterValue[]
  members     PayrollFactorMethodBasis[]
  /// مقدارهای اختصاصی کارمندان (فقط انواع پرسنلی)
  employeeValues PayrollEmployeeParameterValue[]
}

enum PayrollParamKind {
  CONSTANT
  BASIS
  /// مقدار ثابت پرسنلی — ثبت در فرم کارمند توسط منابع انسانی
  PERSONNEL_HR
  /// مقدار ثابت پرسنلی — ثبت در فرم «مقادیر ثابت پرسنل» توسط واحد حقوق
  PERSONNEL_PAYROLL
}

enum PayrollDecreeValueMode {
  LAST
  AVG
}

enum PayrollBasisSource {
  DECREE
  CALC
}

/// عضویت یک رکورد «روش محاسبه عامل» در یک مبنا (تاریخچه از خودِ رکورد روش می‌آید: ماه اجرا)
model PayrollFactorMethodBasis {
  id          Int                 @id @default(autoincrement())
  methodId    Int
  parameterId Int
  /// true = با تأثیر (عضو مبنا)، false = بدون تأثیر (کاربر آگاهانه عضو نکرده)؛ نبودنِ ردیف = تعیین‌نشده
  effective   Boolean             @default(true)
  method      PayrollFactorMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)
  parameter   PayrollParameter    @relation(fields: [parameterId], references: [id], onDelete: Restrict)

  @@unique([methodId, parameterId])
  @@index([parameterId])
}

model PayrollParameterValue {
  id            Int                       @id @default(autoincrement())
  parameterId   Int
  effectiveDate DateTime                  @db.Date
  /// مقدار عددی (NUMBER/AMOUNT)؛ برای BRACKETS خالی است
  value         Decimal?                  @db.Decimal(20, 4)
  note          String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  /// ماه اجرا: ارجاع به ردیف تقویم کاری (مقدارهای قدیمیِ بدون تقویم NULL‌اند؛ effectiveDate همیشه اول همان ماه است)
  execCalendarMonthId Int?
  parameter     PayrollParameter          @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  execCalendarMonth WorkCalendarMonth?    @relation(fields: [execCalendarMonthId], references: [id], onDelete: Restrict)
  brackets      PayrollParameterBracket[]

  @@index([execCalendarMonthId])
  @@unique([parameterId, effectiveDate])
}

/// پله‌ی جدول پلکانی: از (شامل) تا (خالی = بی‌نهایت) با نرخ درصدی
model PayrollParameterBracket {
  id        Int                   @id @default(autoincrement())
  valueId   Int
  position  Int
  fromAmount Decimal              @db.Decimal(20, 4)
  toAmount  Decimal?              @db.Decimal(20, 4)
  rate      Decimal               @db.Decimal(7, 4)
  value     PayrollParameterValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@unique([valueId, position])
}

// ─── حقوق و دستمزد › اجزا، مشخصات محاسبه، کارکرد و فیش ────────────────────────────────────────────────────────────────────────

enum PayrollComponentKind {
  WORK
  EARNING
  DEDUCTION
  EMPLOYER_COST
  INFO
}

enum PayrollSectionKind {
  DECREE_COMPONENT
  PAYROLL_COMPONENT
}

/// عامل حقوق (هویت): عنوان + کلید داخلی که سیستم خودکار می‌سازد و به کاربر نمایش داده نمی‌شود. طبقه، روش و فرمول در رکوردهای تاریخ‌دار
/// «روش محاسبه عامل» (PayrollFactorMethod) می‌آید.
model PayrollComponent {
  fileFieldRefs FileStructureFieldRef[]
  paymentTypeItems PayrollPaymentTypeItem[]
  /// سازمان ذینفع مرتبط با عامل: کارمندِ «غیرمشمول» در این سازمان مبلغ این عامل را صفر می‌گیرد؛ در سند حقوق، طرف حساب «سازمان مرتبط با عامل» = شعبه‌ی کارمند در همین سازمان
  beneficiaryOrgId Int?
  beneficiaryOrg   BeneficiaryOrg? @relation(fields: [beneficiaryOrgId], references: [id], onDelete: Restrict)
  journalTemplates PayrollJournalTemplate[]
  id          Int                   @id @default(autoincrement())
  key         String                @unique
  title       String
  /// طبقه‌ی عامل (پرداختی/کسر/هزینه کارفرما/اطلاعاتی)؛ با زمان عوض نمی‌شود، پس روی خود عامل است نه روش محاسبه
  kind        PayrollComponentKind
  description String?
  isActive    Boolean               @default(true)
  /// true = در جمع طبقه‌ها ([S:پرداختی] و …) فرمول‌ها نیاید و وابستگی هم ساخته نشود (مثل «بدهی ماه جاری»؛ در جمع‌های فیش همچنان می‌آید)
  excludeFromSums Boolean           @default(false)
  createdAt   DateTime              @default(now())
  /// نوع محاسبه‌ای که عامل در آن می‌آید (حقوق ماهانه، عیدی، ذخیره سنوات، …)؛ هر عامل فقط به یک نوع تعلق دارد
  calcTypeId  Int
  calcType    PayrollCalcType       @relation(fields: [calcTypeId], references: [id], onDelete: Restrict)
  methods     PayrollFactorMethod[]
  inputs      PayrollFactorInput[]

  @@index([calcTypeId])
}

/// «نوع محاسبه» حقوق: حقوق ماهانه (نوع پایه، دقیقاً یکی) و انواع دیگر مثل عیدی/ذخیره سنوات/بازخرید مرخصی/بازخرید سنوات.
/// محاسبه‌ی هر نوعِ غیرپایه برای یک کارمند فقط وقتی مجاز است که فیش «حقوق ماهانه»ی همان ماه محاسبه شده باشد.
model PayrollCalcType {
  fileFieldRefs FileStructureFieldRef[]
  paymentTypeItems PayrollPaymentTypeItem[]
  journalTemplates PayrollJournalTemplate[]
  id          Int                 @id @default(autoincrement())
  title       String              @unique
  description String?
  /// نوع پایه (حقوق ماهانه): دقیقاً یکی (ایندکس یکتای جزئی در migration)؛ غیرقابل حذف
  isBase      Boolean             @default(false)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  components  PayrollComponent[]
  slips       PayrollSlip[]
}

/// نتیجه‌ی محاسبه‌ی یک کارمند در یک ماه (با همه‌ی ورودی‌ها و ریز هر جزء برای گزارش)
model PayrollSlip {
  /// سند حسابداری صادرشده برای این فیش (یک سند می‌تواند فیش چند کارمند را داشته باشد)؛ با حذف سند خالی می‌شود
  journalEntryId Int?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  id            Int               @id @default(autoincrement())
  employeeId    Int
  year          Int
  month         Int
  calcTypeId    Int
  decreeId      Int?
  monthDays     Int
  earnings      Decimal           @db.Decimal(20, 4)
  deductions    Decimal           @db.Decimal(20, 4)
  employerCosts Decimal           @db.Decimal(20, 4)
  netPay        Decimal           @db.Decimal(20, 4)
  hasErrors     Boolean           @default(false)
  /// {key: {title, type, effectiveDate, value|brackets}} پارامترهای استفاده‌شده
  parameters    Json
  warnings      Json
  calculatedAt  DateTime          @default(now())
  employee      Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  decree        EmploymentDecree? @relation(fields: [decreeId], references: [id], onDelete: Restrict)
  lines         PayrollSlipLine[]
  calcType      PayrollCalcType   @relation(fields: [calcTypeId], references: [id], onDelete: Restrict)
  calendarMonth WorkCalendarMonth @relation(fields: [year, month], references: [year, month], onDelete: Restrict)
  loanBalances  LoanMonthlyBalance[]

  @@unique([employeeId, year, month, calcTypeId])
  @@index([calcTypeId])
}

model PayrollSlipLine {
  id          Int                  @id @default(autoincrement())
  slipId      Int
  seq         Int
  kind        PayrollComponentKind
  source      PayrollSectionKind
  /// شناسه‌ی جزء حکم / جزء حقوق (فقط برای مرجع؛ عنوان و فرمول در همین ردیف کپی شده‌اند)
  refId       Int?
  /// شناسه‌ی «روش محاسبه عامل»ی که این ردیف با آن محاسبه شده؛ تا وقتی فیش هست آن روش قفل است
  methodId    Int?
  title       String
  formula     String?
  insurable   Boolean              @default(false)
  taxable     Boolean              @default(false)
  amount      Decimal              @db.Decimal(20, 4)
  error       String?
  /// {expression, operands[], note}
  trace       Json
  slip        PayrollSlip          @relation(fields: [slipId], references: [id], onDelete: Cascade)

  @@unique([slipId, seq])
  @@index([methodId])
}

enum PayrollMethod {
  CALCULATED
  MANUAL
  ATTENDANCE
  TREASURY
}

/// نوع پارامتر (نوع مقدار) عامل
enum PayrollValueType {
  NUMBER
  TIME
  DAYS
  AMOUNT
}

/// روش محاسبه‌ی عامل (تاریخ‌دار با «ماه اجرا»): مبنا = عامل حکم (decreeComponentId) یا عامل حقوق (payrollComponentId)؛ دقیقاً یکی (CHECK).
/// برای عامل حکم، فرمول تعیین می‌کند مقدار حکم چگونه به مبلغ پرداختی ماه تبدیل شود. شرط (اختیاری) اگر برقرار نباشد مقدار عامل صفر است.
model PayrollFactorMethod {
  id                 Int                  @id @default(autoincrement())
  decreeComponentId  Int?
  payrollComponentId Int?
  method             PayrollMethod        @default(CALCULATED)
  valueType          PayrollValueType     @default(AMOUNT)
  /// ماه صدور و ماه اجرا (هر دو اجباری) فقط به‌صورت ارجاع به ردیف «تقویم کاری»؛ سال/ماه/تاریخ جدا ذخیره نمی‌شود.
  /// روش مؤثر یک ماه = آخرین رکورد عامل که تاریخ شروعِ ماه اجرای آن (WorkCalendarMonth.startDate) ≤ پایان آن ماه است
  issueCalendarMonthId Int
  execCalendarMonthId  Int
  isProvisional      Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  decreeComponent    DecreeComponent?     @relation(fields: [decreeComponentId], references: [id], onDelete: Cascade)
  payrollComponent   PayrollComponent?    @relation(fields: [payrollComponentId], references: [id], onDelete: Cascade)
  /// شاخه‌های «شرط ← فرمول» (فقط روش محاسباتی و عامل حکم)؛ از بالا به پایین، اولین شاخه‌ی دارای شرطِ برقرار اجرا می‌شود
  branches           PayrollFactorMethodBranch[]
  /// مبناهایی که این روش (عامل) در آن‌ها عضو است
  bases              PayrollFactorMethodBasis[]
  issueCalendarMonth WorkCalendarMonth    @relation("MethodIssueMonth", fields: [issueCalendarMonthId], references: [id], onDelete: Restrict)
  execCalendarMonth  WorkCalendarMonth    @relation("MethodExecMonth", fields: [execCalendarMonthId], references: [id], onDelete: Restrict)

  @@index([issueCalendarMonthId])
  @@index([execCalendarMonthId])
  @@unique([decreeComponentId, execCalendarMonthId])
  @@unique([payrollComponentId, execCalendarMonthId])
}

/// مقدار ورودی ماهانه‌ی عوامل با روش «ورود دستی / ورود از تردد / ورود از خزانه‌داری» برای هر کارمند
model PayrollFactorInput {
  id          Int              @id @default(autoincrement())
  employeeId  Int
  year        Int
  month       Int
  componentId Int
  value       Decimal          @db.Decimal(20, 4)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  component   PayrollComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  /// ماه باید در «تقویم کاری» باشد (FK روی سال+ماه؛ ردیف‌های قدیمیِ بدون تقویم معاف‌اند — NOT VALID)
  calendarMonth WorkCalendarMonth  @relation(fields: [year, month], references: [year, month], onDelete: Restrict)

  @@unique([employeeId, year, month, componentId])
}

/// تقویم کاری یک سال شمسی (حقوق و دستمزد): ساعات کاری روزانه + ۱۲ ماه با روزها/ساعات استاندارد و مجاز.
/// ماه‌هایی که در فرم‌های حقوق (روش محاسبه، پارامتر مبنا، ورود اطلاعات، محاسبه) انتخاب می‌شوند فقط از همین تقویم می‌آیند.
model WorkCalendar {
  id           Int                 @id @default(autoincrement())
  year         Int                 @unique
  /// ساعات کاری روزانه (دقیقه؛ حداکثر ۲۳:۵۹ = ۱۴۳۹)
  dailyMinutes Int
  createdAt    DateTime            @default(now())
  months       WorkCalendarMonth[]
}

model WorkCalendarMonth {
  payrollTemplates PayrollJournalTemplate[] @relation("PayrollTemplateMonth")
  payrollIssueSettings PayrollIssueSetting[] @relation("PayrollIssueSettingMonth")
  id               Int          @id @default(autoincrement())
  calendarId       Int
  /// سال تقویم (نسخه‌ی هم‌گام‌شده از WorkCalendar.year برای ارجاع سال+ماه از فیش و ورودی ماهانه)
  year             Int
  month            Int
  /// اول و آخر ماه شمسی (قابل تغییر نیست)
  startDate        DateTime     @db.Date
  endDate          DateTime     @db.Date
  standardDays     Int
  allowedDays      Int
  /// ساعات (دقیقه): استاندارد = روز استاندارد × ساعات روزانه؛ مجاز پیش‌فرض = روز مجاز × ساعات روزانه (قابل ویرایش)
  standardMinutes  Int
  allowedMinutes   Int
  /// بازه‌ی تردد (پیش‌فرض = ابتدا/انتهای ماه؛ در مدیریت تردد استفاده خواهد شد)
  trafficStartDate DateTime     @db.Date
  trafficEndDate   DateTime     @db.Date
  calendar         WorkCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  /// ارجاع‌های حقوق و دستمزد به این ردیف (همه Restrict: ماه/تقویمِ استفاده‌شده حذف نمی‌شود)
  issueMethods     PayrollFactorMethod[]    @relation("MethodIssueMonth")
  execMethods      PayrollFactorMethod[]    @relation("MethodExecMonth")
  paramValues      PayrollParameterValue[]
  slips            PayrollSlip[]
  inputs           PayrollFactorInput[]
  loanStarts       Loan[]               @relation("LoanStartMonth")
  loanAdjustments  LoanAdjustment[]     @relation("LoanAdjustmentMonth")
  loanSuspensionsFrom LoanSuspension[]  @relation("LoanSuspensionFrom")
  loanSuspensionsTo   LoanSuspension[]  @relation("LoanSuspensionTo")
  employeeParamValues PayrollEmployeeParameterValue[]
  salaryAccountMonths EmployeeSalaryAccount[]

  @@unique([calendarId, month])
  @@unique([year, month])
}

/// یک شاخه‌ی «اگر شرط آنگاه فرمول» از روش محاسبه‌ی عامل. شرط خالی (فقط برای آخرین شاخه) = «در غیر این صورت».
/// هیچ شاخه‌ای برقرار نباشد ⇒ مقدار عامل صفر.
model PayrollFactorMethodBranch {
  id            Int                  @id @default(autoincrement())
  methodId      Int
  seq           Int
  conditionText String?
  formulaText   String
  method        PayrollFactorMethod  @relation(fields: [methodId], references: [id], onDelete: Cascade)

  @@unique([methodId, seq])
}

// ── حقوق و دستمزد › وام ──

/// نوع وام: عنوان + سازمان مرتبط اختیاری (شخص حقوقی از نوع بانک / موسسه مالی و اعتباری)
model LoanType {
  paymentTypeItems PayrollPaymentTypeItem[]
  journalTemplates PayrollJournalTemplate[]
  id                 Int      @id @default(autoincrement())
  title              String   @unique
  institutionPartyId Int?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  institution        Party?   @relation(fields: [institutionPartyId], references: [id], onDelete: Restrict)
  loans              Loan[]
}

/// تکلیف باقیمانده‌ی تقسیم مبلغ وام بر قسط: همراه با قسط اول / همراه با قسط آخر / یک قسط جدا بعد از قسط آخر
enum LoanRemainderMode {
  WITH_FIRST
  WITH_LAST
  EXTRA_LAST
}

/// پرداخت وام به کارمند (شماره‌ی خودکار)؛ اقساط از ماه شروع (ماه تقویم کاری) و بر اساس «مانده» کسر می‌شوند
model Loan {
  id                Int                  @id @default(autoincrement())
  number            Int                  @unique
  paymentDate       DateTime             @db.Date
  employeeId        Int
  loanTypeId        Int
  amount            Decimal              @db.Decimal(20, 4)
  installmentCount  Int
  installmentAmount Decimal              @db.Decimal(20, 4)
  startMonthId      Int
  remainderMode     LoanRemainderMode
  description       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  employee          Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  loanType          LoanType             @relation(fields: [loanTypeId], references: [id], onDelete: Restrict)
  startMonth        WorkCalendarMonth    @relation("LoanStartMonth", fields: [startMonthId], references: [id], onDelete: Restrict)
  balances          LoanMonthlyBalance[]
  adjustmentLines   LoanAdjustmentLine[]
  suspensionLines   LoanSuspensionLine[]

  @@index([employeeId])
}

/// مانده‌ی ماهانه‌ی وام که همزمان با محاسبه‌ی «حقوق ماهانه» ثبت می‌شود؛ با حذف فیش، خودکار پاک می‌شود (مانده‌ی ماه بعد از همین ردیف شروع می‌شود)
model LoanMonthlyBalance {
  id            Int         @id @default(autoincrement())
  loanId        Int
  slipId        Int
  year          Int
  month         Int
  installment   Decimal     @db.Decimal(20, 4)
  balanceBefore Decimal     @db.Decimal(20, 4)
  balanceAfter  Decimal     @db.Decimal(20, 4)
  loan          Loan        @relation(fields: [loanId], references: [id], onDelete: Restrict)
  slip          PayrollSlip @relation(fields: [slipId], references: [id], onDelete: Cascade)

  @@unique([loanId, year, month])
  @@index([slipId])
}

/// اصلاح مانده / قسط وام از یک ماه به بعد
model LoanAdjustment {
  id          Int                  @id @default(autoincrement())
  number      Int                  @unique
  date        DateTime             @db.Date
  fromMonthId Int
  description String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  fromMonth   WorkCalendarMonth    @relation("LoanAdjustmentMonth", fields: [fromMonthId], references: [id], onDelete: Restrict)
  lines       LoanAdjustmentLine[]
}

model LoanAdjustmentLine {
  id             Int            @id @default(autoincrement())
  adjustmentId   Int
  loanId         Int
  /// مبلغی که کارمند خارج از سیستم حقوق تسویه کرده (از مانده کم می‌شود)
  settledAmount  Decimal?       @db.Decimal(20, 4)
  /// مبلغ قسط جدید از ماه اصلاح به بعد
  newInstallment Decimal?       @db.Decimal(20, 4)
  adjustment     LoanAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  loan           Loan           @relation(fields: [loanId], references: [id], onDelete: Restrict)

  @@unique([adjustmentId, loanId])
}

/// تعلیق وام: در بازه‌ی «از ماه تا ماه» قسطی کسر نمی‌شود (برنامه به همان اندازه عقب می‌رود)
model LoanSuspension {
  id          Int                  @id @default(autoincrement())
  number      Int                  @unique
  date        DateTime             @db.Date
  fromMonthId Int
  toMonthId   Int
  description String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  fromMonth   WorkCalendarMonth    @relation("LoanSuspensionFrom", fields: [fromMonthId], references: [id], onDelete: Restrict)
  toMonth     WorkCalendarMonth    @relation("LoanSuspensionTo", fields: [toMonthId], references: [id], onDelete: Restrict)
  lines       LoanSuspensionLine[]
}

model LoanSuspensionLine {
  id           Int            @id @default(autoincrement())
  suspensionId Int
  loanId       Int
  suspension   LoanSuspension @relation(fields: [suspensionId], references: [id], onDelete: Cascade)
  loan         Loan           @relation(fields: [loanId], references: [id], onDelete: Restrict)

  @@unique([suspensionId, loanId])
}

// ── منابع انسانی › شغل ──

/// شغل: کد خودکار، عنوان، کد تامین اجتماعی و سه متن (شرح شغل، مهارت‌های تخصصی، ویژگی‌های فردی)
model Job {
  id                Int                  @id @default(autoincrement())
  code              Int                  @unique
  title             String               @unique
  socialSecurityCode String?
  description       String?
  specializedSkills String?
  personalTraits    String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  positions         PositionJob[]
  assignments       EmployeeAssignment[]
  decrees           EmploymentDecree[]
}

/// شغلِ مورد نیاز یک پست با تعداد نفرات (مثلاً پست «کارشناس حسابداری» ← شغل «حسابدار» ۳ نفر)
model PositionJob {
  id            Int      @id @default(autoincrement())
  positionId    Int
  jobId         Int
  requiredCount Int
  position      Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@unique([positionId, jobId])
  @@index([jobId])
}

/// مقدار ثابت پرسنلی یک کارمند از یک ماه تقویم کاری به بعد (تا مقدار بعدی)؛ ثبت‌نشده = صفر.
/// مقدار مؤثر یک ماه = آخرین رکورد با effectiveDate (روز اول ماه اجرا) ≤ پایان آن ماه
model PayrollEmployeeParameterValue {
  id               Int               @id @default(autoincrement())
  parameterId      Int
  employeeId       Int
  execCalendarMonthId Int
  effectiveDate    DateTime          @db.Date
  value            Decimal           @db.Decimal(20, 4)
  createdById      Int?
  createdAt        DateTime          @default(now())
  parameter        PayrollParameter  @relation(fields: [parameterId], references: [id], onDelete: Restrict)
  employee         Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  execCalendarMonth WorkCalendarMonth @relation(fields: [execCalendarMonthId], references: [id], onDelete: Restrict)
  createdBy        User?             @relation("EmployeeParamValueCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([parameterId, employeeId, execCalendarMonthId])
  @@index([employeeId])
}

// ── منابع انسانی › سازمان ذینفع (تامین اجتماعی، امور مالیاتی، …) ──

enum BeneficiaryOrgType {
  SOCIAL_SECURITY
  TAX
  OTHER
}

/// سازمان ذینفع: کد (خودکار = آخرین + ۱)، عنوان یکتا، نوع، فعال
model BeneficiaryOrg {
  paymentTypes PayrollPaymentType[]
  payrollComponents PayrollComponent[]
  id        Int                 @id @default(autoincrement())
  code      Int                 @unique
  title     String              @unique
  type      BeneficiaryOrgType
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  branches  BeneficiaryBranch[]
  employees EmployeeBeneficiary[]
}

/// شعبه‌ی سازمان ذینفع: شعبه = یک شخص حقوقی؛ شماره پرونده/کد کارگاه (دستی)؛ ردیف پیمان، کارفرما و آدرس فقط برای تامین اجتماعی
model BeneficiaryBranch {
  id             Int                   @id @default(autoincrement())
  organizationId Int
  partyId        Int
  /// «کد کارگاه» (تامین اجتماعی) یا «شماره پرونده» (سایر)
  fileNumber     String
  /// ردیف پیمان (فقط تامین اجتماعی؛ خالی = ""، تا یکتایی ترکیبی کار کند)
  contractRow    String                @default("")
  employer       String?
  address        String?
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  organization   BeneficiaryOrg        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  party          Party                 @relation(fields: [partyId], references: [id], onDelete: Restrict)
  employees      EmployeeBeneficiary[]

  @@unique([organizationId, partyId, fileNumber, contractRow])
}

/// مشمولیت یک کارمند در یک سازمان ذینفع: مشمول (با شعبه) یا غیرمشمول؛ «تعیین‌نشده» یعنی ردیفی وجود ندارد
model EmployeeBeneficiary {
  id             Int                @id @default(autoincrement())
  employeeId     Int
  organizationId Int
  isIncluded     Boolean
  branchId       Int?
  employee       Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organization   BeneficiaryOrg     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         BeneficiaryBranch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([employeeId, organizationId])
}

// ── حقوق و دستمزد › حسابداری حقوق ──

enum PayrollEntryNature {
  DEBIT
  CREDIT
}

/// نوع طرف حسابِ ردیف الگو: پرسنل (طرف حساب خود کارمند) / سازمان مرتبط با عامل (شعبه‌ی کارمند در سازمان ذینفعِ عامل) / سازمان مامورکننده (از تنظیمات صدور)
enum PayrollPartyKind {
  EMPLOYEE
  FACTOR_ORG
  SECONDING_ORG
}

/// گروه حساب حقوق: کد (خودکار)، عنوان، «مامور به خدمت دارد» و انواع تفصیل (فعلاً فقط پروژه؛ بعد از اولین «تنظیمات صدور سند» قفل می‌شود)
model PayrollAccountGroup {
  id            Int                    @id @default(autoincrement())
  code          Int                    @unique
  title         String                 @unique
  hasSecondment Boolean                @default(false)
  usesProject   Boolean                @default(false)
  createdAt     DateTime               @default(now())
  templates     PayrollJournalTemplate[]
  settings      PayrollIssueSetting[]
}

/// الگوی سند حقوق — یک ردیف = یک «رکورد داده‌ای» مستقل (از ماه + گروه + عامل + حساب + ماهیت …). برای ماه M: بزرگ‌ترین «از ماه» ≤ M
/// از میان رکوردهای هر (گروه، مرجع) و همه‌ی رکوردهای فعالِ همان «از ماه» اجرا می‌شوند؛ اگر همه غیرفعال باشند «فاقد الگو» است.
/// مرجع دقیقاً یکی از: عامل حقوق / عامل حکم / خالص پرداختی (نوع محاسبه) / وام (نوع وام) — CHECK در مهاجرت.
model PayrollJournalTemplate {
  id                Int                 @id @default(autoincrement())
  fromMonthId       Int
  groupId           Int
  payrollComponentId Int?
  decreeComponentId Int?
  netCalcTypeId     Int?
  loanTypeId        Int?
  accountId         Int
  nature            PayrollEntryNature
  description       String?
  isActive          Boolean             @default(true)
  partyKind         PayrollPartyKind?
  createdAt         DateTime            @default(now())
  fromMonth         WorkCalendarMonth   @relation("PayrollTemplateMonth", fields: [fromMonthId], references: [id], onDelete: Restrict)
  group             PayrollAccountGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  payrollComponent  PayrollComponent?   @relation(fields: [payrollComponentId], references: [id], onDelete: Restrict)
  decreeComponent   DecreeComponent?    @relation(fields: [decreeComponentId], references: [id], onDelete: Restrict)
  netCalcType       PayrollCalcType?    @relation(fields: [netCalcTypeId], references: [id], onDelete: Restrict)
  loanType          LoanType?           @relation(fields: [loanTypeId], references: [id], onDelete: Restrict)
  account           Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([groupId, fromMonthId])
}

/// تنظیمات صدور سند حقوق: از یک ماه به بعد (آخرین رکورد ≤ ماه معتبر است) کارمند در چه گروه حسابی است و سازمان مامورکننده/پروژه‌ی او چیست
model PayrollIssueSetting {
  id               Int                 @id @default(autoincrement())
  fromMonthId      Int
  employeeId       Int
  groupId          Int
  secondingPartyId Int?
  projectId        Int?
  createdAt        DateTime            @default(now())
  fromMonth        WorkCalendarMonth   @relation("PayrollIssueSettingMonth", fields: [fromMonthId], references: [id], onDelete: Restrict)
  employee         Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  group            PayrollAccountGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  secondingParty   Party?              @relation("PayrollIssueSecondingParty", fields: [secondingPartyId], references: [id], onDelete: Restrict)
  project          Project?            @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([employeeId, fromMonthId])
}

/// پرداخت به چه کسی: پرسنل یا سازمان مرتبط با عامل
enum PayrollPayTo {
  EMPLOYEE
  FACTOR_ORG
}

/// نوع پرداخت حقوق (تنظیمات حقوق): سربرگ + آیتم‌های عامل (کسور / هزینه کارفرما / وام / خالص پرداختی)
model PayrollPaymentType {
  id               Int                      @id @default(autoincrement())
  code             Int                      @unique
  title            String                   @unique
  isActive         Boolean                  @default(true)
  payTo            PayrollPayTo
  /// فقط وقتی payTo = FACTOR_ORG
  beneficiaryOrgId Int?
  beneficiaryOrg   BeneficiaryOrg?          @relation(fields: [beneficiaryOrgId], references: [id], onDelete: Restrict)
  /// «فایل دارد»: برای این نوع پرداخت فایل (مثلاً فایل بانکی) تولید می‌شود
  hasFile          Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  items            PayrollPaymentTypeItem[]
  salaryAccounts   EmployeeSalaryAccount[]
}

/// حساب دریافت حقوق کارمند: «از ماه» (تقویم کاری) × نوع پرداخت حقوق (فقط نوع «پرسنل») × یکی از حساب‌های بانکیِ همان شخص.
/// مؤثر برای ماه M و نوع T = آخرین رکورد همان نوع با «از ماه» ≤ M (services/employeeSalaryAccountService.ts، تنها نویسنده/خواننده).
model EmployeeSalaryAccount {
  id            Int                 @id @default(autoincrement())
  employeeId    Int
  paymentTypeId Int
  fromMonthId   Int
  bankAccountId Int
  note          String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  employee      Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  paymentType   PayrollPaymentType  @relation(fields: [paymentTypeId], references: [id], onDelete: Restrict)
  fromMonth     WorkCalendarMonth   @relation(fields: [fromMonthId], references: [id], onDelete: Restrict)
  bankAccount   PartyBankAccount    @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  @@unique([employeeId, paymentTypeId, fromMonthId])
  @@index([employeeId])
}

/// آیتم نوع پرداخت: دقیقاً یکی از عامل حقوق / نوع وام / خالص پرداختیِ یک نوع محاسبه
model PayrollPaymentTypeItem {
  id                 Int                @id @default(autoincrement())
  paymentTypeId      Int
  payrollComponentId Int?
  loanTypeId         Int?
  netCalcTypeId      Int?
  paymentType        PayrollPaymentType @relation(fields: [paymentTypeId], references: [id], onDelete: Cascade)
  payrollComponent   PayrollComponent?  @relation(fields: [payrollComponentId], references: [id], onDelete: Restrict)
  loanType           LoanType?          @relation(fields: [loanTypeId], references: [id], onDelete: Restrict)
  netCalcType        PayrollCalcType?   @relation(fields: [netCalcTypeId], references: [id], onDelete: Restrict)

  @@unique([paymentTypeId, payrollComponentId])
  @@unique([paymentTypeId, loanTypeId])
  @@unique([paymentTypeId, netCalcTypeId])
  @@index([paymentTypeId])
}

// ── ساختار فایل (فایل‌های بانک‌ها و سازمان‌ها: مالیات، تامین اجتماعی، …) ──

/// منبع داده‌ی ساختار: فعلاً فیش‌های حقوق یک ماه (بعداً فهرست پرداخت‌ها)
enum FileSourceKind {
  PAYROLL_LIST
}

enum FileFormat {
  DELIMITED
  DBF
  EXCEL
}

enum FileEncoding {
  UTF8
  UTF8_BOM
  IRAN_SYSTEM
}

enum FileLineEnding {
  LF
  CRLF
}

/// بخش فایل: هدر (یک یا چند خط در ابتدا)، آیتم‌ها (به ازای هر کارمند یک یا چند خط)، فوتر (در انتها)
enum FileSection {
  HEADER
  ITEM
  FOOTER
}

enum FileFieldType {
  TEXT
  NUMBER
}

enum FileFieldSource {
  CONSTANT
  EMPLOYEE_FIELD
  FACTOR_SUM
  AGGREGATE
  PARAM
  EXPR
  EMPTY
}

enum FileAggFunc {
  SUM
  COUNT
}

/// ساختار فایل تعریف‌شده‌ی کاربر (ساختارهای پیش‌فرض نصب در کد هستند و با «کپی» اینجا می‌آیند)
model FileStructure {
  id          Int                 @id @default(autoincrement())
  code        Int                 @unique
  title       String              @unique
  sourceKind  FileSourceKind      @default(PAYROLL_LIST)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  files       FileStructureFile[]
}

model FileStructureFile {
  id              Int                  @id @default(autoincrement())
  structureId     Int
  seq             Int
  /// الگوی نام فایل: {YYYY} سال شمسی ۴ رقمی، {YY} ۲ رقمی، {MM} ماه ۲ رقمی
  nameTemplate    String
  format          FileFormat
  /// نام برگه (فقط اکسل)
  sheetName       String?
  delimiter       String               @default(",")
  encoding        FileEncoding         @default(UTF8)
  lineEnding      FileLineEnding       @default(LF)
  trailingNewline Boolean              @default(true)
  structure       FileStructure        @relation(fields: [structureId], references: [id], onDelete: Cascade)
  fields          FileStructureField[]

  @@unique([structureId, seq])
}

model FileStructureField {
  id            Int                      @id @default(autoincrement())
  fileId        Int
  seq           Int
  /// نام فیلد (DBF: حداکثر ۱۰ نویسه‌ی انگلیسی؛ در فرمول EXPR هم با همین نام صدا زده می‌شود)
  name          String
  title         String
  dataType      FileFieldType            @default(TEXT)
  length        Int?
  decimals      Int                      @default(0)
  zeroPad       Boolean                  @default(false)
  /// بخش و شماره‌ی خطی که این فیلد در آن می‌آید (ترتیب فیلدها داخل یک خط = seq)
  section       FileSection              @default(ITEM)
  lineNo        Int                      @default(1)
  /// مقدار خالی برای کارمند = خطای بازدارنده
  required      Boolean                  @default(false)
  /// اگر مقدار صفر/خالی بود کل ردیفِ آن کارمند در فایل نمی‌آید
  skipRowIfZero Boolean                  @default(false)
  source        FileFieldSource
  constantValue String?
  systemField   String?
  paramKey      String?
  aggFunc       FileAggFunc?
  aggFileSeq    Int?
  aggFieldName  String?
  exprText      String?
  file          FileStructureFile        @relation(fields: [fileId], references: [id], onDelete: Cascade)
  refs          FileStructureFieldRef[]
  maps          FileStructureFieldMap[]

  @@unique([fileId, seq])
}

/// عامل‌های مجموع‌گیری‌شده‌ی یک فیلد (دقیقاً یکی از عامل حقوق / عامل حکم / خالص پرداختیِ یک نوع محاسبه)
model FileStructureFieldRef {
  id                 Int                @id @default(autoincrement())
  fieldId            Int
  payrollComponentId Int?
  decreeComponentId  Int?
  netCalcTypeId      Int?
  field              FileStructureField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  payrollComponent   PayrollComponent?  @relation(fields: [payrollComponentId], references: [id], onDelete: Restrict)
  decreeComponent    DecreeComponent?   @relation(fields: [decreeComponentId], references: [id], onDelete: Restrict)
  netCalcType        PayrollCalcType?   @relation(fields: [netCalcTypeId], references: [id], onDelete: Restrict)

  @@unique([fieldId, payrollComponentId])
  @@unique([fieldId, decreeComponentId])
  @@unique([fieldId, netCalcTypeId])
  @@index([fieldId])
}

/// نگاشت مقدار (مثلاً «کارشناسی» ← ۴) برای فیلدهای متنیِ سیستمی
model FileStructureFieldMap {
  id          Int                @id @default(autoincrement())
  fieldId     Int
  sourceValue String
  targetValue String
  field       FileStructureField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, sourceValue])
}
