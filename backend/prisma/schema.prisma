// بچ — طبق stockAnalysis.md بند ۱۰-۱۶: Master مستقل و مشترک در کل ERP، نه رشته‌ی آزاد در سطر سند.
// یکتایی روی (goodsItemId, batchNumber) — یعنی همان شماره بچ برای دو کالای مختلف مجاز است (بند ۱۲).
// تاریخ انقضا فقط اینجا نگه‌داری می‌شود، نه در سطر سند انبار (بند ۱۳).
model Batch {
  id                    Int                    @id @default(autoincrement())
  goodsItemId           Int
  batchNumber           String
  productionDate        DateTime?              @db.Date
  expiryDate            DateTime?              @db.Date
  sourceType            BatchSourceType        @default(MANUAL)
  supplierId            Int?
  productionReferenceId Int?
  description           String?
  isActive              Boolean                @default(true)
  hasTransactions       Boolean                @default(false)
  createdAt             DateTime               @default(now())
  goodsItem             GoodsItem              @relation(fields: [goodsItemId], references: [id])
  supplier              Party?                 @relation("BatchSupplier", fields: [supplierId], references: [id])
  inventoryLines        InventoryLineBatch[]

  @@unique([goodsItemId, batchNumber])
}

// سریال — طبق stockAnalysis.md بند ۱۷-۲۰: Master مستقل، تعریف در ماژول کالا و خدمت؛ انبار فقط
// سریال‌های موجود را برای هر سطر سند انتخاب/مصرف می‌کند (از طریق جدول واسط InventoryLineSerial که
// در فاز اتصال به اسناد انبار اضافه می‌شود، نه اینجا).
// طبق «اصلاح مدل رهگیری کالا»: برای کالای سریال‌دار، بچ و تاریخ انقضا متعلق به خود سریال هستند (نه
// ردیف سند). طبق تصمیم صریح کاربر (۲۰۲۶/۰۹/۰۷)، batch دیگر FK به جدول Batch نیست — یک فیلد متنی آزاد
// و کاملا مستقل روی خودِ سریال است (نه یک رکورد Master مشترک)؛ expiryDate هم مستقل و همیشه قابل ثبت است.
// طبق «انتخاب سریال و بچ»: هر سریال یک چرخه‌ی عمر دارد (تعریف‌شده → رسید‌شده → خارج‌شده) که با
// قطعی/برگشت‌ازقطعی هر سند انبار مرتبط، خودکار تغییر می‌کند. step دقیقاً هم‌الگوی ChequeItem.step
// است (نگاه کنید به توضیح بالای آن مدل): با هر رویداد چرخه‌ی عمر یک واحد بالا می‌رود؛ همان مقدار روی
// ردیف واسط (InventoryLineSerial.serialStep) هم ذخیره می‌شود تا فقط «آخرین رویداد» قابل برگشت باشد.
model Serial {
  id              Int                    @id @default(autoincrement())
  goodsItemId     Int
  serialNumber    String
  batch           String?
  expiryDate      DateTime?              @db.Date
  status          SerialStatus           @default(DEFINED)
  step            Int                    @default(1)
  description     String?
  isActive        Boolean                @default(true)
  hasTransactions Boolean                @default(false)
  createdAt       DateTime               @default(now())
  goodsItem       GoodsItem              @relation(fields: [goodsItemId], references: [id])
  lines           InventoryLineSerial[]

  @@unique([goodsItemId, serialNumber])
}

enum SerialStatus {
  DEFINED
  RECEIVED
  EXITED
}

enum BatchSourceType {
  MANUAL
  PURCHASE
  PRODUCTION
}

// طبق «اصلاح مدل رهگیری کالا»: هر کالا دقیقا یکی از این سه روش را دارد (نه ترکیب مستقل چند تیک) —
// None یعنی بدون رهگیری بچ/سریال؛ Batch یعنی موجودی بر اساس بچ تفکیک می‌شود؛ Serial یعنی هر واحد
// کالا یک سریال مستقل دارد (که بچ/تاریخ‌انقضا هم از طریق خود همان سریال مشخص می‌شود، نه مستقل).
enum GoodsTrackingMethod {
  NONE
  BATCH
  SERIAL
}

model AccountingGroup {
  id              Int                             @id @default(autoincrement())
  code            Int                             @unique
  title           String                          @unique
  goodsType       GoodsType
  isActive        Boolean                         @default(true)
  hasTransactions Boolean                         @default(false)
  createdAt       DateTime                        @default(now())
  items           GoodsItem[]
  settings        GoodsServiceAccountingSetting[]
}

// طبق تصمیم صریح کاربر: برای accountType های SALES_RECEIVABLE/PURCHASE_PAYABLE، «گروه حسابداری» کاملاً
// حذف شده — این دو نوع حساب فقط بر اساس نوع فروش/نوع خرید (نه گروه حسابداری) تفکیک می‌شوند، پس
// accountingGroupId برای این دو نوع همیشه null است (فقط برای بقیه‌ی انواع حساب پر می‌شود).
model GoodsServiceAccountingSetting {
  id                  Int              @id @default(autoincrement())
  accountingGroupId   Int?
  accountType         GoodsAccountType
  warehouseGroupId    Int?
  accountId           Int
  salesTypeId         Int?
  warehouseDocType    InventoryDocumentType?
  purchaseTypeId      Int?
  /// فقط برای accountType=SERVICE_PURCHASE (نوع «خرید خدمت»): خدمتی که این معین برایش تعریف شده (فقط خدمت با نحوه حسابداری «هزینه»)
  serviceId           Int?
  hasTransactions     Boolean          @default(false)
  createdAt           DateTime         @default(now())
  service             GoodsItem?       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  account             Account          @relation(fields: [accountId], references: [id])
  accountingGroup     AccountingGroup? @relation(fields: [accountingGroupId], references: [id])
  warehouseGroup      WarehouseGroup?  @relation(fields: [warehouseGroupId], references: [id])
  purchaseType        PurchaseType?    @relation(fields: [purchaseTypeId], references: [id])
  salesType           SalesType?       @relation(fields: [salesTypeId], references: [id])
}

model GoodsRequestType {
  id              Int                @id @default(autoincrement())
  code            Int                @unique
  title           String             @unique
  nature          GoodsRequestNature @default(CENTER_REQUEST)
  hasTransactions Boolean            @default(false)
  createdAt       DateTime           @default(now())
  goodsRequests   GoodsRequest[]
}

model InitialInventory {
  id             Int                      @id @default(autoincrement())
  warehouseId    Int
  fiscalPeriodId Int
  number         Int
  date           DateTime                 @db.Date
  description    String?
