model GoodsAttribute {
  id              Int                       @id @default(autoincrement())
  code            Int                       @unique
  title           String                    @unique
  itemCodeLength  Int
  hasTransactions Boolean                   @default(false)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @default(now()) @updatedAt
  items           GoodsAttributeItem[]
  groupLinks      GoodsGroupAttribute[]
  itemValues      GoodsItemAttributeValue[]
}

