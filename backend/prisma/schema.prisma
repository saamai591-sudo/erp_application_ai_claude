  status         WarehouseDocStatus       @default(REGISTERED)
  finalizedAt    DateTime?
  createdAt      DateTime                 @default(now())
  fiscalPeriod   FiscalPeriod             @relation(fields: [fiscalPeriodId], references: [id])
  warehouse      Warehouse                @relation(fields: [warehouseId], references: [id])
  lines          InitialInventoryLine[]

  @@unique([warehouseId, fiscalPeriodId])
  @@unique([fiscalPeriodId, number])
}

model InitialInventoryLine {
  id                 Int              @id @default(autoincrement())
  initialInventoryId Int
  goodsItemId        Int
  unitId             Int
  quantity           Decimal          @db.Decimal(36, 10)
  unitCost           Decimal          @default(0) @db.Decimal(28, 10)
  amount             Decimal          @default(0) @db.Decimal(18, 2)
  rowOrder           Int              @default(0)
  batchNumber        String?
  expiryDate         DateTime?        @db.Date
  physicalLocation   String?
  serialNumber       String?
  goodsItem          GoodsItem        @relation(fields: [goodsItemId], references: [id])
  initialInventory   InitialInventory @relation(fields: [initialInventoryId], references: [id], onDelete: Cascade)
  unit               UnitOfMeasure    @relation(fields: [unitId], references: [id])
}

model Project {
  id                Int                @id @default(autoincrement())
  detailCode        String             @unique
  title             String             @unique
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  goodsRequestLines GoodsRequestLine[]
  warehouseIssues   WarehouseIssue[]
}

model GoodsRequest {
  id             Int                @id @default(autoincrement())
  fiscalPeriodId Int
  number         Int
  date           DateTime           @db.Date
  requestTypeId  Int
  orgUnitId      Int
  description    String?
  status         RequestStatus      @default(DRAFT)
  reviewerId     Int?
  reviewedAt     DateTime?
  approverId     Int?
  approvedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt
  approver       User?              @relation("GoodsRequestApprover", fields: [approverId], references: [id])
  fiscalPeriod   FiscalPeriod       @relation(fields: [fiscalPeriodId], references: [id])
  orgUnit        OrgUnit            @relation(fields: [orgUnitId], references: [id])
  requestType    GoodsRequestType   @relation(fields: [requestTypeId], references: [id])
  reviewer       User?              @relation("GoodsRequestReviewer", fields: [reviewerId], references: [id])
