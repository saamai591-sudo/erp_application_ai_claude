  feeAmount          Decimal               @default(0) @db.Decimal(18, 2)
  description        String?
  bankAccount        BankAccount?          @relation("PaymentInstrumentBankAccount", fields: [bankAccountId], references: [id])
  cashBox            CashBox?              @relation(fields: [cashBoxId], references: [id])
  chequeBankBranch   BankBranch?           @relation("PaymentInstrumentChequeBankBranch", fields: [chequeBankBranchId], references: [id])
  chequeItem         ChequeItem?           @relation(fields: [chequeItemId], references: [id])
  chequeBookLeaf     ChequeBookLeaf?       @relation(fields: [chequeBookLeafId], references: [id])
  currency           Currency              @relation(fields: [currencyId], references: [id])
  payableChequeType  PayableChequeType?    @relation(fields: [payableChequeTypeId], references: [id])
  payment            Payment               @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  settlementLines    PaymentSettlementLine[]
}

// هم‌الگوی ReceiptSettlementLine («موضوعات پرداخت»): هر ردیف به یک PaymentType، یک ردیف ابزار (قلم)، یک طرف حساب
// مستقل، و (بسته به PaymentType.basisType) دقیقاً یکی از اسناد مبنا وصل می‌شود. exchangeGainLoss با علامتِ «پرداخت»
