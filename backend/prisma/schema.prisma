  journalEntry           JournalEntry?                  @relation(fields: [journalEntryId], references: [id])
  lines                  PurchaseInvoiceLine[]
  otherCostLines         PurchaseCostLine[]
  receiptSettlementLines ReceiptSettlementLine[]
  pettyCashPayments      PettyCashPayment[]
  pettyCashSummaryLines  PettyCashSummaryLine[]
  advanceAllocations     PurchaseInvoiceAdvanceAllocation[]

  @@unique([fiscalPeriodId, number])
  details                PurchaseInvoiceDetail[]
}

model PurchaseInvoiceLine {
  id                    Int                    @id @default(autoincrement())
  purchaseInvoiceId     Int
  rowOrder              Int                    @default(0)
  sourceInventoryLineId Int?                   @unique
  goodsItemId           Int
  unitId                Int
  quantity              Decimal                @db.Decimal(36, 10)
  unitPrice             Decimal                @db.Decimal(36, 10)
  amount                Decimal                @db.Decimal(36, 10)
  discount              Decimal                @default(0) @db.Decimal(36, 10)
  /// amount/discount به ارز مبنا (amount|discount × fxRate هدر / baseVolume ارز فاکتور) — طبق تصمیم
  /// صریح کاربر فقط برای بایگانی/محاسبات (از جمله ارزش‌افزوده که همیشه به ارز مبنا محاسبه می‌شود) نگه
  /// داشته می‌شود؛ در UI نگهداری نمی‌شود و در پاسخ API هم برنمی‌گردد، فقط با هر ذخیره‌ی فاکتور بازمحاسبه
  /// می‌شود.
  baseAmount            Decimal                @db.Decimal(36, 10)
  baseDiscount          Decimal                @default(0) @db.Decimal(36, 10)
  vatAmount             Decimal                @default(0) @db.Decimal(36, 10)
  description           String?
  /// سهم این ردیف از اختلاف تسعیر پیش‌پرداخت خرید (Documents/تخصیص پیش‌پرداخت در فاکتور خرید.md) — فقط وقتی رویه‌ی معتبر در تاریخ فاکتور
  /// «تأثیر بر مبلغ معامله» باشد غیرصفر است؛ طبق تصمیم صریح کاربر به ارز مبناست (نه ارز amount) چون انبار مفهوم ارز ندارد،
  /// سیستمی و غیرنمایشی، با هر تایید/برگشت‌ازتایید فاکتور بازمحاسبه می‌شود.
  exchangeRateAdjustmentShare Decimal          @default(0) @db.Decimal(36, 10)
  /// baseAmount + exchangeRateAdjustmentShare، به ارز مبنا — طبق تصمیم صریح کاربر (نه ارز فاکتور)، چون تنها مصرف این مقدار
  /// قیمت‌گذاری CROSS_ENTITY رسید انبار در تایید فاکتور است و انبار هیچ ارزی جز ارز مبنا نمی‌شناسد؛ سند حسابداری
  /// (issue-journal-entry) وقتی معین موجودی خودش ارزی باشد، این مقدار را برعکس به ارز فاکتور برمی‌گرداند (نگاه کنید به
  /// یادداشت همان‌جا). سیستمی، غیرقابل‌ویرایش توسط کاربر و غیرنمایشی. بدون پیش‌پرداخت تخصیص‌یافته (یا رویه=سود/زیان تسعیر)
  /// همیشه برابر baseAmount است.
  cost                  Decimal                @default(0) @db.Decimal(36, 10)
  goodsItem             GoodsItem              @relation(fields: [goodsItemId], references: [id])
  purchaseInvoice       PurchaseInvoice        @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  sourceInventoryLine   InventoryDocumentLine? @relation("PurchaseInvoiceSourceInventoryLine", fields: [sourceInventoryLineId], references: [id])
  unit                  UnitOfMeasure          @relation(fields: [unitId], references: [id])
  details                PurchaseInvoiceDetail[]
}

// طبق Documents/ServicePurchaseAndItsRelationToStockReceipt.md: مدل تسهیم/اثر تایید این سند («افزودن»
// یک ردیف Difference-only تازه به DocumentItemAmount؛ هر ردیف می‌تواند به رسید(های) دلخواه، نه لزوماً
// رسید(های) همین فاکتور، به‌صورت ۱-به-چند اشاره کند) کاملاً از فاکتور خرید کالا («جایگزینی» مبلغ نهایی
// رسید توسط PurchaseInvoiceLine.sourceInventoryLineId، ۱-به-۱) متفاوت بود — تا این‌که طبق تصمیم صریح
// کاربر، تب «سایر هزینه‌ها»ی فاکتور خرید کالا هم دقیقاً همین مدل/جدول را به اشتراک گرفت (نگاه کنید به
// PurchaseCostLine زیر)؛ دیگر دو مدل موازی مشابه (PurchaseInvoiceOtherCostLine سابق) وجود ندارد.
model ServicePurchaseInvoice {
  id                  Int                          @id @default(autoincrement())
  fiscalPeriodId      Int
  number              Int
  date                DateTime                     @db.Date
  vendorInvoiceNumber String?
  partyId             Int
  purchaseTypeId      Int
  currencyId          Int
  /// نرخ تبدیل ارز فاکتور به ارز مبنا — دقیقاً هم‌الگوی PurchaseInvoice.fxRate (کاربر وارد می‌کند، نه از
  /// جدول نرخ ارز؛ اگر ارز فاکتور همان ارز مبنا باشد همیشه ۱ ذخیره می‌شود).
  fxRate              Decimal                      @default(1) @db.Decimal(18, 6)
  description         String?
  status              RequestStatus                @default(DRAFT)
  approverId          Int?
  approvedAt          DateTime?
  journalEntryId      Int?                         @unique
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @default(now()) @updatedAt
  currency            Currency                     @relation(fields: [currencyId], references: [id])
  fiscalPeriod        FiscalPeriod                 @relation(fields: [fiscalPeriodId], references: [id])
  party               Party                        @relation(fields: [partyId], references: [id])
  purchaseType        PurchaseType                 @relation(fields: [purchaseTypeId], references: [id])
  approver            User?                        @relation("ServicePurchaseInvoiceApprover", fields: [approverId], references: [id])
  journalEntry        JournalEntry?                @relation(fields: [journalEntryId], references: [id])
  lines               PurchaseCostLine[]
  advanceAllocations  ServicePurchaseInvoiceAdvanceAllocation[]
  paymentSettlementLines PaymentSettlementLine[]
  pettyCashPayments   PettyCashPayment[]
  pettyCashSummaryLines PettyCashSummaryLine[]

  @@unique([fiscalPeriodId, number])
  details                ServicePurchaseInvoiceDetail[]
}

// جدول مشترک «ردیف هزینه» بین دو سند: تب «سایر هزینه‌ها»ی فاکتور خرید کالا (purchaseInvoiceId) و ردیف‌های
// فاکتور خرید خدمات (servicePurchaseInvoiceId) — طبق تصمیم صریح کاربر، دقیقاً یکی از این دو FK پر
// می‌شود (هرگز هر دو، هرگز هیچ‌کدام)؛ تضمین آن کاملاً روی nested-create هر روت تکیه دارد (هر روت فقط
// FK والد خودش را ست می‌کند)، نه یک CHECK level دیتابیس. باقی رفتار دقیقاً هم‌الگوی قبلی
// ServicePurchaseInvoiceLine (نگاه کنید به Documents/ServicePurchaseAndItsRelationToStockReceipt.md):
// بدون مبنا / رسید انبار؛ رسید انبار انتخاب‌شده کاملاً دلخواه است (نه لزوماً رسید سند والد)؛ تسهیم
// (allocations زیر) بین ردیف‌های همان رسید.
model PurchaseCostLine {
  id                       Int                     @id @default(autoincrement())
  purchaseInvoiceId        Int?
  servicePurchaseInvoiceId Int?
  rowOrder                 Int                     @default(0)
  serviceId                Int
  amount                   Decimal                 @db.Decimal(36, 10)
  discount                 Decimal                 @default(0) @db.Decimal(36, 10)
  /// amount/discount به ارز مبنا — دقیقاً هم‌الگوی PurchaseInvoiceLine.baseAmount/baseDiscount: فقط برای
  /// بایگانی/محاسبات (از جمله ارزش‌افزوده) نگه داشته می‌شود، در UI/پاسخ API نمی‌آید، با هر ذخیره بازمحاسبه می‌شود.
  baseAmount               Decimal                 @db.Decimal(36, 10)
  baseDiscount             Decimal                 @default(0) @db.Decimal(36, 10)
  vatAmount                Decimal                 @default(0) @db.Decimal(36, 10)
  // بدون مبنا / رسید انبار — طبق بند ۲ مستند، ساختار باید امکان افزودن مبناهای دیگر (مثل قرارداد) را در
  // آینده بدهد؛ چون این enum از قبل دقیقاً همین دو مقدار را دارد، دوباره استفاده شده (نه enum تازه).
  basis                    PurchaseInvoiceBasis    @default(NO_BASIS)
  // فقط وقتی basis=WAREHOUSE_RECEIPT پر می‌شود — رسید انبار انتخاب‌شده (سرصفحه، نه یک ردیف خاص)؛ تسهیم
  // بین همه‌ی ردیف‌های همین رسید انجام می‌شود (نگاه کنید به allocations زیر)
  sourceReceiptDocumentId  Int?
  // فقط وقتی basis=WAREHOUSE_RECEIPT پر می‌شود — نسبت مبلغ (VALUE) یا نسبت مقدار (QUANTITY)؛ WEIGHT این
  // enum برای این فرم معنا/کاربرد ندارد (کنترل در لایه‌ی اعتبارسنجی، نه دیتابیس)
  allocationMethod         CostAllocationBasis?
  description              String?
  purchaseInvoice          PurchaseInvoice?        @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  servicePurchaseInvoice   ServicePurchaseInvoice? @relation(fields: [servicePurchaseInvoiceId], references: [id], onDelete: Cascade)
  service                  GoodsItem               @relation(fields: [serviceId], references: [id])
  sourceReceiptDocument    InventoryDocument?      @relation(fields: [sourceReceiptDocumentId], references: [id])
  allocations              PurchaseCostAllocation[]
  details                  ServicePurchaseInvoiceDetail[]
  purchaseInvoiceDetails   PurchaseInvoiceDetail[]
}

// لایه‌ی «Allocation» که مستند صریحاً بین ردیف فاکتور خرید خدمات و AmountLine خواسته (بند ۱۲): هر رکورد
// یعنی «از مبلغ این ردیف هزینه، این‌قدر به این ردیف رسید تخصیص یافته». با تایید فاکتور (هرکدام از دو
// سند بالا)، به‌ازای هر ردیف اینجا دقیقاً یک DocumentItemAmount (priceType=INBOUND_RELATED_COST) ساخته
// می‌شود.
model PurchaseCostAllocation {
  id                      Int                   @id @default(autoincrement())
  purchaseCostLineId      Int
  inventoryDocumentLineId Int
  allocatedAmount         Decimal               @db.Decimal(36, 10)
  purchaseCostLine        PurchaseCostLine      @relation(fields: [purchaseCostLineId], references: [id], onDelete: Cascade)
  inventoryDocumentLine   InventoryDocumentLine @relation(fields: [inventoryDocumentLineId], references: [id])
  amounts                 DocumentItemAmount[]

  @@unique([purchaseCostLineId, inventoryDocumentLineId])
}

model Customer {
  id              Int            @id @default(autoincrement())
  code            Int            @unique
  partyId         Int            @unique
  isActive        Boolean        @default(true)
  hasTransactions Boolean        @default(false)
  createdAt       DateTime       @default(now())
  party           Party          @relation(fields: [partyId], references: [id])
  salesInvoices   SalesInvoice[]
  salesReturnInvoices SalesReturnInvoice[]
  salesOrders     SalesOrder[]
  salesQuotes     SalesQuote[]
}

model SalesQuote {
  id             Int              @id @default(autoincrement())
  fiscalPeriodId Int
  number         Int
  date           DateTime         @db.Date
  /// تاریخ اعتبار پیش‌فاکتور (اختیاری؛ نباید قبل از تاریخ پیش‌فاکتور باشد)
  validUntil     DateTime?        @db.Date
  customerId     Int
  salesTypeId    Int
  salesCenterId  Int
  currencyId     Int
  description    String?
  status         SalesDocStatus   @default(DRAFT)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
  currency       Currency         @relation(fields: [currencyId], references: [id])
  customer       Customer         @relation(fields: [customerId], references: [id])
  salesType      SalesType        @relation(fields: [salesTypeId], references: [id])
  salesCenter    SalesCenter      @relation(fields: [salesCenterId], references: [id])
  fiscalPeriod   FiscalPeriod     @relation(fields: [fiscalPeriodId], references: [id])
  lines          SalesQuoteLine[]
  receiptSettlementLines ReceiptSettlementLine[]
  /// «بستن پیگیری»: مانده‌ی پیش‌فاکتورِ تأییدشده که دیگر دنبال نمی‌شود (منصرف شد/فروش نشد). مقدار بسته‌شده‌ی هر ردیف در SalesQuoteLine.closedQuantity و جمع مبلغ/ارزش‌افزوده‌ی آن (به ارز پیش‌فاکتور) همین‌جا در لحظه‌ی بستن فریز می‌شود
  followUpClosedAt       DateTime?
  followUpClosedById     Int?
  followUpReasonId       Int?
  followUpNote           String?
  closedRemainingAmount  Decimal?          @db.Decimal(36, 10)
  closedRemainingVat     Decimal?          @db.Decimal(36, 10)
  followUpClosedBy       User?             @relation("SalesQuoteFollowUpClosedBy", fields: [followUpClosedById], references: [id], onDelete: SetNull)
  followUpReason         SalesQuoteLostReason? @relation(fields: [followUpReasonId], references: [id], onDelete: Restrict)

  @@unique([fiscalPeriodId, number])
}

/// دلایل «فروش نشد» برای بستن پیگیری پیش‌فاکتور (قیمت بالا، رقیب، بودجه نداشت، …)
model SalesQuoteLostReason {
  id        Int          @id @default(autoincrement())
  title     String       @unique
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  quotes    SalesQuote[]
}

model SalesQuoteLine {
  id              Int              @id @default(autoincrement())
  salesQuoteId    Int
  rowOrder        Int              @default(0)
  goodsItemId     Int
  unitId          Int
  quantity        Decimal          @db.Decimal(36, 10)
  unitPrice       Decimal          @db.Decimal(36, 10)
  amount          Decimal          @db.Decimal(36, 10)
  /// تخفیف ردیف (مبلغی، به ارز هدر)؛ فاکتور فروشِ مبتنی بر این ردیف تخفیف را با همان فرمول «مانده بر مانده»ی مبلغ از آن می‌گیرد
  discount        Decimal          @default(0) @db.Decimal(36, 10)
  /// مالیات بر ارزش‌افزوده‌ی این ردیف — طبق تصمیم صریح کاربر، برخلاف فاکتور خرید/فاکتور فروش (که همیشه
  /// به ارز مبنا محاسبه می‌شود)، اینجا همیشه به همان ارز هدر (amount) محاسبه/ذخیره می‌شود، چون
  /// پیش‌فاکتور اصلاً fxRate/تبدیل‌ارز ندارد (سندی صرفاً اطلاعاتی، بدون اثر حسابداری).
  vatAmount       Decimal          @default(0) @db.Decimal(36, 10)
  description     String?
  /// منبع فی نهایی (unitPrice): LIST = دقیقاً قیمت پایه‌ی اعلامیه، RULE = قیمت پس از قاعده‌ی پله‌ای، MANUAL = کاربر عوض کرده یا قیمتی در اعلامیه نبوده
  priceSource     SalesQuotePriceSource @default(MANUAL)
  /// قیمت پایه‌ی اعلامیه (فریز در لحظه‌ی ثبت)
  basePrice       Decimal?         @db.Decimal(36, 10)
  /// قیمت سیستم پس از اعمال قاعده؛ فی نهایی (unitPrice) ممکن است با آن فرق کند (فی دستی)
  listPrice       Decimal?         @db.Decimal(36, 10)
  priceListId     Int?
  priceRuleId     Int?
  priceList       SalesPriceList?  @relation(fields: [priceListId], references: [id], onDelete: Restrict)
  priceRule       SalesPriceRule?  @relation(fields: [priceRuleId], references: [id], onDelete: Restrict)
  /// مقدارِ بسته‌شده (پیگیری‌نشونده) این ردیف؛ از «مانده»ی ردیف کم می‌شود. صفر = باز
  closedQuantity  Decimal          @default(0) @db.Decimal(36, 10)
  salesOrderLines SalesOrderLine[] @relation("SalesOrderSourceSalesQuoteLine")
  salesInvoiceLines SalesInvoiceLine[] @relation("SalesInvoiceSourceSalesQuoteLine")
  inventoryLines  InventoryDocumentLine[] @relation("InventoryLineSourceSalesQuoteLine")
  goodsItem       GoodsItem        @relation(fields: [goodsItemId], references: [id])
  salesQuote      SalesQuote       @relation(fields: [salesQuoteId], references: [id], onDelete: Cascade)
  unit            UnitOfMeasure    @relation(fields: [unitId], references: [id])
}

enum SalesPriceRuleEffect {
  ABSOLUTE
  PERCENT
}

enum SalesQuotePriceSource {
  MANUAL
  LIST
  RULE
}

/// اعلامیه قیمت فروش: ارز + تاریخ اجرا + مجموعه‌ی (مرکز فروش × نوع فروش)؛ تغییر با اعلامیه‌ی جدید و بعد از اولین استفاده قفل است
model SalesPriceList {
  id            Int      @id @default(autoincrement())
  number        Int      @unique
  title         String
  currencyId    Int
  effectiveDate DateTime @db.Date
  isActive      Boolean  @default(true)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  currency      Currency @relation(fields: [currencyId], references: [id])
  scopes        SalesPriceListScope[]
  lines         SalesPriceListLine[]
  rules         SalesPriceRule[]
  quoteLines    SalesQuoteLine[]
}

model SalesPriceListScope {
  id            Int      @id @default(autoincrement())
  priceListId   Int
  salesCenterId Int
  salesTypeId   Int
  /// کپی ارز و تاریخ اجرای اعلامیه، فقط برای یکتایی در دیتابیس (هر ترکیب مرکز×نوع×ارز×تاریخ فقط یک اعلامیه)
  currencyId    Int
  effectiveDate DateTime @db.Date
  priceList     SalesPriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  salesCenter   SalesCenter    @relation(fields: [salesCenterId], references: [id])
  salesType     SalesType      @relation(fields: [salesTypeId], references: [id])

  @@unique([priceListId, salesCenterId, salesTypeId])
  @@unique([salesCenterId, salesTypeId, currencyId, effectiveDate])
  @@index([salesCenterId, salesTypeId, effectiveDate])
}

model SalesPriceListLine {
  id          Int      @id @default(autoincrement())
  priceListId Int
  goodsItemId Int
  /// فی پایه به ازای واحد اصلی کالا
  price       Decimal  @db.Decimal(36, 10)
  priceList   SalesPriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  goodsItem   GoodsItem      @relation(fields: [goodsItemId], references: [id])

  @@unique([priceListId, goodsItemId])
  @@index([goodsItemId])
}

/// پله‌ی مقدار: برای مقدار ردیف ≥ minQuantity، فی = value (ABSOLUTE) یا فی پایه × (۱ + value/100) (PERCENT؛ منفی = کاهش)
model SalesPriceRule {
  id          Int      @id @default(autoincrement())
  priceListId Int
  goodsItemId Int
  minQuantity Decimal  @db.Decimal(36, 10)
  effect      SalesPriceRuleEffect
  value       Decimal  @db.Decimal(36, 10)
  priceList   SalesPriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  goodsItem   GoodsItem      @relation(fields: [goodsItemId], references: [id])
  quoteLines  SalesQuoteLine[]

  @@unique([priceListId, goodsItemId, minQuantity])
  @@index([goodsItemId])
}

model SalesOrder {
  id             Int              @id @default(autoincrement())
  fiscalPeriodId Int
  number         Int
  date           DateTime         @db.Date
  basis          SalesOrderBasis
  customerId     Int
  salesTypeId    Int
  salesCenterId  Int
  currencyId     Int
  description    String?
  status         SalesDocStatus   @default(DRAFT)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
  currency       Currency         @relation(fields: [currencyId], references: [id])
  customer       Customer         @relation(fields: [customerId], references: [id])
  salesType      SalesType        @relation(fields: [salesTypeId], references: [id])
  salesCenter    SalesCenter      @relation(fields: [salesCenterId], references: [id])
  fiscalPeriod   FiscalPeriod     @relation(fields: [fiscalPeriodId], references: [id])
  lines          SalesOrderLine[]
  receiptSettlementLines ReceiptSettlementLine[]

  @@unique([fiscalPeriodId, number])
}

model SalesOrderLine {
  id                     Int                     @id @default(autoincrement())
  salesOrderId           Int
  rowOrder               Int                     @default(0)
  sourceSalesQuoteLineId Int?
  goodsItemId            Int
  unitId                 Int
  quantity               Decimal                 @db.Decimal(36, 10)
  unitPrice              Decimal                 @db.Decimal(36, 10)
  amount                 Decimal                 @db.Decimal(36, 10)
  /// تخفیف ردیف (مبلغی، به ارز هدر)؛ هم‌الگوی SalesQuoteLine.discount
  discount               Decimal                 @default(0) @db.Decimal(36, 10)
  /// طبق تصمیم صریح کاربر، هم‌الگوی SalesQuoteLine.vatAmount: همیشه به همان ارز هدر محاسبه/ذخیره
  /// می‌شود، نه ارز مبنا — این فرم هم fxRate ندارد.
  vatAmount              Decimal                 @default(0) @db.Decimal(36, 10)
  description            String?
  salesDeliveryLines     SalesDeliveryLine[]     @relation("SalesDeliverySourceSalesOrderLine")
  salesInvoiceLines      SalesInvoiceLine[]      @relation("SalesInvoiceSourceSalesOrderLine")
  goodsItem              GoodsItem               @relation(fields: [goodsItemId], references: [id])
  salesOrder             SalesOrder              @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  sourceSalesQuoteLine   SalesQuoteLine?         @relation("SalesOrderSourceSalesQuoteLine", fields: [sourceSalesQuoteLineId], references: [id])
  unit                   UnitOfMeasure           @relation(fields: [unitId], references: [id])
  inventoryLines         InventoryDocumentLine[] @relation("InventoryLineSourceSalesOrderLine")
}

model SalesDelivery {
  id             Int                 @id @default(autoincrement())
  warehouseId    Int
  fiscalPeriodId Int
  number         Int
  date           DateTime            @db.Date
  basis          SalesDeliveryBasis
  description    String?
  status         WarehouseDocStatus  @default(REGISTERED)
  finalizedAt    DateTime?
  createdAt      DateTime            @default(now())
  fiscalPeriod   FiscalPeriod        @relation(fields: [fiscalPeriodId], references: [id])
  warehouse      Warehouse           @relation(fields: [warehouseId], references: [id])
  lines          SalesDeliveryLine[]

  @@unique([fiscalPeriodId, number])
}

model SalesDeliveryLine {
  id                     Int             @id @default(autoincrement())
  salesDeliveryId        Int
  rowOrder               Int             @default(0)
  sourceSalesOrderLineId Int?
  goodsItemId            Int
  unitId                 Int
  quantity               Decimal         @db.Decimal(36, 10)
  unitCost               Decimal         @default(0) @db.Decimal(28, 10)
  amount                 Decimal         @default(0) @db.Decimal(18, 2)
  description            String?
  goodsItem              GoodsItem       @relation(fields: [goodsItemId], references: [id])
  salesDelivery          SalesDelivery   @relation(fields: [salesDeliveryId], references: [id], onDelete: Cascade)
  sourceSalesOrderLine   SalesOrderLine? @relation("SalesDeliverySourceSalesOrderLine", fields: [sourceSalesOrderLineId], references: [id])
  unit                   UnitOfMeasure   @relation(fields: [unitId], references: [id])
}

// =========================================================================
// stockAnalysis.md — شمای یکپارچه‌ی اسناد انبار (فاز ۲، بخش افزایشی/additive)
// طبق تصمیم صریح کاربر: بجای ۶ جدول جداگانه‌ی سند انبار (بالا)، این دو مدل یک جدول واحد برای همه‌ی
// انواع سند انبار می‌سازند (بند ۲۸-۲۹ و ۶۴ سند). این فاز فقط اسکیمای جدید را اضافه می‌کند — جدول‌های
// قدیمی (WarehouseReceipt/Issue/Transfer/Adjustment/InitialInventory/SalesDeliveryLine) دست‌نخورده
// باقی مانده‌اند اما همه‌ی route/serviceهای فعلی از فاز ۲ به بعد از InventoryDocument می‌خوانند/
// می‌نویسند؛ جدول‌های قدیمی همیشه خالی و بلااستفاده‌اند (کد فقط برای جلوگیری از حذف مخرب نگه داشته
// شده). اتصال دوطرفه‌ی purchaseInvoiceLine/salesInvoiceLines که قبلاً روی WarehouseReceiptLine/
// SalesDeliveryLine بود، در فاز پیگیری «رفع خلأ شناخته‌شده» به همین دو فیلد پایین (روی
// InventoryDocumentLine) منتقل شد.
// =========================================================================

// طبق stockAnalysis.md بند ۳۴ («انواع عملیات انبار») — لیست کامل و مرجع. WAREHOUSE_ISSUE عمومی قدیم
// (فاز ۲) با سه نوع اختصاصی‌تر مصرف (CENTER/PROJECT/PRODUCTION_CONSUMPTION) جایگزین شده چون بند ۳۴
// اصلاً چنین نوع عمومی‌ای را نمی‌شناسد؛ WAREHOUSE_ADJUSTMENT (که Inventory Count Surplus/Shortage بند
// ۳۴ را با یک مقدار امضادار در یک نوع واحد پوشش می‌دهد) از فاز ۲ بدون تغییر مانده چون بند ۴۵ صریحاً
// می‌گوید «نوع مستقلی به نام Manual Adjustment ایجاد نمی‌شود» و تفکیک آن به دو نوع جدا فایده‌ی
// رفتاری‌ای اضافه نمی‌کرد.
enum InventoryDocumentType {
  INITIAL_INVENTORY
  WAREHOUSE_RECEIPT // Purchase Receipt
  WAREHOUSE_TRANSFER_OUT // Warehouse Transfer — sending side (deducts source warehouse)
  WAREHOUSE_TRANSFER_IN // Warehouse Transfer — receiving side (adds to destination warehouse), references WAREHOUSE_TRANSFER_OUT lines
  WAREHOUSE_ADJUSTMENT // Inventory Count Surplus (فقط مازاد — کسری در INVENTORY_COUNTING_SHORTAGE ثبت می‌شود)
  INVENTORY_COUNTING_SHORTAGE // Inventory Count Shortage — سند مستقل، بدون مبنا، بدون تایید حسابداری فردی (فقط تایید انبار دسته‌ای)
  SALES_DELIVERY // Sales Issue
  SALES_RETURN
  SUPPLIER_RETURN
  PRODUCTION_RECEIPT
  CENTER_CONSUMPTION
  PROJECT_CONSUMPTION
  PRODUCTION_CONSUMPTION
  CENTER_CONSUMPTION_RETURN
  PROJECT_CONSUMPTION_RETURN
  PRODUCTION_CONSUMPTION_RETURN
  FIXED_ASSET_ISSUE
}

// اجتماع WarehouseReceiptBasis + WarehouseIssueBasis + SalesDeliveryBasis — هر documentType فقط
// زیرمجموعه‌ی مربوط به خودش را معنادار می‌داند (کنترل در سطح اپلیکیشن، نه دیتابیس)
enum InventoryBasis {
  NO_BASIS
  SUPPLY_REQUEST
  PURCHASE_ORDER
  DELIVERY_AUTHORIZATION
  GOODS_REQUEST
  SALES_ORDER
  // حواله فروش بر مبنای پیش‌فاکتور (ردیف‌ها به SalesQuoteLine ارجاع می‌دهند)
  SALES_QUOTE
  WAREHOUSE_TRANSFER_OUT
}

model InventoryDocument {
  id                Int                      @id @default(autoincrement())
  documentType      InventoryDocumentType
  warehouseId       Int?
  sourceWarehouseId Int?
  destWarehouseId   Int?
  fiscalPeriodId    Int
  number            Int
  date              DateTime                 @db.Date
  basis             InventoryBasis?
  // به‌جای سه فیلد جدا (partyId/costCenterId/projectId) که هرکدام به یک جدول متفاوت ارجاع می‌داد، طبق
  // همان الگوی «کد تفصیل» که در JournalEntryLine (detail1Code/…) و DetailCodeUsage از قبل وجود دارد،
  // یک فیلد واحد استفاده می‌شود؛ هر نوع سند همیشه دقیقاً یکی از انواع تفصیل (طرف حساب/مرکز هزینه/پروژه)
  // را ست می‌کند، هرگز بیش از یکی — رزولوشن به موجودیت واقعی از طریق DetailCodeUsage.code انجام می‌شود.
  detailCode        String?
  description       String?
  creationType      WarehouseDocCreationType @default(MANUAL)
  status            WarehouseDocStatus       @default(REGISTERED)
  // فقط وقتی سند واقعاً Finalized می‌شود پر می‌شود (رسید انبار خرید: با «تایید حسابداری»؛ بقیه‌ی انواع:
  // با «تایید انبار» دسته‌ای) — دیگر در لحظه‌ی ایجاد سند پر نمی‌شود.
  finalizedAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @default(now()) @updatedAt
  warehouse         Warehouse?               @relation("InventoryDocWarehouse", fields: [warehouseId], references: [id])
  sourceWarehouse   Warehouse?               @relation("InventoryDocSourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destWarehouse     Warehouse?               @relation("InventoryDocDestWarehouse", fields: [destWarehouseId], references: [id])
  fiscalPeriod      FiscalPeriod             @relation(fields: [fiscalPeriodId], references: [id])
  lines             InventoryDocumentLine[]
  purchaseCostLines PurchaseCostLine[]
  quantityClose     WarehouseQuantityClose?

  @@unique([documentType, fiscalPeriodId, number])
  details           InventoryDocumentDetail[]
}

model InventoryDocumentLine {
  id                                Int                        @id @default(autoincrement())
  documentId                        Int
  rowOrder                          Int                        @default(0)
  goodsItemId                       Int
  unitId                            Int
  quantity                          Decimal                    @db.Decimal(36, 10)
  description                       String?
  physicalLocationId                Int?
  sourceSupplyRequestLineId         Int?
  sourcePurchaseOrderLineId         Int?
  sourceDeliveryAuthorizationLineId Int?
  sourceGoodsRequestLineId          Int?
  sourceSalesOrderLineId            Int?
  sourceSalesQuoteLineId            Int?
  // طبق بند ۴۰ سند: «هر برگشت باید به خروج/ورود مرتبط خود Reference داشته باشد» + کنترل
  // ReturnedQuantity <= IssuedQuantity — این ۵ فیلد خودارجاع (self-relation روی همین جدول) دقیقاً
  // همان قاعده را برای هر ۵ نوع سند «برگشتی» (Sales Return/Supplier Return/۳ نوع Consumption Return)
  // پیاده می‌کنند؛ بند ۳۴ برای بقیه‌ی انواع چنین ارجاعی نمی‌خواهد.
  sourceSalesDeliveryLineId         Int?
  sourceWarehouseReceiptLineId      Int?
  sourceCenterConsumptionLineId     Int?
  sourceProjectConsumptionLineId    Int?
  sourceProductionConsumptionLineId Int?
  sourceWarehouseTransferOutLineId  Int?
  document                          InventoryDocument          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  goodsItem                         GoodsItem                  @relation(fields: [goodsItemId], references: [id])
  unit                              UnitOfMeasure              @relation(fields: [unitId], references: [id])
  physicalLocation                  PhysicalLocation?          @relation(fields: [physicalLocationId], references: [id])
  sourceSupplyRequestLine           SupplyRequestLine?         @relation("InventoryLineSourceSupplyRequestLine", fields: [sourceSupplyRequestLineId], references: [id])
  sourcePurchaseOrderLine           PurchaseOrderLine?         @relation("InventoryLineSourcePurchaseOrderLine", fields: [sourcePurchaseOrderLineId], references: [id])
  sourceDeliveryAuthorizationLine   DeliveryAuthorizationLine? @relation("InventoryLineSourceDeliveryAuthorizationLine", fields: [sourceDeliveryAuthorizationLineId], references: [id])
  sourceGoodsRequestLine            GoodsRequestLine?          @relation("InventoryLineSourceGoodsRequestLine", fields: [sourceGoodsRequestLineId], references: [id])
  sourceSalesOrderLine              SalesOrderLine?            @relation("InventoryLineSourceSalesOrderLine", fields: [sourceSalesOrderLineId], references: [id])
  sourceSalesQuoteLine              SalesQuoteLine?            @relation("InventoryLineSourceSalesQuoteLine", fields: [sourceSalesQuoteLineId], references: [id])
  sourceSalesDeliveryLine           InventoryDocumentLine?     @relation("InventoryLineSourceSalesDeliveryLine", fields: [sourceSalesDeliveryLineId], references: [id])
  salesReturnLines                  InventoryDocumentLine[]    @relation("InventoryLineSourceSalesDeliveryLine")
  sourceWarehouseReceiptLine        InventoryDocumentLine?     @relation("InventoryLineSourceWarehouseReceiptLine", fields: [sourceWarehouseReceiptLineId], references: [id])
  supplierReturnLines               InventoryDocumentLine[]    @relation("InventoryLineSourceWarehouseReceiptLine")
  sourceCenterConsumptionLine       InventoryDocumentLine?     @relation("InventoryLineSourceCenterConsumptionLine", fields: [sourceCenterConsumptionLineId], references: [id])
  centerConsumptionReturnLines      InventoryDocumentLine[]    @relation("InventoryLineSourceCenterConsumptionLine")
  sourceProjectConsumptionLine      InventoryDocumentLine?     @relation("InventoryLineSourceProjectConsumptionLine", fields: [sourceProjectConsumptionLineId], references: [id])
  projectConsumptionReturnLines     InventoryDocumentLine[]    @relation("InventoryLineSourceProjectConsumptionLine")
  sourceProductionConsumptionLine   InventoryDocumentLine?     @relation("InventoryLineSourceProductionConsumptionLine", fields: [sourceProductionConsumptionLineId], references: [id])
  productionConsumptionReturnLines  InventoryDocumentLine[]    @relation("InventoryLineSourceProductionConsumptionLine")
  // بر خلاف ۵ نوع برگشتی بالا (که پیش‌فرض Prisma یعنی ON DELETE SET NULL دارند)، اینجا عمداً Restrict
  // انتخاب شده: طبق درخواست صریح کاربر، سند «ارسال» که یک سند «دریافت» به آن ارجاع دارد باید کاملاً
  // قفل باشد (نه فقط ارجاع یتیم شود) — کنترل کامل هم در سطح دیتابیس (این FK) و هم در سطح اپلیکیشن
  // (warehouseTransferOut.ts: delete/revert/update) اعمال می‌شود.
  sourceWarehouseTransferOutLine    InventoryDocumentLine?     @relation("InventoryLineSourceWarehouseTransferOutLine", fields: [sourceWarehouseTransferOutLineId], references: [id], onDelete: Restrict)
  transferInLines                   InventoryDocumentLine[]    @relation("InventoryLineSourceWarehouseTransferOutLine")
  serials                           InventoryLineSerial[]
  batches                           InventoryLineBatch[]
  purchaseInvoiceLine               PurchaseInvoiceLine?       @relation("PurchaseInvoiceSourceInventoryLine")
  salesInvoiceLines                 SalesInvoiceLine[]         @relation("SalesInvoiceSourceInventoryLine")
  salesReturnInvoiceLines           SalesReturnInvoiceLine[]   @relation("SalesReturnInvoiceSourceInventoryLine")
  // تاریخچه‌ی append-only مبلغ این ردیف — طبق Documents/WareHouseAmountChanges.md: دیگر هیچ ستون
  // unitCost/amount خامی روی خودِ این جدول نیست؛ مبلغ فعلی = SUM(DocumentItemAmount.difference) و
  // فی واحد = آن مجموع ÷ quantity، همیشه محاسبه‌شده، هرگز ذخیره‌شده — نگاه کنید به
  // services/documentItemAmountService.ts. جایگزین کامل GoodsPricingAdjustment سابق است.
  amounts                            DocumentItemAmount[]
  purchaseCostAllocations            PurchaseCostAllocation[]
  details           InventoryDocumentDetail[]
}

// طبق بند ۱۷-۱۹ سند: یک سطر سند می‌تواند چند سریال داشته باشد (نه یک سطر جدا برای هر سریال). serialStep
// دقیقاً هم‌الگوی chequeStep (نگاه کنید به توضیح بالای Serial.step) — مقدار Serial.step را در لحظه‌ی
// ایجاد همین ارتباط ثبت می‌کند تا فقط «آخرین رویداد» یک سریال قابل برگشت باشد.
model InventoryLineSerial {
  id         Int                   @id @default(autoincrement())
  lineId     Int
  serialId   Int
  serialStep Int
  line       InventoryDocumentLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  serial     Serial                @relation(fields: [serialId], references: [id])

  @@unique([lineId, serialId])
}

// طبق «انتخاب سریال و بچ»: یک سطر سند می‌تواند چند بچ داشته باشد، هرکدام با تعداد اختصاصی خودش
// (جمع quantity این ردیف‌ها باید با مقدار سطر سند برابر باشد) — دقیقاً هم‌الگوی InventoryLineSerial،
// فقط با یک فیلد quantity اضافه؛ جایگزین فیلد اسکالر قبلی InventoryDocumentLine.batchId.
model InventoryLineBatch {
  id       Int                   @id @default(autoincrement())
  lineId   Int
  batchId  Int
  quantity Decimal               @db.Decimal(36, 10)
  line     InventoryDocumentLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  batch    Batch                 @relation(fields: [batchId], references: [id])

  @@unique([lineId, batchId])
}

// «تایید انبار» / «برگشت از تایید» — طبق سند تایید انبار.md: هدف Snapshot گرفتن موجودی تا یک تاریخ و
// جلوگیری از تغییر اسناد آن دوره است، نه غیرفعال‌کردن انبار. طبق تصمیم صریح کاربر، بدون تاریخچه —
// هر انبار دقیقاً یک تاریخ تایید (Warehouse.confirmedDate) و یک Snapshot جاری دارد که با هر تایید/
// برگشت از تایید، جایگزین (نه اضافه) می‌شود.
model WarehouseConfirmationLine {
  id          Int       @id @default(autoincrement())
  warehouseId Int
  goodsItemId Int
  quantity    Decimal   @db.Decimal(36, 10)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  goodsItem   GoodsItem @relation(fields: [goodsItemId], references: [id])

  @@unique([warehouseId, goodsItemId])
}

// «بستن تعدادی موجودی انبار» (عملیات پایان دوره، مدیریت موجودی و انبار) — به‌ازای هر انبار و هر دوره مالی دقیقاً یک
// رکورد؛ وجود آن یعنی «این انبار برای این دوره مالی بسته شده» و یکتایی (warehouseId, fiscalPeriodId) در سطح دیتابیس
// از بستن مجدد (حتی هم‌زمان) جلوگیری می‌کند. closedAt/closedById برای ممیزی است. openingDocumentId = سند «موجودی اول
// دوره»ی سیستمی (creationType=SYSTEM، فقط تعداد، بدون مبلغ) که همان بستن برای دوره‌ی بعد ساخته است.
model WarehouseQuantityClose {
  id                Int                @id @default(autoincrement())
  warehouseId       Int
  fiscalPeriodId    Int
  closedAt          DateTime           @default(now())
  closedById        Int?
  openingDocumentId Int?               @unique
  lineCount         Int                @default(0)
  warehouse         Warehouse          @relation(fields: [warehouseId], references: [id])
  fiscalPeriod      FiscalPeriod       @relation(fields: [fiscalPeriodId], references: [id])
  closedBy          User?              @relation(fields: [closedById], references: [id])
  openingDocument   InventoryDocument? @relation(fields: [openingDocumentId], references: [id], onDelete: SetNull)

  @@unique([warehouseId, fiscalPeriodId])
}

// «بستن حسابداری موجودی» (عملیات پایان دوره، مدیریت موجودی و انبار) — برای کل دوره مالی و همه‌ی انبارهای مشمول یک‌جا؛
// یک رکورد به‌ازای هر دوره مالی (یکتایی fiscalPeriodId، سد نهایی در برابر بستن مجدد/هم‌زمان). وجود این رکورد برای دوره‌ی
// مالی N یعنی «مبلغ سندهای موجودی اول دوره‌ی سیستمی دوره N+1 تعیین شده» و ارزش‌گذاری دوره N+1 مجاز است.
// closedAt/closedById برای ممیزی؛ nextFiscalPeriodId/openingDate همان دوره‌ی بعد و تاریخ اسناد افتتاحیه‌اش هستند
// (موتور قیمت‌گذاری از همین تاریخ به‌عنوان «لنگر» شروع می‌کند، نگاه کنید به services/inventoryAccountingGuards.ts).
model InventoryAccountingClose {
  id                 Int          @id @default(autoincrement())
  fiscalPeriodId     Int          @unique
  nextFiscalPeriodId Int
  openingDate        DateTime     @db.Date
  closedAt           DateTime     @default(now())
  closedById         Int?
  warehouseCount     Int          @default(0)
  lineCount          Int          @default(0)
  totalAmount        Decimal      @default(0) @db.Decimal(36, 10)
  fiscalPeriod       FiscalPeriod @relation("InventoryAccountingCloseYear", fields: [fiscalPeriodId], references: [id])
  nextFiscalPeriod   FiscalPeriod @relation("InventoryAccountingCloseNextYear", fields: [nextFiscalPeriodId], references: [id])
  closedBy           User?        @relation(fields: [closedById], references: [id])
}

enum InventoryAccountingCloseAction {
  CLOSE
  REVERSE
}

// تاریخچه‌ی ممیزی بستن/برگشت بستن حسابداری موجودی (رکورد اصلی با برگشت پاک می‌شود، این لاگ می‌ماند)
model InventoryAccountingCloseLog {
  id             Int                            @id @default(autoincrement())
  fiscalPeriodId Int
  action         InventoryAccountingCloseAction
  at             DateTime                       @default(now())
  userId         Int?
  fiscalPeriod   FiscalPeriod                   @relation(fields: [fiscalPeriodId], references: [id])
  user           User?                          @relation(fields: [userId], references: [id])
}

// طبق مستند «قیمت‌گذاری اسناد انبار» (بند ۱۲): کلید منطقی وضعیت قیمت‌گذاری = ReportingPeriod + Item
// (بدون انبار). وجود این رکورد یعنی «این کالا در این دوره قیمت‌گذاری شده است».
model GoodsPricingStatus {
  id                Int                  @id @default(autoincrement())
  goodsItemId       Int
  reportingPeriodId Int
  pricedAt          DateTime             @default(now())
  createdById       Int?
  goodsItem         GoodsItem            @relation(fields: [goodsItemId], references: [id])
  reportingPeriod   ReportingPeriod      @relation(fields: [reportingPeriodId], references: [id])
  createdBy         User?                @relation(fields: [createdById], references: [id])
  // هر ردیف DocumentItemAmount که موتور قیمت‌گذاری در این اجرا نوشته (priceType=ENGINE_PRICING یا
  // ENGINE_CORRECTION) به همین‌جا وصل است — تنها راهی که revertItem می‌تواند دقیقاً «فقط اثر همین
  // اجرا» را حذف کند، بدون دست‌زدن به رکوردهای اجراهای دیگر یا مقادیر دستی کاربر.
  amounts           DocumentItemAmount[]

  @@unique([goodsItemId, reportingPeriodId])
}

// طبق Documents/WareHouseAmountChanges.md: جایگزین کامل GoodsPricingAdjustment سابق. تاریخچه‌ی
// append-only مبلغ هر ردیف سند انبار (هر ۱۷ نوع، نه فقط ۴ نوع کاربر-قیمت‌گذار) — هرگز رکورد قبلی
// overwrite/silently نمی‌شود؛ هر تغییر مبلغ (چه دستی، چه موتور قیمت‌گذاری، چه اثر جانبی تایید فاکتور
// خرید) یک ردیف تازه اضافه می‌کند. مبلغ فعلی یک ردیف = SUM(difference)، فی واحد = آن مجموع ÷ مقدار —
// نگاه کنید به services/documentItemAmountService.ts (تنها نقطه‌ی نوشتن/خواندن این جدول).
enum DocumentAmountPriceType {
  USER_ENTRY       // مبلغ دستی کاربر (۴ نوع سند کاربر-قیمت‌گذار: موجودی اول دوره/رسید انبار خرید/رسید تولید/اضافات انبارگردانی)
  ENGINE_PRICING   // موتور قیمت‌گذاری (کاردکس میانگین موزون) — ردیف در دوره‌ی هنوز قفل‌نشده
  ENGINE_CORRECTION // موتور قیمت‌گذاری روی ردیفی که قبلاً در دوره‌ای زودتر قفل شده بود (اصلاحیه)
  CROSS_ENTITY     // اثر جانبی تایید/برگشت‌ازتایید فاکتور خرید (ردیف‌های کالای خودِ فاکتور) روی ردیف رسید انبار خرید مرتبط
  // اثر تایید/برگشت‌ازتایید ردیف‌های PurchaseCostLine (سایر هزینه‌های فاکتور خرید کالا + فاکتور خرید
  // خدمات، هر دو) — طبق Documents/ServicePurchaseAndItsRelationToStockReceipt.md، برخلاف CROSS_ENTITY
  // (که مبلغ نهایی رسید را «جایگزین» می‌کند)، این نوع همیشه فقط «افزوده» می‌شود (Difference = مبلغ
  // تخصیص‌یافته، هرگز newAmount محاسبه‌شده‌ی مطلق)
  INBOUND_RELATED_COST
  MIGRATED         // فقط رکورد یک‌بارِ backfill داده‌های قبل از این مدل
  // مبلغ ردیف «موجودی اول دوره»ی سیستمی دوره‌ی بعد که «بستن حسابداری موجودی» از کاردکس پایان دوره‌ی مالی قبل
  // محاسبه و روی همان ردیف موجود ثبت می‌کند؛ «برگشت بستن حسابداری» دقیقاً همین رکوردها را حذف می‌کند.
  ACCOUNTING_CLOSING
}

model DocumentItemAmount {
  id                                     Int                                   @id @default(autoincrement())
  lineId                                 Int
  priceType                              DocumentAmountPriceType
  amount                                 Decimal                               @db.Decimal(18, 2)
  difference                             Decimal                               @db.Decimal(18, 2)
  effectiveDate                          DateTime                              @default(now())
  journalEntryId                         Int?
  // فقط تا وقتی این ردیف داخل فرم «صدور سند حسابداری» (اسناد انبار) ذخیره شده — چه هنوز صادر نشده (پیش‌نویس)
  // چه صادرشده — تا آن فرم بتواند دقیقاً همان ردیف‌های ذخیره‌شده‌ی خودش را (نه یک کوئری تازه) بازیابی/صادر
  // کند؛ با حذف کامل آن پیش‌نویس (قبل از صدور) این فیلد دوباره null می‌شود (SetNull، نه Cascade — طبق
  // Documents/WareHouseAmountChanges.md این جدول append-only است، خودِ ردیف هرگز حذف نمی‌شود).
  warehouseJournalEntryIssuanceId        Int?
  // فقط برای priceType=ENGINE_PRICING/ENGINE_CORRECTION — نگاه کنید به یادداشت amounts روی GoodsPricingStatus
  goodsPricingStatusId                   Int?
  // فقط برای priceType=INBOUND_RELATED_COST — ردیابی به ردیف تخصیص PurchaseCostLine (فاکتور خرید کالا یا
  // فاکتور خرید خدمات) که این رکورد را ایجاد کرده
  purchaseCostAllocationId               Int?
  createdAt                              DateTime                              @default(now())
  createdById                            Int?
  line                                   InventoryDocumentLine                 @relation(fields: [lineId], references: [id], onDelete: Cascade)
  journalEntry                           JournalEntry?                         @relation(fields: [journalEntryId], references: [id])
  warehouseJournalEntryIssuance          WarehouseJournalEntryIssuance?        @relation(fields: [warehouseJournalEntryIssuanceId], references: [id], onDelete: SetNull)
  goodsPricingStatus                     GoodsPricingStatus?                   @relation(fields: [goodsPricingStatusId], references: [id], onDelete: Cascade)
  // onDelete عمداً SetNull است، نه Cascade: این جدول تاریخچه‌ی append-only مبلغ ردیف رسید است (طبق
  // Documents/WareHouseAmountChanges.md) — حذف بعدیِ فاکتور خریدِ ایجادکننده (مجاز فقط در وضعیت «ثبت»،
  // از جمله بعد از یک چرخه‌ی تایید→برگشت‌ازتایید) هرگز نباید رکوردهای این جدول را که به ردیف یک سند
  // کاملاً دیگر (رسید انبار) متعلق‌اند نابود کند؛ فقط ارجاع ردیابی (کدام فاکتور/تخصیص) پاک می‌شود، خودِ
  // Amount/Difference برای همیشه باقی می‌ماند.
  purchaseCostAllocation                 PurchaseCostAllocation?               @relation(fields: [purchaseCostAllocationId], references: [id], onDelete: SetNull)
  createdBy                              User?                                 @relation(fields: [createdById], references: [id])

  @@index([lineId])
  @@index([warehouseJournalEntryIssuanceId])
}

// جدول موقت/کش — نه تاریخچه: طبق تصمیم صریح کاربر، هر بار که «قیمت‌گذاری اسناد انبار» با دکمه‌ی «لود
// اطلاعات» بارگذاری می‌شود، کل این جدول (نه فقط ردیف‌های همین دوره) پاک و دوباره از صفر پر می‌شود —
// نگاشت «این کالا، در این دوره، در کدام انبارها گردش (سند مؤثر در قیمت‌گذاری) داشته». هدف: وقتی کاربر
// ردیف‌ها را انتخاب می‌کند و دکمه‌ی «قیمت‌گذاری» را می‌زند، لایه‌ی اعتبارسنجی (goodsPricingValidation.ts)
// بتواند انبارهای مرتبط با کالاهای انتخاب‌شده را از همین جدول بخواند، بدون کوئری دوباره‌ی
// InventoryDocumentLine. این فقط یک بهینه‌سازی «پیش‌بررسیِ سریع» است؛ تضمین نهایی صحت («آیا واقعاً همه‌ی
// انبارهای مؤثر تایید شده‌اند») همچنان در لحظه‌ی اجرای priceItem/revertItem — با داده‌ی زنده‌ی همان لحظه،
// نه این کش — انجام می‌شود (نگاه کنید به یادداشت‌های goodsPricingService.ts).
model GoodsPricingFlowWarehouse {
  id                Int             @id @default(autoincrement())
  goodsItemId       Int
  reportingPeriodId Int
  warehouseId       Int
  goodsItem         GoodsItem       @relation(fields: [goodsItemId], references: [id], onDelete: Cascade)
  reportingPeriod   ReportingPeriod @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)
  warehouse         Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([goodsItemId, reportingPeriodId, warehouseId])
}

model SalesInvoice {
  paymentSettlementLines PaymentSettlementLine[]
  id                     Int                     @id @default(autoincrement())
  fiscalPeriodId         Int
  number                 Int
  date                   DateTime                @db.Date
  customerId             Int
  salesTypeId            Int
  salesCenterId          Int
  currencyId             Int
  /// نرخ تبدیل ارز فاکتور به ارز مبنا — دقیقاً هم‌الگوی PurchaseInvoice.fxRate (کاربر وارد می‌کند، نه از
  /// جدول نرخ ارز؛ اگر ارز فاکتور همان ارز مبنا باشد همیشه ۱ ذخیره می‌شود).
  fxRate                 Decimal                 @default(1) @db.Decimal(18, 6)
  description            String?
  status                 SalesDocStatus          @default(DRAFT)
  journalEntryId         Int?                    @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @default(now()) @updatedAt
  receiptSettlementLines ReceiptSettlementLine[]
  currency               Currency                @relation(fields: [currencyId], references: [id])
  customer               Customer                @relation(fields: [customerId], references: [id])
  salesType              SalesType               @relation(fields: [salesTypeId], references: [id])
  salesCenter            SalesCenter             @relation(fields: [salesCenterId], references: [id])
  fiscalPeriod           FiscalPeriod            @relation(fields: [fiscalPeriodId], references: [id])
  journalEntry           JournalEntry?           @relation(fields: [journalEntryId], references: [id])
  lines                  SalesInvoiceLine[]
  advanceAllocations     SalesInvoiceAdvanceAllocation[]
  pettyCashPayments      PettyCashPayment[]
  pettyCashSummaryLines  PettyCashSummaryLine[]
  taxInvoices            TaxInvoice[]

  /// الگوی شماره‌گذاری که شماره‌ی این سند را داده (null = شماره‌گذاری قدیمی «آخرین شماره‌ی دوره + ۱»)
  numberingPatternId     Int?
  numberingPattern       NumberingPattern?       @relation(fields: [numberingPatternId], references: [id], map: "SalesInvoice_numberingPatternId_fkey")

  // یکتایی شماره: برای اسناد الگودار در محدوده‌ی (الگو، دوره مالی)؛ برای اسناد بدون الگو یک ایندکس یکتای جزئی در migration (WHERE numberingPatternId IS NULL)
  @@unique([numberingPatternId, fiscalPeriodId, number], map: "SalesInvoice_pattern_period_number_key")
  @@index([fiscalPeriodId, number])
}

model SalesInvoiceLine {
  id                    Int                    @id @default(autoincrement())
  salesInvoiceId        Int
  rowOrder              Int                    @default(0)
  /// «مبنا» در سطح ردیف (تنها منبع حقیقت — هدر فاکتور دیگر مبنا ندارد): بدون مبنا / حواله فروش / سفارش فروش / پیش‌فاکتور.
  /// تعیین می‌کند کدام یک از sourceInventoryLineId / sourceSalesOrderLineId / sourceSalesQuoteLineId پر است (بدون مبنا: هیچ‌کدام).
  basis                 SalesInvoiceLineBasis
  sourceInventoryLineId Int?
  sourceSalesOrderLineId Int?
  sourceSalesQuoteLineId Int?
  goodsItemId           Int
  unitId                Int
  quantity              Decimal                @db.Decimal(36, 10)
  unitPrice             Decimal                @db.Decimal(36, 10)
  amount                Decimal                @db.Decimal(36, 10)
  discount              Decimal                @default(0) @db.Decimal(36, 10)
  /// amount/discount به ارز مبنا — دقیقاً هم‌الگوی PurchaseInvoiceLine.baseAmount/baseDiscount: فقط برای
  /// بایگانی/محاسبات (از جمله ارزش‌افزوده که همیشه به ارز مبنا محاسبه می‌شود) نگه داشته می‌شود؛ در UI
  /// نگهداری نمی‌شود و در پاسخ API هم برنمی‌گردد، با هر ذخیره‌ی فاکتور بازمحاسبه می‌شود.
  baseAmount            Decimal                @db.Decimal(36, 10)
  baseDiscount          Decimal                @default(0) @db.Decimal(36, 10)
  vatAmount             Decimal                @default(0) @db.Decimal(36, 10)
  description           String?
  goodsItem             GoodsItem              @relation(fields: [goodsItemId], references: [id])
  salesInvoice          SalesInvoice           @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  sourceInventoryLine   InventoryDocumentLine? @relation("SalesInvoiceSourceInventoryLine", fields: [sourceInventoryLineId], references: [id])
  sourceSalesOrderLine  SalesOrderLine?        @relation("SalesInvoiceSourceSalesOrderLine", fields: [sourceSalesOrderLineId], references: [id])
  sourceSalesQuoteLine  SalesQuoteLine?        @relation("SalesInvoiceSourceSalesQuoteLine", fields: [sourceSalesQuoteLineId], references: [id])
  unit                  UnitOfMeasure          @relation(fields: [unitId], references: [id])
}

// فاکتور برگشت از فروش — طبق تصمیم صریح کاربر، دقیقاً هم‌ساختار/هم‌رفتار SalesInvoice (پایه/ارز/تخفیف/
// ارزش‌افزوده/عدم وجود اکشن تایید/صدور مستقیم سند حسابداری از DRAFT)، فقط با مبنای «برگشت از فروش»
// (سند انبار SALES_RETURN — نگاه کنید به routes/salesReturns.ts، که طبق تصمیم صریح کاربر در کار دیگری
// دست‌نخورده می‌ماند) به‌جای «حواله فروش». مدل کاملاً مستقل از SalesInvoice است (نه جدول مشترک، برخلاف
// PurchaseCostLine) — عمداً، چون کاربر این‌بار درخواست اشتراک جدول نداده. sourceInventoryLineId دقیقاً
// هم‌الگوی SalesInvoiceLine (nullable، نه @unique — الگوی «مانده»، چون یک ردیف برگشت ممکن است طی چند
// فاکتور برگشت جداگانه صورتحساب شود).
model SalesReturnInvoice {
  id             Int                      @id @default(autoincrement())
  fiscalPeriodId Int
  number         Int
  date           DateTime                 @db.Date
  basis          SalesReturnInvoiceBasis
  customerId     Int
  salesTypeId    Int
  salesCenterId  Int
  currencyId     Int
  /// نرخ تبدیل ارز فاکتور به ارز مبنا — دقیقاً هم‌الگوی SalesInvoice.fxRate.
  fxRate         Decimal                  @default(1) @db.Decimal(18, 6)
  description    String?
  status         SalesDocStatus           @default(DRAFT)
  journalEntryId Int?                     @unique
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @default(now()) @updatedAt
  currency       Currency                 @relation(fields: [currencyId], references: [id])
  customer       Customer                 @relation(fields: [customerId], references: [id])
  salesType      SalesType                @relation(fields: [salesTypeId], references: [id])
  salesCenter    SalesCenter              @relation(fields: [salesCenterId], references: [id])
  fiscalPeriod   FiscalPeriod             @relation(fields: [fiscalPeriodId], references: [id])
  journalEntry   JournalEntry?            @relation(fields: [journalEntryId], references: [id])
  lines          SalesReturnInvoiceLine[]

  /// الگوی شماره‌گذاری که شماره‌ی این سند را داده (null = شماره‌گذاری قدیمی «آخرین شماره‌ی دوره + ۱»)
  numberingPatternId     Int?
  numberingPattern       NumberingPattern?       @relation(fields: [numberingPatternId], references: [id], map: "SalesReturnInvoice_numberingPatternId_fkey")

  // یکتایی شماره: برای اسناد الگودار در محدوده‌ی (الگو، دوره مالی)؛ برای اسناد بدون الگو یک ایندکس یکتای جزئی در migration (WHERE numberingPatternId IS NULL)
  @@unique([numberingPatternId, fiscalPeriodId, number], map: "SalesReturnInvoice_pattern_period_number_key")
  @@index([fiscalPeriodId, number])
}

model SalesReturnInvoiceLine {
  id                    Int                    @id @default(autoincrement())
  salesReturnInvoiceId  Int
  rowOrder              Int                    @default(0)
  sourceInventoryLineId Int?
  goodsItemId           Int
  unitId                Int
  quantity              Decimal                @db.Decimal(36, 10)
  unitPrice             Decimal                @db.Decimal(36, 10)
  amount                Decimal                @db.Decimal(36, 10)
  discount              Decimal                @default(0) @db.Decimal(36, 10)
  /// amount/discount به ارز مبنا — دقیقاً هم‌الگوی SalesInvoiceLine.baseAmount/baseDiscount.
  baseAmount            Decimal                @db.Decimal(36, 10)
  baseDiscount          Decimal                @default(0) @db.Decimal(36, 10)
  vatAmount             Decimal                @default(0) @db.Decimal(36, 10)
  description           String?
  goodsItem             GoodsItem              @relation(fields: [goodsItemId], references: [id])
  salesReturnInvoice    SalesReturnInvoice     @relation(fields: [salesReturnInvoiceId], references: [id], onDelete: Cascade)
  sourceInventoryLine   InventoryDocumentLine? @relation("SalesReturnInvoiceSourceInventoryLine", fields: [sourceInventoryLineId], references: [id])
  unit                  UnitOfMeasure          @relation(fields: [unitId], references: [id])
}

model ChequeItem {
  id                      Int                            @id @default(autoincrement())
  direction               ChequeDirection
  number                  String
  dueDate                 DateTime                       @db.Date
  bankBranchId            Int?
  ownerBankAccountId      Int?
  partyId                 Int
  amount                  Decimal                        @db.Decimal(18, 2)
  currencyId              Int
  status                  ChequeStatus                   @default(IN_HAND)
  // شمارنده‌ی نسخه (فاز ۲.۲): با هر رویداد چرخه‌ی عمر (ایجاد، خرج/ظهرنویسی، واگذاری، برگشت از
  // واگذاری، نتیجه وصول/برگشت) یک واحد بالا می‌رود. همان مقدار روی ردیف سندی که آن رویداد را ایجاد
  // کرده (فیلد chequeStep در ۶ جدول ردیف مرتبط) هم ذخیره می‌شود؛ فقط وقتی chequeStep یک ردیف با
  // step فعلی همین چک برابر باشد، آن ردیف «آخرین اتفاق» برای این چک است و بدون برگشت از تایید کل
  // سند مادر، مستقیماً از همان سند قابل ویرایش/حذف (و افزودن ردیف تازه) است — نگاه کنید به توضیح
  // بالای هرکدام از فایل‌های routes/receipts.ts, payments.ts, chequeDeposits.ts,
  // chequeDepositReturns.ts, chequeClearingReceivable.ts, chequeClearingPayable.ts.
  step                    Int                            @default(1)
  // نوع چک (مستر «نوع چک دریافتی/پرداختی») — برای صدور سند حسابداری خرج‌کردن چک دریافتنی و چک پرداختنی:
  // receivableChequeTypeId از ردیف سند دریافت، payableChequeTypeId از ردیف سند پرداخت کپی می‌شود.
  receivableChequeTypeId  Int?
  payableChequeTypeId     Int?
  description             String?
  createdAt               DateTime                       @default(now())
  bankBranch              BankBranch?                    @relation(fields: [bankBranchId], references: [id])
  receivableChequeType    ReceivableChequeType?          @relation(fields: [receivableChequeTypeId], references: [id])
  payableChequeType       PayableChequeType?             @relation(fields: [payableChequeTypeId], references: [id])
  currency                Currency                       @relation(fields: [currencyId], references: [id])
  ownerBankAccount        BankAccount?                   @relation(fields: [ownerBankAccountId], references: [id])
  party                   Party                          @relation(fields: [partyId], references: [id])
  paymentInstrumentLines  PaymentInstrumentLine[]
  receiptInstrumentLines  ReceiptInstrumentLine[]
  depositLines            ChequeDepositLine[]
  depositReturnLines      ChequeDepositReturnLine[]
  clearingReceivableLines ChequeClearingReceivableLine[]
  clearingPayableLines    ChequeClearingPayableLine[]
  // طبق Documents/افتتاحیه دریافت و پرداخت و بستن سال.md: هر چک متعلق به یک دوره مالی است (فهرست‌ها و انتخابگرهای چک خودکار
  // به دوره مالی جاری محدود می‌شوند). چک‌های افتتاحیه (isOpening) یا دستی در «افتتاحیه دریافت و پرداخت» ثبت شده‌اند یا با
  // «بستن سال دریافت و پرداخت» از چک فعال سال قبل ساخته شده‌اند (parentChequeId → رکورد سال قبل، با همان شماره‌ی چک).
  fiscalPeriodId  Int
  fiscalPeriod    FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id])
  parentChequeId  Int?
  parentCheque    ChequeItem?  @relation("ChequeCarryForward", fields: [parentChequeId], references: [id], onDelete: SetNull)
  childCheques    ChequeItem[] @relation("ChequeCarryForward")
  isOpening       Boolean      @default(false)
  // فقط برای چک‌های افتتاحیه: «نوع دریافت»/«نوع پرداخت» (اختیاری)
  openingReceiptTypeId Int?
  openingPaymentTypeId Int?
  openingReceiptType   ReceiptType? @relation("ChequeOpeningReceiptType", fields: [openingReceiptTypeId], references: [id])
  openingPaymentType   PaymentType? @relation("ChequeOpeningPaymentType", fields: [openingPaymentTypeId], references: [id])
  
  @@index([fiscalPeriodId])
}

model Receipt {
  id              Int                     @id @default(autoincrement())
  fiscalPeriodId  Int
  number          Int
  date            DateTime                @db.Date
  partyId         Int
  description     String?
  status          TreasuryDocStatus       @default(DRAFT)
  journalEntryId  Int?                    @unique
  journalEntry    JournalEntry?           @relation(fields: [journalEntryId], references: [id])
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @default(now()) @updatedAt
  fiscalPeriod    FiscalPeriod            @relation(fields: [fiscalPeriodId], references: [id])
  party           Party                   @relation(fields: [partyId], references: [id])
  instrumentLines ReceiptInstrumentLine[]
  settlementLines ReceiptSettlementLine[]

  @@unique([fiscalPeriodId, number])
  /// «تایید حسابداری»: بعد از آن ردیف‌های حسابداری (پیش‌نویس سند در سطح فرم) ساخته/نمایش داده می‌شود و سند قفل است
  accountingStatus AccountingApprovalStatus @default(NONE)
  accountingApprovedAt DateTime?
  accountingApprovedById Int?
  accountingLines ReceiptAccountingLine[]
}

// طبق Documents/ReceiptChanges.md: ارز و نرخ ارز از هدر سند به هر ردیف اقلام دریافت منتقل شد. نوع
// CASH: کاربر آزادانه ارز را انتخاب می‌کند. BANK_TRANSFER/POS: ارز همیشه از ارز حساب بانکی انتخاب‌شده
// جبراً ست می‌شود (نه فقط پیش‌فرض — کاربر نمی‌تواند تغییر دهد، چون یک حساب بانکی واقعی تک‌ارزی است).
// CHEQUE: همیشه جبراً ارز پایه (چک ارزی در این کدبیس پشتیبانی نمی‌شود). baseAmount محاسبه‌شده و
// نگهداری می‌شود ولی طبق سند در UI نمایش داده نمی‌شود (فقط برای محاسبات آینده مثل صدور سند حسابداری).
model ReceiptInstrumentLine {
  id                 Int                     @id @default(autoincrement())
  receiptId          Int
  rowOrder           Int                     @default(0)
  type               PaymentInstrumentType
  amount             Decimal                 @db.Decimal(18, 2)
  currencyId         Int
  fxRate             Decimal                 @default(1) @db.Decimal(18, 6)
  baseAmount         Decimal                 @db.Decimal(36, 10)
  cashBoxId          Int?
  bankAccountId      Int?
  referenceNumber    String?
  chequeItemId       Int?
  chequeNumber       String?
  chequeDueDate      DateTime?               @db.Date
  chequeBankBranchId Int?
  // نوع چک دریافتی (مستر ReceivableChequeType) — فقط برای ردیف نوع CHEQUE (در API الزامی است)؛ در دیتابیس nullable است چون ردیف‌های قدیمی نوع ندارند.
  chequeTypeId       Int?
  // فقط برای ردیف نوع CHEQUE، در لحظه‌ی تایید سند برابر step همان لحظه‌ی ChequeItem پر می‌شود
  // (نگاه کنید به توضیح بالای ChequeItem.step).
  chequeStep         Int?
  posTerminal        String?
  description        String?
  currency           Currency                @relation(fields: [currencyId], references: [id])
  bankAccount        BankAccount?            @relation("ReceiptInstrumentBankAccount", fields: [bankAccountId], references: [id])
  cashBox            CashBox?                @relation(fields: [cashBoxId], references: [id])
  chequeBankBranch   BankBranch?             @relation("ReceiptInstrumentChequeBankBranch", fields: [chequeBankBranchId], references: [id])
  chequeItem         ChequeItem?             @relation(fields: [chequeItemId], references: [id])
  chequeType         ReceivableChequeType?   @relation(fields: [chequeTypeId], references: [id], onDelete: Restrict)
  receipt            Receipt                 @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  settlementLines    ReceiptSettlementLine[]
  accountingLines    ReceiptAccountingLine[]
}

// طبق Documents/ReceiptChanges.md بخش «موضوعات دریافت»: هر ردیف اکنون به یک ReceiptType (نوع دریافت)،
// یک ردیف اقلام دریافت (قلم — instrumentLineId، منبع پولی این تسویه)، یک طرف حساب مستقل از هدر، و
// (بسته به ReceiptType.basisType) دقیقاً یکی از چهار سند مبنا وصل می‌شود. exchangeGainLoss (تسعیر) —
// برخلاف baseAmount — طبق سند در UI نمایش داده می‌شود، پس نگهداری می‌شود.
model ReceiptSettlementLine {
  id                Int                    @id @default(autoincrement())
  receiptId         Int
  rowOrder          Int                    @default(0)
  receiptTypeId     Int
  instrumentLineId  Int
  partyId           Int
  salesInvoiceId    Int?
  salesOrderId      Int?
  salesQuoteId      Int?
  purchaseInvoiceId Int?
  currencyId        Int
  fxRate            Decimal                @default(1) @db.Decimal(18, 6)
  amount            Decimal                @db.Decimal(18, 2)
  exchangeGainLoss  Decimal                @default(0) @db.Decimal(18, 2)
  description       String?
  receipt           Receipt                @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  receiptType       ReceiptType            @relation(fields: [receiptTypeId], references: [id])
  instrumentLine    ReceiptInstrumentLine  @relation(fields: [instrumentLineId], references: [id])
  party             Party                  @relation(fields: [partyId], references: [id])
  salesInvoice      SalesInvoice?          @relation(fields: [salesInvoiceId], references: [id])
  salesOrder        SalesOrder?            @relation(fields: [salesOrderId], references: [id])
  salesQuote        SalesQuote?            @relation(fields: [salesQuoteId], references: [id])
  purchaseInvoice   PurchaseInvoice?       @relation(fields: [purchaseInvoiceId], references: [id])
