model SalesQuoteLine {
  id              Int              @id @default(autoincrement())
  salesQuoteId    Int
  rowOrder        Int              @default(0)
  goodsItemId     Int
  unitId          Int
  quantity        Decimal          @db.Decimal(36, 10)
  unitPrice       Decimal          @db.Decimal(36, 10)
  amount          Decimal          @db.Decimal(36, 10)
  /// مالیات بر ارزش‌افزوده‌ی این ردیف — طبق تصمیم صریح کاربر، برخلاف فاکتور خرید/فاکتور فروش (که همیشه
  /// به ارز مبنا محاسبه می‌شود)، اینجا همیشه به همان ارز هدر (amount) محاسبه/ذخیره می‌شود، چون
  /// پیش‌فاکتور اصلاً fxRate/تبدیل‌ارز ندارد (سندی صرفاً اطلاعاتی، بدون اثر حسابداری).
  vatAmount       Decimal          @default(0) @db.Decimal(36, 10)
  description     String?
  salesOrderLines SalesOrderLine[] @relation("SalesOrderSourceSalesQuoteLine")
  inventoryLines  InventoryDocumentLine[] @relation("InventoryLineSourceSalesQuoteLine")
  goodsItem       GoodsItem        @relation(fields: [goodsItemId], references: [id])
