// =========================================================================
// stockAnalysis.md — شمای یکپارچه‌ی اسناد انبار (فاز ۲، بخش افزایشی/additive)
// طبق تصمیم صریح کاربر: بجای ۶ جدول جداگانه‌ی سند انبار (بالا)، این دو مدل یک جدول واحد برای همه‌ی
// انواع سند انبار می‌سازند (بند ۲۸-۲۹ و ۶۴ سند). این فاز فقط اسکیمای جدید را اضافه می‌کند — جدول‌های
// قدیمی (WarehouseReceipt/Issue/Transfer/Adjustment/InitialInventory/SalesDeliveryLine) دست‌نخورده
// باقی مانده‌اند اما همه‌ی route/serviceهای فعلی از فاز ۲ به بعد از InventoryDocument می‌خوانند/
// می‌نویسند؛ جدول‌های قدیمی همیشه خالی و بلااستفاده‌اند (کد فقط برای جلوگیری از حذف مخرب نگه داشته
// شده). اتصال دوطرفه‌ی purchaseInvoiceLine/salesInvoiceLines که قبلاً روی WarehouseReceiptLine/
// SalesDeliveryLine بود، در فاز پیگیری «رفع خلأ شناخته‌شده» به همین دو فیلد پایین (روی
// InventoryDocumentLine) منتقل شد.
// =========================================================================

// طبق stockAnalysis.md بند ۳۴ («انواع عملیات انبار») — لیست کامل و مرجع. WAREHOUSE_ISSUE عمومی قدیم
// (فاز ۲) با سه نوع اختصاصی‌تر مصرف (CENTER/PROJECT/PRODUCTION_CONSUMPTION) جایگزین شده چون بند ۳۴
// اصلاً چنین نوع عمومی‌ای را نمی‌شناسد؛ WAREHOUSE_ADJUSTMENT (که Inventory Count Surplus/Shortage بند
// ۳۴ را با یک مقدار امضادار در یک نوع واحد پوشش می‌دهد) از فاز ۲ بدون تغییر مانده چون بند ۴۵ صریحاً
// می‌گوید «نوع مستقلی به نام Manual Adjustment ایجاد نمی‌شود» و تفکیک آن به دو نوع جدا فایده‌ی
// رفتاری‌ای اضافه نمی‌کرد.
enum InventoryDocumentType {
  INITIAL_INVENTORY
  WAREHOUSE_RECEIPT // Purchase Receipt
  WAREHOUSE_TRANSFER // Warehouse Transfer
  WAREHOUSE_ADJUSTMENT // Inventory Count Surplus + Shortage (یک نوع، مقدار امضادار)
  SALES_DELIVERY // Sales Issue
  SALES_RETURN
  SUPPLIER_RETURN
  PRODUCTION_RECEIPT
  CENTER_CONSUMPTION
  PROJECT_CONSUMPTION
  PRODUCTION_CONSUMPTION
  CENTER_CONSUMPTION_RETURN
  PROJECT_CONSUMPTION_RETURN
  PRODUCTION_CONSUMPTION_RETURN
  FIXED_ASSET_ISSUE
}

// اجتماع WarehouseReceiptBasis + WarehouseIssueBasis + SalesDeliveryBasis — هر documentType فقط
// زیرمجموعه‌ی مربوط به خودش را معنادار می‌داند (کنترل در سطح اپلیکیشن، نه دیتابیس)
enum InventoryBasis {
  NO_BASIS
  SUPPLY_REQUEST
  PURCHASE_ORDER
  DELIVERY_AUTHORIZATION
  GOODS_REQUEST
  SALES_ORDER
}

model InventoryDocument {
  id                Int                      @id @default(autoincrement())
  documentType      InventoryDocumentType
  warehouseId       Int?
  sourceWarehouseId Int?
  destWarehouseId   Int?
  fiscalPeriodId    Int
  number            Int
  date              DateTime                 @db.Date
  basis             InventoryBasis?
  partyId           Int?
  costCenterId      Int?
  projectId         Int?
  description       String?
  creationType      WarehouseDocCreationType @default(MANUAL)
  status            WarehouseDocStatus       @default(DRAFT)
  finalizedAt       DateTime?
  createdAt         DateTime                 @default(now())
  warehouse         Warehouse?               @relation("InventoryDocWarehouse", fields: [warehouseId], references: [id])
  sourceWarehouse   Warehouse?               @relation("InventoryDocSourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destWarehouse     Warehouse?               @relation("InventoryDocDestWarehouse", fields: [destWarehouseId], references: [id])
  fiscalPeriod      FiscalPeriod             @relation(fields: [fiscalPeriodId], references: [id])
  party             Party?                   @relation(fields: [partyId], references: [id])
  costCenter        CostCenter?              @relation(fields: [costCenterId], references: [id])
  project           Project?                 @relation(fields: [projectId], references: [id])
  lines             InventoryDocumentLine[]

  @@unique([documentType, fiscalPeriodId, number])
}

model InventoryDocumentLine {
  id                                Int                        @id @default(autoincrement())
  documentId                        Int
  rowOrder                          Int                        @default(0)
  goodsItemId                       Int
  unitId                            Int
  quantity                          Decimal                    @db.Decimal(36, 10)
  systemQuantity                    Decimal?                   @db.Decimal(36, 10)
  countedQuantity                   Decimal?                   @db.Decimal(36, 10)
  unitCost                          Decimal                    @default(0) @db.Decimal(28, 10)
  amount                            Decimal                    @default(0) @db.Decimal(18, 2)
  description                       String?
  batchId                           Int?
  physicalLocationId                Int?
  sourceSupplyRequestLineId         Int?
  sourcePurchaseOrderLineId         Int?
  sourceDeliveryAuthorizationLineId Int?
  sourceGoodsRequestLineId          Int?
  sourceSalesOrderLineId            Int?
  // طبق بند ۴۰ سند: «هر برگشت باید به خروج/ورود مرتبط خود Reference داشته باشد» + کنترل
  // ReturnedQuantity <= IssuedQuantity — این ۵ فیلد خودارجاع (self-relation روی همین جدول) دقیقاً
  // همان قاعده را برای هر ۵ نوع سند «برگشتی» (Sales Return/Supplier Return/۳ نوع Consumption Return)
  // پیاده می‌کنند؛ بند ۳۴ برای بقیه‌ی انواع چنین ارجاعی نمی‌خواهد.
  sourceSalesDeliveryLineId         Int?
  sourceWarehouseReceiptLineId      Int?
  sourceCenterConsumptionLineId     Int?
  sourceProjectConsumptionLineId    Int?
  sourceProductionConsumptionLineId Int?
  document                          InventoryDocument          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  goodsItem                         GoodsItem                  @relation(fields: [goodsItemId], references: [id])
  unit                              UnitOfMeasure              @relation(fields: [unitId], references: [id])
  batch                             Batch?                     @relation(fields: [batchId], references: [id])
  physicalLocation                  PhysicalLocation?          @relation(fields: [physicalLocationId], references: [id])
  sourceSupplyRequestLine           SupplyRequestLine?         @relation("InventoryLineSourceSupplyRequestLine", fields: [sourceSupplyRequestLineId], references: [id])
  sourcePurchaseOrderLine           PurchaseOrderLine?         @relation("InventoryLineSourcePurchaseOrderLine", fields: [sourcePurchaseOrderLineId], references: [id])
  sourceDeliveryAuthorizationLine   DeliveryAuthorizationLine? @relation("InventoryLineSourceDeliveryAuthorizationLine", fields: [sourceDeliveryAuthorizationLineId], references: [id])
  sourceGoodsRequestLine            GoodsRequestLine?          @relation("InventoryLineSourceGoodsRequestLine", fields: [sourceGoodsRequestLineId], references: [id])
  sourceSalesOrderLine              SalesOrderLine?            @relation("InventoryLineSourceSalesOrderLine", fields: [sourceSalesOrderLineId], references: [id])
  sourceSalesDeliveryLine           InventoryDocumentLine?     @relation("InventoryLineSourceSalesDeliveryLine", fields: [sourceSalesDeliveryLineId], references: [id])
  salesReturnLines                  InventoryDocumentLine[]    @relation("InventoryLineSourceSalesDeliveryLine")
  sourceWarehouseReceiptLine        InventoryDocumentLine?     @relation("InventoryLineSourceWarehouseReceiptLine", fields: [sourceWarehouseReceiptLineId], references: [id])
  supplierReturnLines               InventoryDocumentLine[]    @relation("InventoryLineSourceWarehouseReceiptLine")
  sourceCenterConsumptionLine       InventoryDocumentLine?     @relation("InventoryLineSourceCenterConsumptionLine", fields: [sourceCenterConsumptionLineId], references: [id])
  centerConsumptionReturnLines      InventoryDocumentLine[]    @relation("InventoryLineSourceCenterConsumptionLine")
  sourceProjectConsumptionLine      InventoryDocumentLine?     @relation("InventoryLineSourceProjectConsumptionLine", fields: [sourceProjectConsumptionLineId], references: [id])
  projectConsumptionReturnLines     InventoryDocumentLine[]    @relation("InventoryLineSourceProjectConsumptionLine")
  sourceProductionConsumptionLine   InventoryDocumentLine?     @relation("InventoryLineSourceProductionConsumptionLine", fields: [sourceProductionConsumptionLineId], references: [id])
  productionConsumptionReturnLines  InventoryDocumentLine[]    @relation("InventoryLineSourceProductionConsumptionLine")
  serials                           InventoryLineSerial[]
  purchaseInvoiceLine               PurchaseInvoiceLine?       @relation("PurchaseInvoiceSourceInventoryLine")
  salesInvoiceLines                 SalesInvoiceLine[]         @relation("SalesInvoiceSourceInventoryLine")
  pricingAdjustments                GoodsPricingAdjustment[]
}

// طبق بند ۱۷-۱۹ سند: یک سطح سند می‌تواند چند سریال داشته باشد (نه یک سطر جدا برای هر سریال)
model InventoryLineSerial {
  id       Int                   @id @default(autoincrement())
  lineId   Int
  serialId Int
  line     InventoryDocumentLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  serial   Serial                @relation(fields: [serialId], references: [id])

  @@unique([lineId, serialId])
}

// طبق stockAnalysis.md (فاز ۴، بند ۴-۹): بستن موجودی هر انبار مستقل است — هدف Snapshot گرفتن موجودی
// تا یک تاریخ و جلوگیری از تغییر اسناد آن دوره است، نه غیرفعال‌کردن انبار. آخرین ردیف هر انبار (بر
// اساس closingDate) همان Closing جاری آن انبار است؛ Rollback یک ردیف Closing جدید با تاریخ قدیمی‌تر
// اضافه می‌کند (هرگز ردیف قبلی را ویرایش/حذف نمی‌کند) تا تاریخچه حفظ شود (بند ۵۹).
model InventoryClosing {
  id          Int                    @id @default(autoincrement())
  warehouseId Int
  closingDate DateTime               @db.Date
  closedAt    DateTime               @default(now())
  createdById Int?
  warehouse   Warehouse              @relation(fields: [warehouseId], references: [id])
  createdBy   User?                  @relation(fields: [createdById], references: [id])
  lines       InventoryClosingLine[]

  @@index([warehouseId, closingDate])
}

// بند ۷: Quantity مقدار موجودی واقعی محاسبه‌شده در لحظه‌ی Closing است، به تفکیک تمام Dimensionهای
// فعال (بند ۸) — PhysicalLocationId/BatchId/SerialId هر کدام فقط وقتی کالا آن Dimension را دارد پر
// می‌شوند، وگرنه null (دقیقاً مثل خود InventoryDocumentLine).
model InventoryClosingLine {
  id                 Int               @id @default(autoincrement())
  closingId          Int
  goodsItemId        Int
  physicalLocationId Int?
  batchId            Int?
  serialId           Int?
  quantity           Decimal           @db.Decimal(36, 10)
  closing            InventoryClosing  @relation(fields: [closingId], references: [id], onDelete: Cascade)
  goodsItem          GoodsItem         @relation(fields: [goodsItemId], references: [id])
  physicalLocation   PhysicalLocation? @relation(fields: [physicalLocationId], references: [id])
  batch              Batch?            @relation(fields: [batchId], references: [id])
  serial             Serial?           @relation(fields: [serialId], references: [id])
}

enum InventoryClosingAction {
  CLOSE
  ROLLBACK
}

// بند ۵۸: تمام عملیات Closing و Rollback باید Audit شوند (بدون امکان ویرایش/حذف — فقط Insert).
model InventoryClosingAudit {
  id             Int                    @id @default(autoincrement())
  action         InventoryClosingAction
  warehouseId    Int
  oldClosingDate DateTime?              @db.Date
  newClosingDate DateTime               @db.Date
  reason         String?
  userId         Int?
  actionAt       DateTime               @default(now())
  warehouse      Warehouse              @relation(fields: [warehouseId], references: [id])
  user           User?                  @relation(fields: [userId], references: [id])
}

// طبق مستند «قیمت‌گذاری اسناد انبار» (بند ۱۲): کلید منطقی وضعیت قیمت‌گذاری = ReportingPeriod + Item
// (بدون انبار). وجود این رکورد یعنی «این کالا در این دوره قیمت‌گذاری شده است»؛ برگشت قیمت‌گذاری صرفاً
// همین رکورد را حذف می‌کند (که با onDelete: Cascade تمام اصلاحیه‌های همان مرحله را هم حذف می‌کند) —
// نیازی به Undo دستی مبلغ سندها نیست چون هرگز amount اصلی سند مستقیماً تغییر نمی‌کند (پایین را ببینید).
model GoodsPricingStatus {
  id                Int                      @id @default(autoincrement())
  goodsItemId       Int
  reportingPeriodId Int
  pricedAt          DateTime                 @default(now())
  createdById       Int?
  goodsItem         GoodsItem                @relation(fields: [goodsItemId], references: [id])
  reportingPeriod   ReportingPeriod          @relation(fields: [reportingPeriodId], references: [id])
  createdBy         User?                    @relation(fields: [createdById], references: [id])
  adjustments       GoodsPricingAdjustment[]

  @@unique([goodsItemId, reportingPeriodId])
}

// طبق بند ۹ مستند: «مبلغ نهایی = مبلغ اولیه + مجموع اصلاحیه‌ها» — InventoryDocumentLine.amount
// («مبلغ اولیه») هرگز توسط موتور قیمت‌گذاری تغییر داده نمی‌شود؛ هر اثر قیمت‌گذاری (چه اولین‌بار قیمت‌گذاری
// یک ردیف صادره، چه اصلاحیه‌ی رسیدی که یک برگشت به تامین‌کننده به آن اثر می‌گذارد) یکسان به‌صورت یک ردیف
// اینجا ثبت می‌شود. این هم مدل داده را با فرمول/مثال مستند دقیقاً منطبق نگه می‌دارد و هم Rollback (حذف
// GoodsPricingStatus مربوطه) را بدون نیاز به منطق Undo جداگانه صحیح می‌کند.
model GoodsPricingAdjustment {
  id        Int                   @id @default(autoincrement())
  statusId  Int
  lineId    Int
  amount    Decimal               @db.Decimal(18, 2)
  createdAt DateTime              @default(now())
  status    GoodsPricingStatus    @relation(fields: [statusId], references: [id], onDelete: Cascade)
  line      InventoryDocumentLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
}

