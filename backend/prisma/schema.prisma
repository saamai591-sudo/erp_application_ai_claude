  salesInvoices                  SalesInvoice[]
  numberingPatternItems          NumberingPatternItem[]
  salesReturnInvoices            SalesReturnInvoice[]
  salesQuotes                    SalesQuote[]
  salesOrders                    SalesOrder[]
  goodsServiceAccountingSettings GoodsServiceAccountingSetting[]
  priceListScopes SalesPriceListScope[]
}

// طبق Documents/ReceiptType.md: مستر «نوع دریافت» — نوع دریافت (nature) تعیین می‌کند این دریافت اساساً
// چه ماهیتی دارد (از مشتری/پیش‌دریافت/از تامین‌کننده/از سایر/ارزش‌افزوده فروش/ارزش‌افزوده خرید)، و
// basisType تعیین می‌کند دریافت بر چه سندی مبتنی است — مقادیر basisType مجاز برای هر nature محدود است
// (نگاه کنید به ALLOWED_BASIS_TYPES در routes/receiptTypes.ts، تنها محل این قاعده). معین حسابداریِ نوع دریافت
// دیگر روی خود نوع نیست؛ در «تعیین حسابهای معین» (TreasuryAccountSetting، RECEIPT_SUBJECT) تعریف می‌شود.
model ReceiptType {
  id              Int              @id @default(autoincrement())
  code            Int              @unique
  title           String           @unique
  nature          ReceiptNature
  basisType       ReceiptBasisType
  isActive        Boolean          @default(true)
  hasTransactions Boolean          @default(false)
  createdAt       DateTime         @default(now())
  receiptSettlementLines ReceiptSettlementLine[]
  treasuryAccountSettings TreasuryAccountSetting[]
  openingCheques ChequeItem[] @relation("ChequeOpeningReceiptType")
}

// مستر «نوع پرداخت» — هم‌الگوی ReceiptType برای فرم پرداخت (اعلامیه پرداخت): nature تعیین می‌کند این پرداخت
// اساساً چه ماهیتی دارد و basisType تعیین می‌کند بر چه سندی مبتنی است (نگاه کنید به ALLOWED_BASIS_TYPES در
// routes/paymentTypes.ts، تنها محل این قاعده). معین حسابداریِ نوع پرداخت دیگر روی خود نوع نیست؛
// در «تعیین حسابهای معین» (TreasuryAccountSetting، PAYMENT_SUBJECT) تعریف می‌شود.
model PaymentType {
  id                     Int                     @id @default(autoincrement())
  code                   Int                     @unique
  title                  String                  @unique
  nature                 PaymentNature
  basisType              PaymentBasisType
  isActive               Boolean                 @default(true)
  hasTransactions        Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  paymentSettlementLines PaymentSettlementLine[]
  treasuryAccountSettings TreasuryAccountSetting[]
  openingCheques ChequeItem[] @relation("ChequeOpeningPaymentType")
  pettyCashPayments PettyCashPayment[]
  pettyCashSummaryLines PettyCashSummaryLine[]
}

// طبق Documents/نوع چک دریافتی و پرداختی.md — دو مستر ساده‌ی تنظیمات خزانه‌داری: کد (خودکار: آخرین کد + ۱)
// و عنوان یکتا. «نوع چک پرداختی» علاوه بر آن گزینه‌ی «چک روز» (isSameDay) دارد.
model ReceivableChequeType {
  id        Int      @id @default(autoincrement())
  code      Int      @unique
  title     String   @unique
  createdAt DateTime @default(now())
  receiptInstrumentLines ReceiptInstrumentLine[]
  chequeItems ChequeItem[]
  treasuryAccountSettings TreasuryAccountSetting[]
}

model PayableChequeType {
  id        Int      @id @default(autoincrement())
  code      Int      @unique
  title     String   @unique
  isSameDay Boolean  @default(false)
  createdAt DateTime @default(now())
  paymentInstrumentLines PaymentInstrumentLine[]
  chequeItems ChequeItem[]
  treasuryAccountSettings TreasuryAccountSetting[]
}

// طبق Documents/تعیین حسابهای معین.md — نگاشت «یک مورد خزانه‌داری» به «حساب معین»: بسته به accountType دقیقاً
// یکی از فیلدهای هدف (bankAccountId برای BANK_ACCOUNT و BANK_FEE مشترک است) پر می‌شود و بقیه null هستند
// (نگاه کنید به TARGET_FIELD در routes/treasuryAccountSettings.ts). برای هر نوع حساب و هر مورد فقط یک معین.
model TreasuryAccountSetting {
  id                       Int                    @id @default(autoincrement())
  accountType              TreasuryAccountType
  bankAccountId            Int?
  cashBoxId                Int?
  receivableChequeTypeId   Int?
  payableChequeTypeId      Int?
  receiptTypeId            Int?
  paymentTypeId            Int?
  pettyCashId              Int?
  accountId                Int
  /// تاریخ اجرا: رکورد مؤثر یک سند = آخرین رکورد هم‌هدف با effectiveDate ≤ تاریخ سند (services/treasurySettingService.ts)
  effectiveDate            DateTime               @default("2000-01-01T00:00:00.000Z") @db.Date
  createdAt                DateTime               @default(now())
  account                  Account                @relation(fields: [accountId], references: [id])
  bankAccount              BankAccount?           @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  cashBox                  CashBox?               @relation(fields: [cashBoxId], references: [id], onDelete: Restrict)
  receivableChequeType     ReceivableChequeType?  @relation(fields: [receivableChequeTypeId], references: [id], onDelete: Restrict)
  payableChequeType        PayableChequeType?     @relation(fields: [payableChequeTypeId], references: [id], onDelete: Restrict)
  receiptType              ReceiptType?           @relation(fields: [receiptTypeId], references: [id], onDelete: Restrict)
  paymentType              PaymentType?           @relation(fields: [paymentTypeId], references: [id], onDelete: Restrict)
  pettyCash                PettyCash?             @relation(fields: [pettyCashId], references: [id], onDelete: Restrict)
  usages                   AccountingSettingUsage[]

  @@unique([accountType, bankAccountId, effectiveDate])
  @@unique([accountType, cashBoxId, effectiveDate])
  @@unique([accountType, receivableChequeTypeId, effectiveDate])
  @@unique([accountType, payableChequeTypeId, effectiveDate])
  @@unique([accountType, receiptTypeId, effectiveDate])
  @@unique([accountType, paymentTypeId, effectiveDate])
  @@unique([accountType, pettyCashId, effectiveDate])
}

enum TreasuryAccountType {
  BANK_ACCOUNT
  BANK_FEE
  CASH_BOX
  RECEIVABLE_CHEQUE
  PAYABLE_CHEQUE
  RECEIPT_SUBJECT
  PAYMENT_SUBJECT
  FX_GAIN_LOSS
  // «اسناد در جریان وصول» — معین بدهکارِ صدور سند واگذاری چک به بانک، به‌ازای حساب بانکیِ مقصد (فیلد bankAccountId)
  CHEQUE_IN_COLLECTION
  // «چک پرداختیِ برگشتی (بدهی به طرف حساب)» — معین بستانکارِ صدور سند وصول و برگشت چک پرداختنی برای نتیجه‌ی «برگشتی»؛ بدون مورد هدف (تنها یک رکورد)
  BOUNCED_PAYABLE_CHEQUE
  // معینِ بستانکارِ سند حسابداریِ «خلاصه تنخواه» (اسناد.services/pettyCashSummaryJournalEntryService.ts) — به‌ازای هر تنخواه (فیلد pettyCashId)
  PETTY_CASH
}

