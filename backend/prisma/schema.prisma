  purchaseType           PurchaseType                   @relation(fields: [purchaseTypeId], references: [id])
  approver               User?                          @relation("PurchaseInvoiceApprover", fields: [approverId], references: [id])
  journalEntry           JournalEntry?                  @relation(fields: [journalEntryId], references: [id])
  lines                  PurchaseInvoiceLine[]
  otherCostLines         PurchaseCostLine[]
  receiptSettlementLines ReceiptSettlementLine[]
