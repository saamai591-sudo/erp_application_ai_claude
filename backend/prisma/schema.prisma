generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// دقیقاً منعکس‌کننده‌ی برگ‌های درخت Registry (backend/src/authz/registry.ts) است — هرگز مستقیم
// دستی ساخته/ویرایش نمی‌شود؛ فقط syncRegistryToDb() (که در seed و در boot اجرا می‌شود) این جدول را
// از روی Registry به‌روز نگه می‌دارد. حذف یک Action از Registry باعث حذف ردیف متناظر (و grantهای آن)
// از این جدول هم می‌شود؛ بنابراین این جدول هرگز «منبع حقیقت» نیست، فقط بازتاب مادی‌شده‌ی آن است.
model Action {
  id             Int          @id @default(autoincrement())
  key            String       @unique
  kind           ActionKind
  title          String
  moduleKey      String
  moduleTitle    String
  subModuleKey   String
  subModuleTitle String
  formKey        String
  formTitle      String
  roles          RoleAction[]
  users          UserAction[]
}

enum ActionKind {
  BASE
  CUSTOM
}

model Role {
  id        Int          @id @default(autoincrement())
  code      Int          @unique
  title     String       @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  actions   RoleAction[]
  users     UserRole[]
}

model RoleAction {
  roleId   Int
  actionId Int
  action   Action @relation(fields: [actionId], references: [id], onDelete: Cascade)
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, actionId])
}

// اعطای مستقیم یک Action به یک کاربر، مستقل از نقش‌هایش (طبق نیاز صریح: «Roles and/or Users»).
// مجوزهای نهایی کاربر همیشه اجتماع (union) این جدول و نقش‌های اوست — نگاه کنید به
// getUserActionKeys در backend/src/authz/guard.ts.
model UserAction {
  userId   Int
  actionId Int
  action   Action @relation(fields: [actionId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, actionId])
}

model User {
  id                       Int                     @id @default(autoincrement())
  code                     Int                     @unique
  mobile                   String                  @unique @db.VarChar(11)
  firstName                String
  lastName                 String
  isActive                 Boolean                 @default(true)
  passwordHash             String
  // مکانیزم متمرکز و توسعه‌پذیر تنظیمات کاربری (فونت/تم/دوره مالی جاری و…): یک شیء JSON آزاد به‌جای
  // یک ستون جدا به‌ازای هر تنظیم — افزودن یک تنظیم جدید فقط یعنی یک کلید جدید در همین شیء، بدون
  // نیاز به migration. نگاه کنید به routes/userPreferences.ts و frontend/src/lib/preferences.ts.
  preferences              Json                    @default("{}")
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  hasTransactions          Boolean                 @default(false)
  partyId                  Int?
  goodsRequestsApproved    GoodsRequest[]          @relation("GoodsRequestApprover")
  goodsRequestsReviewed    GoodsRequest[]          @relation("GoodsRequestReviewer")
  purchaseRequestsApproved PurchaseRequest[]       @relation("PurchaseRequestApprover")
  purchaseRequestsReviewed PurchaseRequest[]       @relation("PurchaseRequestReviewer")
  supplyRequestsApproved   SupplyRequest[]         @relation("SupplyRequestApprover")
  supplyRequestsReviewed   SupplyRequest[]         @relation("SupplyRequestReviewer")
  party                    Party?                  @relation(fields: [partyId], references: [id])
  roles                    UserRole[]
  actions                  UserAction[]
  documentItemAmounts      DocumentItemAmount[]
  goodsPricingStatuses     GoodsPricingStatus[]
  purchaseInvoicesApproved PurchaseInvoice[]       @relation("PurchaseInvoiceApprover")
  servicePurchaseInvoicesApproved ServicePurchaseInvoice[] @relation("ServicePurchaseInvoiceApprover")
}

model UserRole {
  userId Int
  roleId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Currency {
  id               Int                  @id @default(autoincrement())
  code             String               @unique
  title            String               @unique
  decimalPlaces    Int                  @default(2)
  isBase           Boolean              @default(false)
  rateDirection    RateDirection?
  baseVolume       Int                  @default(1)
  hasTransactions  Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  closingLines     AccountClosingLine[]
  cheques          ChequeItem[]
  pettyCashes      PettyCash[]
  rates            ExchangeRate[]
  journalLines     JournalEntryLine[]
  paymentInstrumentLines   PaymentInstrumentLine[]
  paymentSettlementLines   PaymentSettlementLine[]
  priceInquiries   PriceInquiry[]
  purchaseInvoices PurchaseInvoice[]
  servicePurchaseInvoices ServicePurchaseInvoice[]
  purchaseOrders   PurchaseOrder[]
  salesInvoices    SalesInvoice[]
  salesReturnInvoices SalesReturnInvoice[]
  salesOrders      SalesOrder[]
  salesQuotes      SalesQuote[]
  bankAccounts             BankAccount[]
  receiptInstrumentLines   ReceiptInstrumentLine[]
  receiptSettlementLines   ReceiptSettlementLine[]
  treasuryOpeningBankAccounts TreasuryOpeningBankAccount[]
  treasuryOpeningPettyCashLines TreasuryOpeningPettyCash[]
  treasuryOpeningCashBoxes TreasuryOpeningCashBox[]
}

model ExchangeRate {
  id         Int      @id @default(autoincrement())
  date       DateTime @db.Date
  currencyId Int
  rate       Decimal  @db.Decimal(18, 6)
  createdAt  DateTime @default(now())
  currency   Currency @relation(fields: [currencyId], references: [id])

  @@unique([date, currencyId])
}

model FiscalPeriod {
  id                        Int                        @id @default(autoincrement())
  code                      String                     @unique
  title                     String                     @unique @db.VarChar(4)
  fromDate                  DateTime                   @db.Date
  toDate                    DateTime                   @db.Date
  hasTransactions           Boolean                    @default(false)
  createdAt                 DateTime                   @default(now())
  accountClosings           AccountClosing[]
  pettyCashPayments         PettyCashPayment[]
  pettyCashSummaries        PettyCashSummary[]
  chequeDeposits            ChequeDeposit[]
  chequeDepositReturns      ChequeDepositReturn[]
  chequeClearingReceivables ChequeClearingReceivable[]
  chequeClearingPayables    ChequeClearingPayable[]
  deliveryAuthorizations    DeliveryAuthorization[]
  goodsRequests             GoodsRequest[]
  initialInventories        InitialInventory[]
  inquiryAuthorizations     InquiryAuthorization[]
  inquiryEvaluations        InquiryEvaluation[]
  journalEntries            JournalEntry[]
  openingClosingEntries     OpeningClosingEntry[]
  payments                  Payment[]
  priceInquiries            PriceInquiry[]
  purchaseInvoices          PurchaseInvoice[]
  servicePurchaseInvoices   ServicePurchaseInvoice[]
  purchaseOrders            PurchaseOrder[]
  purchasePlannings         PurchasePlanning[]
  purchaseRequests          PurchaseRequest[]
  receipts                  Receipt[]
  salesDeliveries           SalesDelivery[]
  salesInvoices             SalesInvoice[]
  salesReturnInvoices       SalesReturnInvoice[]
  salesOrders               SalesOrder[]
  salesQuotes               SalesQuote[]
  supplyRequests            SupplyRequest[]
  warehouseAdjustments      WarehouseAdjustment[]
  warehouseIssues           WarehouseIssue[]
  warehouseReceipts         WarehouseReceipt[]
  warehouseTransfers        WarehouseTransfer[]
  inventoryDocuments        InventoryDocument[]
  reportingPeriods          ReportingPeriod[]
  warehouseJournalEntryIssuances WarehouseJournalEntryIssuance[]
  chequeItems                ChequeItem[]
  treasuryOpenings          TreasuryOpening[]
  treasuryYearCloses        TreasuryYearClose[]
}

enum ReportingPeriodStatus {
  OPEN
  CLOSED
}

model ReportingPeriod {
  id              Int                   @id @default(autoincrement())
  fiscalPeriodId  Int
  code            String
  title           String
  fromDate        DateTime              @db.Date
  toDate          DateTime              @db.Date
  status          ReportingPeriodStatus @default(OPEN)
  hasBeenClosed   Boolean               @default(false)
  createdAt       DateTime              @default(now())
  fiscalPeriod    FiscalPeriod          @relation(fields: [fiscalPeriodId], references: [id])
  pricingStatuses GoodsPricingStatus[]
  pricingFlowWarehouses GoodsPricingFlowWarehouse[]

  @@unique([fiscalPeriodId, code])
}

model OrgStructure {
  id       Int            @id @default(autoincrement())
  parentId Int?
  code     String
  title    String
  parent   OrgStructure?  @relation("OrgTree", fields: [parentId], references: [id])
  children OrgStructure[] @relation("OrgTree")
  orgUnits OrgUnit[]

  @@unique([parentId, code])
}

model GeoRegion {
  id        Int            @id @default(autoincrement())
  parentId  Int?
  level     GeoLevel
  code      String
  title     String
  parent    GeoRegion?     @relation("GeoTree", fields: [parentId], references: [id])
  children  GeoRegion[]    @relation("GeoTree")
  addresses PartyAddress[]

  @@unique([parentId, code])
}

model DetailType {
  id                Int               @id @default(autoincrement())
  code              Int               @unique
  title             String            @unique
  codeLength        Int               @default(5)
  startNumber       Int
  endNumber         Int
  manualEntry       Boolean           @default(false)
  accountsAsDetail1 Account[]         @relation("AccountDetailType1")
  accountsAsDetail2 Account[]         @relation("AccountDetailType2")
  accountsAsDetail3 Account[]         @relation("AccountDetailType3")
  codes             DetailCodeUsage[]
}

model DetailCodeUsage {
  id           Int        @id @default(autoincrement())
  code         String     @unique
  detailTypeId Int
  entityTable  String
  entityId     Int
  createdAt    DateTime   @default(now())
  detailType   DetailType @relation(fields: [detailTypeId], references: [id])
}

model Party {
  id                 Int                @id @default(autoincrement())
  detailCode         String             @unique
  category           PartyCategory
  nationality        Nationality        @default(LOCAL)
  nationalId         String?
  foreignId          String?
  economicCode       String?
  firstName          String?
  lastName           String?
  legalType          LegalPartyType?
  name               String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  hasTransactions    Boolean            @default(false)
  isActive           Boolean            @default(true)
  bankAccountsAsBank BankAccount[]      @relation("BankAccountBankParty")
  bankBranches       BankBranch[]       @relation("BankParty")
  cheques            ChequeItem[]
  customer           Customer?
  goodsRequestLines  GoodsRequestLine[]
  addresses          PartyAddress[]
  bankAccounts       PartyBankAccount[]
  phones             PartyPhone[]
  payments           Payment[]
  paymentSettlementLines PaymentSettlementLine[]
  purchaseExpert     PurchaseExpert?
  purchaseInvoices   PurchaseInvoice[]
  servicePurchaseInvoices ServicePurchaseInvoice[]
  receipts           Receipt[]
  receiptSettlementLines ReceiptSettlementLine[]
  supplier           Supplier?
  users              User[]
  warehousesManaged  Warehouse[]        @relation("WarehouseManager")
  pettyCashPayments  PettyCashPayment[]
  warehouseReceipts  WarehouseReceipt[]
  batchesAsSupplier  Batch[]            @relation("BatchSupplier")
  pettyCashCustodians PettyCashCustodian[]
}

model PartyAddress {
  id         Int         @id @default(autoincrement())
  partyId    Int
  type       AddressType
  cityId     Int
  address    String?
  postalCode String?
  isPrimary  Boolean     @default(false)
  city       GeoRegion   @relation(fields: [cityId], references: [id])
  party      Party       @relation(fields: [partyId], references: [id], onDelete: Cascade)
}

model PartyPhone {
  id        Int       @id @default(autoincrement())
  partyId   Int
  type      PhoneType
  number    String
  isPrimary Boolean   @default(false)
  party     Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)
}

model PartyBankAccount {
  id            Int     @id @default(autoincrement())
  partyId       Int
  bankPartyId   Int?
  accountNumber String?
  iban          String?
  cardNumber    String?
  party         Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)
}

model BankAccountType {
  id            Int           @id @default(autoincrement())
  code          Int           @unique
  title         String        @unique
  hasChequeBook Boolean       @default(false)
  bankAccounts  BankAccount[]
}

model BankBranch {
  id                           Int                     @id @default(autoincrement())
  code                         Int
  title                        String                  @unique
  bankPartyId                  Int
  hasTransactions              Boolean                 @default(false)
  bankAccounts                 BankAccount[]
  bankParty                    Party                   @relation("BankParty", fields: [bankPartyId], references: [id])
  cheques                      ChequeItem[]
  paymentInstrumentChequeLines PaymentInstrumentLine[] @relation("PaymentInstrumentChequeBankBranch")
  receiptInstrumentChequeLines ReceiptInstrumentLine[] @relation("ReceiptInstrumentChequeBankBranch")

  @@unique([bankPartyId, code])
}

model BankAccount {
  id                     Int                     @id @default(autoincrement())
  detailCode             String                  @unique
  accountTypeId          Int
  bankBranchId           Int
  accountNumber          String
  currencyId             Int?
  bankPartyId            Int?
  hasTransactions        Boolean                 @default(false)
  accountType            BankAccountType         @relation(fields: [accountTypeId], references: [id])
  bankBranch             BankBranch              @relation(fields: [bankBranchId], references: [id])
  bankParty              Party?                  @relation("BankAccountBankParty", fields: [bankPartyId], references: [id])
  currency               Currency?               @relation(fields: [currencyId], references: [id])
  chequesOwned           ChequeItem[]
  paymentInstrumentLines PaymentInstrumentLine[] @relation("PaymentInstrumentBankAccount")
  paymentSettlementLines PaymentSettlementLine[] @relation("PaymentSettlementBankAccount")
  receiptInstrumentLines ReceiptInstrumentLine[] @relation("ReceiptInstrumentBankAccount")
  chequeDeposits         ChequeDeposit[]
  treasuryAccountSettings TreasuryAccountSetting[]
  chequeBookLeaves       ChequeBookLeaf[]

  @@unique([bankPartyId, accountNumber])
  treasuryOpeningLines TreasuryOpeningBankAccount[]
}

// طبق Documents/دسته چک.md — دسته چک: برگه‌های چک پرداختنی خامِ اخذشده از بانک، برای کنترل شماره‌های
// چک هنگام صدور چک در سند پرداخت. هر رکورد یک برگه‌ی مجزاست (نه کل دسته)؛ «ایجاد دسته چک» در بک‌اند
// (routes/chequeBookLeaves.ts) به‌ازای هر شماره‌ی سریالی یک رکورد جداگانه می‌سازد. حساب بانکی فقط از
// نوع‌هایی قابل انتخاب است که BankAccountType.hasChequeBook فعال باشد (کنترل ۱ سند). شماره در سطح هر
// حساب بانکی یکتاست (کنترل ۴ سند). وضعیت خودکار محاسبه می‌شود، نه مستقیماً توسط کاربر: خام تا وقتی
// هیچ عملیاتی نداشته، صادر شده وقتی برای صدور چک تازه در یک سند پرداخت مصرف شده (در تایید/ویرایش سند
// تاییدشده — نگاه کنید به routes/payments.ts)، باطل شده با اکشن دستی «ابطال» (فقط از خام).
model ChequeBookLeaf {
  id              Int                   @id @default(autoincrement())
  bankAccountId   Int
  series          String
  number          String
  printTemplate   String?
  status          ChequeBookLeafStatus  @default(RAW)
  createdAt       DateTime              @default(now())
  bankAccount     BankAccount           @relation(fields: [bankAccountId], references: [id])
  instrumentLines PaymentInstrumentLine[]

  @@unique([bankAccountId, number])
}

enum ChequeBookLeafStatus {
  RAW
  ISSUED
  VOID
}

model CostCenter {
  id                Int                @id @default(autoincrement())
  detailCode        String             @unique
  title             String             @unique
  type              CostCenterType     @default(ADMIN)
  orgUnitId         Int
  hasTransactions   Boolean            @default(false)
  orgUnit           OrgUnit            @relation(fields: [orgUnitId], references: [id])
  goodsRequestLines GoodsRequestLine[]
  warehouseIssues   WarehouseIssue[]
}

model OrgUnit {
  id               Int               @id @default(autoincrement())
  code             Int               @unique
  title            String            @unique
  orgStructureId   Int
  hasTransactions  Boolean           @default(false)
  costCenters      CostCenter[]
  goodsRequests    GoodsRequest[]
  orgStructure     OrgStructure      @relation(fields: [orgStructureId], references: [id])
  purchaseRequests PurchaseRequest[]
  supplyRequests   SupplyRequest[]
  // طبق تصمیم صریح کاربر: این فیلد فقط برای الزام schema-level پریزما (هر رابطه باید روی هر دو طرف
  // فیلد داشته باشد، وگرنه validate خطای P1012 می‌دهد) نگه داشته شده — عمداً در هیچ route/پاسخ/صفحه‌ی
  // مربوط به واحد سازمانی استفاده نمی‌شود؛ ارجاع واقعی همیشه از سمت SalesCenter است، نه برعکس.
  salesCenters     SalesCenter[]
}

// «مرکز فروش» — موجودیت عملیاتی فروش، وابسته به یک واحد سازمانی، برای شناسایی مرکز فروش مسئول یک سند
// فروش. یک واحد سازمانی می‌تواند چندین مرکز فروش داشته باشد (۱ به چند)؛ دقیقاً هم‌الگوی WarehouseGroup/
// PurchaseType/SalesType (کد ساده‌ی سریالی، نه کد تفصیل — برخلاف CostCenter که بخشی از رجیستری
// DetailCodeUsage است، این‌جا چنین اشتراکی خواسته نشده).
model SalesCenter {
  id                 Int      @id @default(autoincrement())
  code               Int      @unique
  title              String   @unique
  description        String?
  organizationUnitId Int
  isActive           Boolean  @default(true)
  hasTransactions    Boolean  @default(false)
  createdAt          DateTime @default(now())
  organizationUnit   OrgUnit  @relation(fields: [organizationUnitId], references: [id])
  salesQuotes        SalesQuote[]
  salesOrders        SalesOrder[]
  salesInvoices      SalesInvoice[]
  salesReturnInvoices SalesReturnInvoice[]
}

model CashBox {
  id                     Int                     @id @default(autoincrement())
  detailCode             String                  @unique
  title                  String                  @unique
  hasTransactions        Boolean                 @default(false)
  paymentInstrumentLines PaymentInstrumentLine[]
  paymentSettlementLines PaymentSettlementLine[] @relation("PaymentSettlementCashBox")
  receiptInstrumentLines ReceiptInstrumentLine[]
  treasuryAccountSettings TreasuryAccountSetting[]
  treasuryOpeningLines TreasuryOpeningCashBox[]
}

/// تعریف تنخواه (مدیریت خزانه › تنظیمات): کد تفصیلی توسط سرویس عمومی «ایجاد کد تفصیلی» (utils/coding.ts، نوع تفصیل ۵ «تنخواه») صادر می‌شود، نه ورودی کاربر.
/// limitAmount = سقف تنخواه به «ارز» همین تنخواه؛ isActive = قابل استفاده بودن.
model PettyCash {
  id              Int      @id @default(autoincrement())
  detailCode      String   @unique
  title           String   @unique
  currencyId      Int
  limitAmount     Decimal  @default(0) @db.Decimal(18, 2)
  isActive        Boolean  @default(true)
  hasTransactions Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  currency        Currency @relation(fields: [currencyId], references: [id])
  custodians      PettyCashCustodian[]
  treasuryAccountSettings TreasuryAccountSetting[]
  openingLines    TreasuryOpeningPettyCash[]
}

/// تنخواه‌دار (مدیریت خزانه › تنظیمات): یک طرف‌حساب مسئول یک تنخواه. کد تفصیلی توسط سرویس عمومی «ایجاد کد تفصیلی» (نوع تفصیل ۶ «تنخواه دار») صادر می‌شود.
/// controlNegativeBalance = سیستم باید مانع منفی‌شدن مانده‌ی تنخواه شود (برای عملیات آینده‌ی تنخواه)؛ isActive = قابل استفاده بودن.
model PettyCashCustodian {
  id                     Int      @id @default(autoincrement())
  detailCode             String   @unique
  pettyCashId            Int
  partyId                Int
  isActive               Boolean  @default(true)
  controlNegativeBalance Boolean  @default(true)
  hasTransactions        Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  pettyCash              PettyCash @relation(fields: [pettyCashId], references: [id])
  party                  Party    @relation(fields: [partyId], references: [id])
  payments               PettyCashPayment[]
  summaries              PettyCashSummary[]
  paymentSettlementLines PaymentSettlementLine[]

  @@unique([pettyCashId, partyId])
}

/// پرداخت تنخواه (مدیریت خزانه › پرداخت): سند ساده‌ی ثبتِ برداشت از یک تنخواه — بدون سند حسابداری/گردش تایید (طبق تصمیم صریح کاربر، فعلاً
/// فقط ثبت اطلاعات). ارز پرداخت همیشه ارز همان تنخواه‌دار/تنخواه است (فیلدی جدا ندارد، از رابطه خوانده می‌شود). دقیقاً یکی از
/// purchaseInvoiceId/salesInvoiceId/purchaseOrderId پر می‌شود که با basisType نوع پرداختِ انتخاب‌شده (routes/paymentTypes.ts) سازگار
/// باشد؛ اگر basisType=NONE هر سه خالی می‌مانند. اگر basisType!=NONE، تاریخ سند مبنا باید از تاریخ این پرداخت کوچکتر باشد (assertBasisDateBeforePayment)
/// و از آن پس فیلد تاریخ دیگر قابل ویرایش نیست (کنترل هم‌الگوی «موضوعات پرداخت» سند پرداخت). کنترل مانده منفی: اگر تنخواه‌دار
/// controlNegativeBalance=true باشد، مجموع پرداخت‌های همه‌ی تنخواه‌دارهای همان تنخواه هرگز از سقف تنخواه (PettyCash.limitAmount) بیشتر نمی‌شود.
model PettyCashPayment {
  id                Int      @id @default(autoincrement())
  fiscalPeriodId    Int
  date              DateTime @db.Date
  custodianId       Int
  partyId           Int
  paymentTypeId     Int
  purchaseInvoiceId Int?
  salesInvoiceId    Int?
  purchaseOrderId   Int?
  amount            Decimal  @db.Decimal(18, 2)
  description       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  fiscalPeriod      FiscalPeriod     @relation(fields: [fiscalPeriodId], references: [id])
  custodian         PettyCashCustodian @relation(fields: [custodianId], references: [id])
  party             Party            @relation(fields: [partyId], references: [id])
  paymentType       PaymentType      @relation(fields: [paymentTypeId], references: [id])
  purchaseInvoice   PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])
  salesInvoice      SalesInvoice?    @relation(fields: [salesInvoiceId], references: [id])
  purchaseOrder     PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  summaryLines      PettyCashSummaryLine[]
}

/// خلاصه تنخواه (مدیریت خزانه › پرداخت): سندی که پرداخت‌های تنخواه ثبت‌شده‌ی یک تنخواه‌دار را به حساب‌های حسابداری واقعی
/// وصل می‌کند (طبق تصمیم صریح کاربر: دو مرحله‌ای هم‌الگوی پرداخت/دریافت — تایید سند ثابتش می‌کند و تسعیر را محاسبه می‌کند،
/// «صدور سند حسابداری» جداگانه سند را می‌سازد). نرخ ارز و شرح در سطح هدر است (نه هر ردیف)؛ ارز خودِ سند از تنخواهِ
/// تنخواه‌دارِ انتخاب‌شده می‌آید (فیلد جدا ندارد).
model PettyCashSummary {
  id             Int                @id @default(autoincrement())
  fiscalPeriodId Int
  number         Int
  date           DateTime           @db.Date
  custodianId    Int
  fxRate         Decimal            @default(1) @db.Decimal(18, 6)
  description    String?
  status         TreasuryDocStatus  @default(DRAFT)
  journalEntryId Int?               @unique
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt
  fiscalPeriod   FiscalPeriod       @relation(fields: [fiscalPeriodId], references: [id])
  custodian      PettyCashCustodian @relation(fields: [custodianId], references: [id])
  journalEntry   JournalEntry?      @relation(fields: [journalEntryId], references: [id])
  lines          PettyCashSummaryLine[]

  @@unique([fiscalPeriodId, number])
}

/// ردیف خلاصه تنخواه: هر ردیف به یک PettyCashPayment ثبت‌شده وصل است («موضوع پرداخت» ردیف)؛ چند ردیف می‌توانند به یک
/// PettyCashPayment واحد وصل باشند (تقسیم مبلغ)، به شرط آن‌که مجموعشان از مبلغ اصلی آن پرداخت بیشتر نشود (در سطح همه‌ی
/// خلاصه‌های تنخواه، نه فقط همین سند — services/pettyCashSummaryRemaining.ts). نوع پرداخت/سند مبنا با ایجاد ردیف از روی
/// همان PettyCashPayment کپی می‌شوند ولی بعداً با اکشن «تغییر نوع پرداخت» قابل تغییرند (طرف‌حساب برای یافتن سند مبنای
/// جدید همیشه از PettyCashPayment خودش می‌آید، نه یک فیلد جدا). حساب معین از روی نوع پرداخت/سند مبنا محاسبه می‌شود
/// (services/paymentSubjectAccount.ts، همان قواعد سند پرداخت)؛ تفصیل ۱/۲/۳ دستی و طبق همان مکانیزم سند حسابداری
/// (validateAccountForLine در routes/journalEntries.ts) اعتبارسنجی می‌شود. exchangeGainLoss فقط برای ردیف‌های
/// PURCHASE_INVOICE/SALES_INVOICE در لحظه‌ی تایید سند محاسبه و نگهداری می‌شود (صفر برای بقیه).
model PettyCashSummaryLine {
  id                 Int              @id @default(autoincrement())
  summaryId          Int
  rowOrder           Int              @default(0)
  pettyCashPaymentId Int
  paymentTypeId      Int
  purchaseInvoiceId  Int?
  salesInvoiceId     Int?
  purchaseOrderId    Int?
  detail1Code        String?
  detail2Code        String?
  detail3Code        String?
  amount             Decimal          @db.Decimal(18, 2)
  exchangeGainLoss   Decimal          @default(0) @db.Decimal(18, 2)
  description        String?
  summary            PettyCashSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  pettyCashPayment   PettyCashPayment @relation(fields: [pettyCashPaymentId], references: [id])
  paymentType        PaymentType      @relation(fields: [paymentTypeId], references: [id])
  purchaseInvoice    PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])
  salesInvoice       SalesInvoice?    @relation(fields: [salesInvoiceId], references: [id])
  purchaseOrder      PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
}

model ReportingLevel {
  id         Int       @id @default(autoincrement())
  order      Int       @unique
  title      String    @unique
  codeLength Int
  accounts   Account[]
}

model OlapReport {
  id        Int      @id @default(autoincrement())
