// هم‌الگوی Receipt: ارز و نرخ ارز از هدر به هر ردیف ابزار منتقل شده (ندارد currencyId)، «موضوعات پرداخت» مدل
// کامل‌تری دارد، و سند حسابداری با اکشن دستی صادر می‌شود (journalEntryId).
model Payment {
  id              Int                     @id @default(autoincrement())
  fiscalPeriodId  Int
  number          Int
  date            DateTime                @db.Date
  partyId         Int
  description     String?
  status          TreasuryDocStatus       @default(DRAFT)
  journalEntryId  Int?                    @unique
  journalEntry    JournalEntry?           @relation(fields: [journalEntryId], references: [id])
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @default(now()) @updatedAt
  fiscalPeriod    FiscalPeriod            @relation(fields: [fiscalPeriodId], references: [id])
  party           Party                   @relation(fields: [partyId], references: [id])
  instrumentLines PaymentInstrumentLine[]
  settlementLines PaymentSettlementLine[]

  @@unique([fiscalPeriodId, number])
  /// «تایید حسابداری»: بعد از آن ردیف‌های حسابداری (پیش‌نویس سند در سطح فرم) ساخته/نمایش داده می‌شود و سند قفل است
  accountingStatus AccountingApprovalStatus @default(NONE)
  accountingApprovedAt DateTime?
  accountingApprovedById Int?
  accountingLines PaymentAccountingLine[]
}

model PaymentInstrumentLine {
  id                 Int                   @id @default(autoincrement())
  paymentId          Int
  rowOrder           Int                   @default(0)
  type               PaymentInstrumentType
  amount             Decimal               @db.Decimal(18, 2)
  // هم‌الگوی ReceiptInstrumentLine: ارز و نرخ ارز هر ردیف؛ baseAmount محاسبه و نگهداری می‌شود ولی در UI نمایش داده نمی‌شود.
  // نقد: ارز را کاربر انتخاب می‌کند؛ حواله/پوز: ارز حساب بانکی؛ چک (صدور یا خرج): همیشه ارز پایه.
  currencyId         Int
  fxRate             Decimal               @default(1) @db.Decimal(18, 6)
  baseAmount         Decimal               @db.Decimal(36, 10)
  cashBoxId          Int?
  bankAccountId      Int?
  referenceNumber    String?
  chequeItemId       Int?
  chequeNumber       String?
  chequeDueDate      DateTime?             @db.Date
  chequeBankBranchId Int?
  // نوع چک پرداختی — فقط برای صدور چک تازه (خرج‌کردن چک دریافتنی، نوع خودِ آن چک را دارد)
  payableChequeTypeId Int?
  // برگه‌ی مصرف‌شده از «دسته چک» — فقط برای صدور چک تازه از حساب بانکیِ دارای دسته چک (Documents/دسته چک.md)؛
  // اختیاری برای حسابهای بدون دسته چک که شماره را کاربر آزادانه تایپ می‌کند.
  chequeBookLeafId   Int?
  // فقط برای ردیف نوع CHEQUE (چه صدور تازه چه خرج‌کردن چک دریافتنی موجود)، در لحظه‌ی تایید سند
  // برابر step همان لحظه‌ی ChequeItem پر می‌شود (نگاه کنید به توضیح بالای ChequeItem.step).
  chequeStep         Int?
  posTerminal        String?
  /// کارمزد پرداخت — فقط برای ردیف حواله/انتقال بانکی (به ارز همان ردیف)؛ برای بقیه‌ی انواع همیشه ۰
  feeAmount          Decimal               @default(0) @db.Decimal(18, 2)
  description        String?
  bankAccount        BankAccount?          @relation("PaymentInstrumentBankAccount", fields: [bankAccountId], references: [id])
  cashBox            CashBox?              @relation(fields: [cashBoxId], references: [id])
  chequeBankBranch   BankBranch?           @relation("PaymentInstrumentChequeBankBranch", fields: [chequeBankBranchId], references: [id])
  chequeItem         ChequeItem?           @relation(fields: [chequeItemId], references: [id])
  chequeBookLeaf     ChequeBookLeaf?       @relation(fields: [chequeBookLeafId], references: [id])
  currency           Currency              @relation(fields: [currencyId], references: [id])
  payableChequeType  PayableChequeType?    @relation(fields: [payableChequeTypeId], references: [id])
  payment            Payment               @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  settlementLines    PaymentSettlementLine[]
  accountingLines    PaymentAccountingLine[]
}

// هم‌الگوی ReceiptSettlementLine («موضوعات پرداخت»): هر ردیف به یک PaymentType، یک ردیف ابزار (قلم)، یک طرف حساب
// مستقل، و (بسته به PaymentType.basisType) دقیقاً یکی از اسناد مبنا وصل می‌شود. exchangeGainLoss با علامتِ «پرداخت»
// (منفی = زیان) طبق Documents/نحوه محاسبه تسعیر ارز.md نگهداری می‌شود.
model PaymentSettlementLine {
  id                Int                   @id @default(autoincrement())
  paymentId         Int
  rowOrder          Int                   @default(0)
  paymentTypeId     Int
  instrumentLineId  Int
  // برای ماهیت‌های «به بانک»/«به صندوق»/«به تنخواه» به‌جای طرف حساب، بانک/صندوق/تنخواه‌دار پر می‌شود و partyId خالی است
  partyId           Int?
  bankAccountId     Int?
  cashBoxId         Int?
  custodianId       Int?
  salesInvoiceId    Int?
  purchaseInvoiceId Int?
  /// فاکتور خرید خدمات به‌عنوان سند مبنا (برای نوع پرداخت با مبنای «فاکتور خرید»؛ هم‌زمان با purchaseInvoiceId پر نمی‌شود)
  servicePurchaseInvoiceId Int?
  purchaseOrderId   Int?
  currencyId        Int
  fxRate            Decimal               @default(1) @db.Decimal(18, 6)
  amount            Decimal               @db.Decimal(18, 2)
  exchangeGainLoss  Decimal               @default(0) @db.Decimal(18, 2)
  description       String?
  paymentType       PaymentType           @relation(fields: [paymentTypeId], references: [id])
  payment           Payment               @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  instrumentLine    PaymentInstrumentLine @relation(fields: [instrumentLineId], references: [id])
  party             Party?                @relation(fields: [partyId], references: [id])
  bankAccount       BankAccount?          @relation("PaymentSettlementBankAccount", fields: [bankAccountId], references: [id], onDelete: Restrict)
  cashBox           CashBox?              @relation("PaymentSettlementCashBox", fields: [cashBoxId], references: [id], onDelete: Restrict)
  custodian         PettyCashCustodian?   @relation(fields: [custodianId], references: [id], onDelete: Restrict)
  salesInvoice      SalesInvoice?         @relation(fields: [salesInvoiceId], references: [id])
  purchaseInvoice   PurchaseInvoice?      @relation(fields: [purchaseInvoiceId], references: [id])
  servicePurchaseInvoice ServicePurchaseInvoice? @relation(fields: [servicePurchaseInvoiceId], references: [id], onDelete: Restrict)
  purchaseOrder     PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  currency          Currency              @relation(fields: [currencyId], references: [id])
  advanceAllocations PurchaseInvoiceAdvanceAllocation[]
  servicePurchaseAdvanceAllocations ServicePurchaseInvoiceAdvanceAllocation[]
  accountingLines   PaymentAccountingLine[]
}

