model PurchaseType {
  id                             Int                              @id @default(autoincrement())
  code                           Int                              @unique
  title                          String                           @unique
  nature                         PurchaseNature
  hasTransactions                Boolean                          @default(false)
  createdAt                      DateTime                         @default(now())
  purchaseInvoices               PurchaseInvoice[]
  servicePurchaseInvoices        ServicePurchaseInvoice[]
