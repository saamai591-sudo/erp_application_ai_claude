model SupplyRequestLine {
  id                       Int                     @id @default(autoincrement())
  supplyRequestId          Int
  rowOrder                 Int                     @default(0)
  sourceGoodsRequestLineId Int?
  goodsItemId              Int
  unitId                   Int
  quantity                 Decimal                 @db.Decimal(36, 10)
  description              String?
  purchaseRequestLines     PurchaseRequestLine[]   @relation("PurchaseRequestSourceLine")
  goodsItem                GoodsItem               @relation(fields: [goodsItemId], references: [id])
  sourceGoodsRequestLine   GoodsRequestLine?       @relation("SupplyRequestSourceLine", fields: [sourceGoodsRequestLineId], references: [id])
  supplyRequest            SupplyRequest           @relation(fields: [supplyRequestId], references: [id], onDelete: Cascade)
  unit                     UnitOfMeasure           @relation(fields: [unitId], references: [id])
  warehouseReceiptLines    WarehouseReceiptLine[]  @relation("WarehouseReceiptSourceSupplyRequestLine")
  inventoryLines           InventoryDocumentLine[] @relation("InventoryLineSourceSupplyRequestLine")
}

model PurchaseRoute {
  id                Int                 @id @default(autoincrement())
  code              Int                 @unique
  title             String              @unique
  nature            PurchaseRouteNature
  isActive          Boolean             @default(true)
  hasTransactions   Boolean             @default(false)
  createdAt         DateTime            @default(now())
