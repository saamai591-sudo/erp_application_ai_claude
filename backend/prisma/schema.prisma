// =========================================================================
// stockAnalysis.md — شمای یکپارچه‌ی اسناد انبار (فاز ۲، بخش افزایشی/additive)
// طبق تصمیم صریح کاربر: بجای ۶ جدول جداگانه‌ی سند انبار (بالا)، این دو مدل یک جدول واحد برای همه‌ی
// انواع سند انبار می‌سازند (بند ۲۸-۲۹ و ۶۴ سند). این فاز فقط اسکیمای جدید را اضافه می‌کند — جدول‌های
// قدیمی (WarehouseReceipt/Issue/Transfer/Adjustment/InitialInventory/SalesDeliveryLine) دست‌نخورده
// باقی مانده‌اند اما همه‌ی route/serviceهای فعلی از فاز ۲ به بعد از InventoryDocument می‌خوانند/
// می‌نویسند؛ جدول‌های قدیمی همیشه خالی و بلااستفاده‌اند (کد فقط برای جلوگیری از حذف مخرب نگه داشته
// شده). اتصال دوطرفه‌ی purchaseInvoiceLine/salesInvoiceLines که قبلاً روی WarehouseReceiptLine/
// SalesDeliveryLine بود، در فاز پیگیری «رفع خلأ شناخته‌شده» به همین دو فیلد پایین (روی
// InventoryDocumentLine) منتقل شد.
// =========================================================================

// طبق stockAnalysis.md بند ۳۴ («انواع عملیات انبار») — لیست کامل و مرجع. WAREHOUSE_ISSUE عمومی قدیم
// (فاز ۲) با سه نوع اختصاصی‌تر مصرف (CENTER/PROJECT/PRODUCTION_CONSUMPTION) جایگزین شده چون بند ۳۴
// اصلاً چنین نوع عمومی‌ای را نمی‌شناسد؛ WAREHOUSE_ADJUSTMENT (که Inventory Count Surplus/Shortage بند
// ۳۴ را با یک مقدار امضادار در یک نوع واحد پوشش می‌دهد) از فاز ۲ بدون تغییر مانده چون بند ۴۵ صریحاً
// می‌گوید «نوع مستقلی به نام Manual Adjustment ایجاد نمی‌شود» و تفکیک آن به دو نوع جدا فایده‌ی
// رفتاری‌ای اضافه نمی‌کرد.
enum InventoryDocumentType {
  INITIAL_INVENTORY
  WAREHOUSE_RECEIPT // Purchase Receipt
  WAREHOUSE_TRANSFER_OUT // Warehouse Transfer — sending side (deducts source warehouse)
  WAREHOUSE_TRANSFER_IN // Warehouse Transfer — receiving side (adds to destination warehouse), references WAREHOUSE_TRANSFER_OUT lines
  WAREHOUSE_ADJUSTMENT // Inventory Count Surplus (فقط مازاد — کسری در INVENTORY_COUNTING_SHORTAGE ثبت می‌شود)
  INVENTORY_COUNTING_SHORTAGE // Inventory Count Shortage — سند مستقل، بدون مبنا، بدون تایید حسابداری فردی (فقط تایید انبار دسته‌ای)
  SALES_DELIVERY // Sales Issue
  SALES_RETURN
  SUPPLIER_RETURN
  PRODUCTION_RECEIPT
  CENTER_CONSUMPTION
  PROJECT_CONSUMPTION
  PRODUCTION_CONSUMPTION
  CENTER_CONSUMPTION_RETURN
  PROJECT_CONSUMPTION_RETURN
  PRODUCTION_CONSUMPTION_RETURN
  FIXED_ASSET_ISSUE
}

// اجتماع WarehouseReceiptBasis + WarehouseIssueBasis + SalesDeliveryBasis — هر documentType فقط
// زیرمجموعه‌ی مربوط به خودش را معنادار می‌داند (کنترل در سطح اپلیکیشن، نه دیتابیس)
enum InventoryBasis {
  NO_BASIS
  SUPPLY_REQUEST
  PURCHASE_ORDER
  DELIVERY_AUTHORIZATION
  GOODS_REQUEST
  SALES_ORDER
  // حواله فروش بر مبنای پیش‌فاکتور (ردیف‌ها به SalesQuoteLine ارجاع می‌دهند)
  SALES_QUOTE
  WAREHOUSE_TRANSFER_OUT
}

model InventoryDocument {
  id                Int                      @id @default(autoincrement())
  documentType      InventoryDocumentType
  warehouseId       Int?
  sourceWarehouseId Int?
  destWarehouseId   Int?
  fiscalPeriodId    Int
  number            Int
  date              DateTime                 @db.Date
  basis             InventoryBasis?
  // به‌جای سه فیلد جدا (partyId/costCenterId/projectId) که هرکدام به یک جدول متفاوت ارجاع می‌داد، طبق
  // همان الگوی «کد تفصیل» که در JournalEntryLine (detail1Code/…) و DetailCodeUsage از قبل وجود دارد،
  // یک فیلد واحد استفاده می‌شود؛ هر نوع سند همیشه دقیقاً یکی از انواع تفصیل (طرف حساب/مرکز هزینه/پروژه)
  // را ست می‌کند، هرگز بیش از یکی — رزولوشن به موجودیت واقعی از طریق DetailCodeUsage.code انجام می‌شود.
  detailCode        String?
  description       String?
  creationType      WarehouseDocCreationType @default(MANUAL)
  status            WarehouseDocStatus       @default(REGISTERED)
  // فقط وقتی سند واقعاً Finalized می‌شود پر می‌شود (رسید انبار خرید: با «تایید حسابداری»؛ بقیه‌ی انواع:
  // با «تایید انبار» دسته‌ای) — دیگر در لحظه‌ی ایجاد سند پر نمی‌شود.
  finalizedAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @default(now()) @updatedAt
  warehouse         Warehouse?               @relation("InventoryDocWarehouse", fields: [warehouseId], references: [id])
  sourceWarehouse   Warehouse?               @relation("InventoryDocSourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destWarehouse     Warehouse?               @relation("InventoryDocDestWarehouse", fields: [destWarehouseId], references: [id])
  fiscalPeriod      FiscalPeriod             @relation(fields: [fiscalPeriodId], references: [id])
  lines             InventoryDocumentLine[]
  purchaseCostLines PurchaseCostLine[]

  @@unique([documentType, fiscalPeriodId, number])
}

model InventoryDocumentLine {
  id                                Int                        @id @default(autoincrement())
  documentId                        Int
  rowOrder                          Int                        @default(0)
  goodsItemId                       Int
  unitId                            Int
  quantity                          Decimal                    @db.Decimal(36, 10)
  description                       String?
  physicalLocationId                Int?
  sourceSupplyRequestLineId         Int?
  sourcePurchaseOrderLineId         Int?
  sourceDeliveryAuthorizationLineId Int?
  sourceGoodsRequestLineId          Int?
  sourceSalesOrderLineId            Int?
  sourceSalesQuoteLineId            Int?
  // طبق بند ۴۰ سند: «هر برگشت باید به خروج/ورود مرتبط خود Reference داشته باشد» + کنترل
  // ReturnedQuantity <= IssuedQuantity — این ۵ فیلد خودارجاع (self-relation روی همین جدول) دقیقاً
  // همان قاعده را برای هر ۵ نوع سند «برگشتی» (Sales Return/Supplier Return/۳ نوع Consumption Return)
  // پیاده می‌کنند؛ بند ۳۴ برای بقیه‌ی انواع چنین ارجاعی نمی‌خواهد.
  sourceSalesDeliveryLineId         Int?
  sourceWarehouseReceiptLineId      Int?
  sourceCenterConsumptionLineId     Int?
  sourceProjectConsumptionLineId    Int?
  sourceProductionConsumptionLineId Int?
  sourceWarehouseTransferOutLineId  Int?
  document                          InventoryDocument          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  goodsItem                         GoodsItem                  @relation(fields: [goodsItemId], references: [id])
  unit                              UnitOfMeasure              @relation(fields: [unitId], references: [id])
  physicalLocation                  PhysicalLocation?          @relation(fields: [physicalLocationId], references: [id])
  sourceSupplyRequestLine           SupplyRequestLine?         @relation("InventoryLineSourceSupplyRequestLine", fields: [sourceSupplyRequestLineId], references: [id])
  sourcePurchaseOrderLine           PurchaseOrderLine?         @relation("InventoryLineSourcePurchaseOrderLine", fields: [sourcePurchaseOrderLineId], references: [id])
  sourceDeliveryAuthorizationLine   DeliveryAuthorizationLine? @relation("InventoryLineSourceDeliveryAuthorizationLine", fields: [sourceDeliveryAuthorizationLineId], references: [id])
  sourceGoodsRequestLine            GoodsRequestLine?          @relation("InventoryLineSourceGoodsRequestLine", fields: [sourceGoodsRequestLineId], references: [id])
  sourceSalesOrderLine              SalesOrderLine?            @relation("InventoryLineSourceSalesOrderLine", fields: [sourceSalesOrderLineId], references: [id])
  sourceSalesQuoteLine              SalesQuoteLine?            @relation("InventoryLineSourceSalesQuoteLine", fields: [sourceSalesQuoteLineId], references: [id])
  sourceSalesDeliveryLine           InventoryDocumentLine?     @relation("InventoryLineSourceSalesDeliveryLine", fields: [sourceSalesDeliveryLineId], references: [id])
  salesReturnLines                  InventoryDocumentLine[]    @relation("InventoryLineSourceSalesDeliveryLine")
  sourceWarehouseReceiptLine        InventoryDocumentLine?     @relation("InventoryLineSourceWarehouseReceiptLine", fields: [sourceWarehouseReceiptLineId], references: [id])
  supplierReturnLines               InventoryDocumentLine[]    @relation("InventoryLineSourceWarehouseReceiptLine")
  sourceCenterConsumptionLine       InventoryDocumentLine?     @relation("InventoryLineSourceCenterConsumptionLine", fields: [sourceCenterConsumptionLineId], references: [id])
  centerConsumptionReturnLines      InventoryDocumentLine[]    @relation("InventoryLineSourceCenterConsumptionLine")
  sourceProjectConsumptionLine      InventoryDocumentLine?     @relation("InventoryLineSourceProjectConsumptionLine", fields: [sourceProjectConsumptionLineId], references: [id])
  projectConsumptionReturnLines     InventoryDocumentLine[]    @relation("InventoryLineSourceProjectConsumptionLine")
  sourceProductionConsumptionLine   InventoryDocumentLine?     @relation("InventoryLineSourceProductionConsumptionLine", fields: [sourceProductionConsumptionLineId], references: [id])
  productionConsumptionReturnLines  InventoryDocumentLine[]    @relation("InventoryLineSourceProductionConsumptionLine")
  // بر خلاف ۵ نوع برگشتی بالا (که پیش‌فرض Prisma یعنی ON DELETE SET NULL دارند)، اینجا عمداً Restrict
  // انتخاب شده: طبق درخواست صریح کاربر، سند «ارسال» که یک سند «دریافت» به آن ارجاع دارد باید کاملاً
  // قفل باشد (نه فقط ارجاع یتیم شود) — کنترل کامل هم در سطح دیتابیس (این FK) و هم در سطح اپلیکیشن
  // (warehouseTransferOut.ts: delete/revert/update) اعمال می‌شود.
  sourceWarehouseTransferOutLine    InventoryDocumentLine?     @relation("InventoryLineSourceWarehouseTransferOutLine", fields: [sourceWarehouseTransferOutLineId], references: [id], onDelete: Restrict)
  transferInLines                   InventoryDocumentLine[]    @relation("InventoryLineSourceWarehouseTransferOutLine")
  serials                           InventoryLineSerial[]
  batches                           InventoryLineBatch[]
  purchaseInvoiceLine               PurchaseInvoiceLine?       @relation("PurchaseInvoiceSourceInventoryLine")
  salesInvoiceLines                 SalesInvoiceLine[]         @relation("SalesInvoiceSourceInventoryLine")
  salesReturnInvoiceLines           SalesReturnInvoiceLine[]   @relation("SalesReturnInvoiceSourceInventoryLine")
  // تاریخچه‌ی append-only مبلغ این ردیف — طبق Documents/WareHouseAmountChanges.md: دیگر هیچ ستون
  // unitCost/amount خامی روی خودِ این جدول نیست؛ مبلغ فعلی = SUM(DocumentItemAmount.difference) و
  // فی واحد = آن مجموع ÷ quantity، همیشه محاسبه‌شده، هرگز ذخیره‌شده — نگاه کنید به
  // services/documentItemAmountService.ts. جایگزین کامل GoodsPricingAdjustment سابق است.
  amounts                            DocumentItemAmount[]
  purchaseCostAllocations            PurchaseCostAllocation[]
}

// طبق بند ۱۷-۱۹ سند: یک سطر سند می‌تواند چند سریال داشته باشد (نه یک سطر جدا برای هر سریال). serialStep
// دقیقاً هم‌الگوی chequeStep (نگاه کنید به توضیح بالای Serial.step) — مقدار Serial.step را در لحظه‌ی
// ایجاد همین ارتباط ثبت می‌کند تا فقط «آخرین رویداد» یک سریال قابل برگشت باشد.
model InventoryLineSerial {
  id         Int                   @id @default(autoincrement())
  lineId     Int
  serialId   Int
  serialStep Int
  line       InventoryDocumentLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  serial     Serial                @relation(fields: [serialId], references: [id])

  @@unique([lineId, serialId])
}

// طبق «انتخاب سریال و بچ»: یک سطر سند می‌تواند چند بچ داشته باشد، هرکدام با تعداد اختصاصی خودش
// (جمع quantity این ردیف‌ها باید با مقدار سطر سند برابر باشد) — دقیقاً هم‌الگوی InventoryLineSerial،
// فقط با یک فیلد quantity اضافه؛ جایگزین فیلد اسکالر قبلی InventoryDocumentLine.batchId.
model InventoryLineBatch {
  id       Int                   @id @default(autoincrement())
  lineId   Int
  batchId  Int
  quantity Decimal               @db.Decimal(36, 10)
  line     InventoryDocumentLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  batch    Batch                 @relation(fields: [batchId], references: [id])

  @@unique([lineId, batchId])
}

// «تایید انبار» / «برگشت از تایید» — طبق سند تایید انبار.md: هدف Snapshot گرفتن موجودی تا یک تاریخ و
// جلوگیری از تغییر اسناد آن دوره است، نه غیرفعال‌کردن انبار. طبق تصمیم صریح کاربر، بدون تاریخچه —
// هر انبار دقیقاً یک تاریخ تایید (Warehouse.confirmedDate) و یک Snapshot جاری دارد که با هر تایید/
// برگشت از تایید، جایگزین (نه اضافه) می‌شود.
model WarehouseConfirmationLine {
  id          Int       @id @default(autoincrement())
  warehouseId Int
  goodsItemId Int
  quantity    Decimal   @db.Decimal(36, 10)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  goodsItem   GoodsItem @relation(fields: [goodsItemId], references: [id])

  @@unique([warehouseId, goodsItemId])
}

// طبق مستند «قیمت‌گذاری اسناد انبار» (بند ۱۲): کلید منطقی وضعیت قیمت‌گذاری = ReportingPeriod + Item
// (بدون انبار). وجود این رکورد یعنی «این کالا در این دوره قیمت‌گذاری شده است».
model GoodsPricingStatus {
  id                Int                  @id @default(autoincrement())
  goodsItemId       Int
  reportingPeriodId Int
  pricedAt          DateTime             @default(now())
  createdById       Int?
  goodsItem         GoodsItem            @relation(fields: [goodsItemId], references: [id])
  reportingPeriod   ReportingPeriod      @relation(fields: [reportingPeriodId], references: [id])
  createdBy         User?                @relation(fields: [createdById], references: [id])
  // هر ردیف DocumentItemAmount که موتور قیمت‌گذاری در این اجرا نوشته (priceType=ENGINE_PRICING یا
  // ENGINE_CORRECTION) به همین‌جا وصل است — تنها راهی که revertItem می‌تواند دقیقاً «فقط اثر همین
  // اجرا» را حذف کند، بدون دست‌زدن به رکوردهای اجراهای دیگر یا مقادیر دستی کاربر.
  amounts           DocumentItemAmount[]

  @@unique([goodsItemId, reportingPeriodId])
}

// طبق Documents/WareHouseAmountChanges.md: جایگزین کامل GoodsPricingAdjustment سابق. تاریخچه‌ی
// append-only مبلغ هر ردیف سند انبار (هر ۱۷ نوع، نه فقط ۴ نوع کاربر-قیمت‌گذار) — هرگز رکورد قبلی
// overwrite/silently نمی‌شود؛ هر تغییر مبلغ (چه دستی، چه موتور قیمت‌گذاری، چه اثر جانبی تایید فاکتور
// خرید) یک ردیف تازه اضافه می‌کند. مبلغ فعلی یک ردیف = SUM(difference)، فی واحد = آن مجموع ÷ مقدار —
// نگاه کنید به services/documentItemAmountService.ts (تنها نقطه‌ی نوشتن/خواندن این جدول).
enum DocumentAmountPriceType {
  USER_ENTRY       // مبلغ دستی کاربر (۴ نوع سند کاربر-قیمت‌گذار: موجودی اول دوره/رسید انبار خرید/رسید تولید/اضافات انبارگردانی)
  ENGINE_PRICING   // موتور قیمت‌گذاری (کاردکس میانگین موزون) — ردیف در دوره‌ی هنوز قفل‌نشده
  ENGINE_CORRECTION // موتور قیمت‌گذاری روی ردیفی که قبلاً در دوره‌ای زودتر قفل شده بود (اصلاحیه)
  CROSS_ENTITY     // اثر جانبی تایید/برگشت‌ازتایید فاکتور خرید (ردیف‌های کالای خودِ فاکتور) روی ردیف رسید انبار خرید مرتبط
  // اثر تایید/برگشت‌ازتایید ردیف‌های PurchaseCostLine (سایر هزینه‌های فاکتور خرید کالا + فاکتور خرید
  // خدمات، هر دو) — طبق Documents/ServicePurchaseAndItsRelationToStockReceipt.md، برخلاف CROSS_ENTITY
  // (که مبلغ نهایی رسید را «جایگزین» می‌کند)، این نوع همیشه فقط «افزوده» می‌شود (Difference = مبلغ
  // تخصیص‌یافته، هرگز newAmount محاسبه‌شده‌ی مطلق)
  INBOUND_RELATED_COST
  MIGRATED         // فقط رکورد یک‌بارِ backfill داده‌های قبل از این مدل
}

model DocumentItemAmount {
  id                                     Int                                   @id @default(autoincrement())
  lineId                                 Int
  priceType                              DocumentAmountPriceType
  amount                                 Decimal                               @db.Decimal(18, 2)
  difference                             Decimal                               @db.Decimal(18, 2)
  effectiveDate                          DateTime                              @default(now())
  journalEntryId                         Int?
  // فقط تا وقتی این ردیف داخل فرم «صدور سند حسابداری» (اسناد انبار) ذخیره شده — چه هنوز صادر نشده (پیش‌نویس)
  // چه صادرشده — تا آن فرم بتواند دقیقاً همان ردیف‌های ذخیره‌شده‌ی خودش را (نه یک کوئری تازه) بازیابی/صادر
  // کند؛ با حذف کامل آن پیش‌نویس (قبل از صدور) این فیلد دوباره null می‌شود (SetNull، نه Cascade — طبق
  // Documents/WareHouseAmountChanges.md این جدول append-only است، خودِ ردیف هرگز حذف نمی‌شود).
  warehouseJournalEntryIssuanceId        Int?
  // فقط برای priceType=ENGINE_PRICING/ENGINE_CORRECTION — نگاه کنید به یادداشت amounts روی GoodsPricingStatus
  goodsPricingStatusId                   Int?
  // فقط برای priceType=INBOUND_RELATED_COST — ردیابی به ردیف تخصیص PurchaseCostLine (فاکتور خرید کالا یا
  // فاکتور خرید خدمات) که این رکورد را ایجاد کرده
  purchaseCostAllocationId               Int?
  createdAt                              DateTime                              @default(now())
  createdById                            Int?
  line                                   InventoryDocumentLine                 @relation(fields: [lineId], references: [id], onDelete: Cascade)
  journalEntry                           JournalEntry?                         @relation(fields: [journalEntryId], references: [id])
  warehouseJournalEntryIssuance          WarehouseJournalEntryIssuance?        @relation(fields: [warehouseJournalEntryIssuanceId], references: [id], onDelete: SetNull)
  goodsPricingStatus                     GoodsPricingStatus?                   @relation(fields: [goodsPricingStatusId], references: [id], onDelete: Cascade)
  // onDelete عمداً SetNull است، نه Cascade: این جدول تاریخچه‌ی append-only مبلغ ردیف رسید است (طبق
  // Documents/WareHouseAmountChanges.md) — حذف بعدیِ فاکتور خریدِ ایجادکننده (مجاز فقط در وضعیت «ثبت»،
  // از جمله بعد از یک چرخه‌ی تایید→برگشت‌ازتایید) هرگز نباید رکوردهای این جدول را که به ردیف یک سند
  // کاملاً دیگر (رسید انبار) متعلق‌اند نابود کند؛ فقط ارجاع ردیابی (کدام فاکتور/تخصیص) پاک می‌شود، خودِ
  // Amount/Difference برای همیشه باقی می‌ماند.
  purchaseCostAllocation                 PurchaseCostAllocation?               @relation(fields: [purchaseCostAllocationId], references: [id], onDelete: SetNull)
  createdBy                              User?                                 @relation(fields: [createdById], references: [id])

  @@index([lineId])
  @@index([warehouseJournalEntryIssuanceId])
}

// جدول موقت/کش — نه تاریخچه: طبق تصمیم صریح کاربر، هر بار که «قیمت‌گذاری اسناد انبار» با دکمه‌ی «لود
// اطلاعات» بارگذاری می‌شود، کل این جدول (نه فقط ردیف‌های همین دوره) پاک و دوباره از صفر پر می‌شود —
// نگاشت «این کالا، در این دوره، در کدام انبارها گردش (سند مؤثر در قیمت‌گذاری) داشته». هدف: وقتی کاربر
// ردیف‌ها را انتخاب می‌کند و دکمه‌ی «قیمت‌گذاری» را می‌زند، لایه‌ی اعتبارسنجی (goodsPricingValidation.ts)
// بتواند انبارهای مرتبط با کالاهای انتخاب‌شده را از همین جدول بخواند، بدون کوئری دوباره‌ی
// InventoryDocumentLine. این فقط یک بهینه‌سازی «پیش‌بررسیِ سریع» است؛ تضمین نهایی صحت («آیا واقعاً همه‌ی
// انبارهای مؤثر تایید شده‌اند») همچنان در لحظه‌ی اجرای priceItem/revertItem — با داده‌ی زنده‌ی همان لحظه،
// نه این کش — انجام می‌شود (نگاه کنید به یادداشت‌های goodsPricingService.ts).
model GoodsPricingFlowWarehouse {
  id                Int             @id @default(autoincrement())
  goodsItemId       Int
  reportingPeriodId Int
  warehouseId       Int
  goodsItem         GoodsItem       @relation(fields: [goodsItemId], references: [id], onDelete: Cascade)
  reportingPeriod   ReportingPeriod @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)
  warehouse         Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([goodsItemId, reportingPeriodId, warehouseId])
}

model SalesInvoice {
  paymentSettlementLines PaymentSettlementLine[]
  id                     Int                     @id @default(autoincrement())
  fiscalPeriodId         Int
  number                 Int
  date                   DateTime                @db.Date
  basis                  SalesInvoiceBasis
  customerId             Int
  salesTypeId            Int
  salesCenterId          Int
  currencyId             Int
  /// نرخ تبدیل ارز فاکتور به ارز مبنا — دقیقاً هم‌الگوی PurchaseInvoice.fxRate (کاربر وارد می‌کند، نه از
  /// جدول نرخ ارز؛ اگر ارز فاکتور همان ارز مبنا باشد همیشه ۱ ذخیره می‌شود).
  fxRate                 Decimal                 @default(1) @db.Decimal(18, 6)
  description            String?
  status                 SalesDocStatus          @default(DRAFT)
  journalEntryId         Int?                    @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @default(now()) @updatedAt
  receiptSettlementLines ReceiptSettlementLine[]
  currency               Currency                @relation(fields: [currencyId], references: [id])
  customer               Customer                @relation(fields: [customerId], references: [id])
  salesType              SalesType               @relation(fields: [salesTypeId], references: [id])
  salesCenter            SalesCenter             @relation(fields: [salesCenterId], references: [id])
  fiscalPeriod           FiscalPeriod            @relation(fields: [fiscalPeriodId], references: [id])
  journalEntry           JournalEntry?           @relation(fields: [journalEntryId], references: [id])
  lines                  SalesInvoiceLine[]
  advanceAllocations     SalesInvoiceAdvanceAllocation[]
  pettyCashPayments      PettyCashPayment[]
  pettyCashSummaryLines  PettyCashSummaryLine[]

  @@unique([fiscalPeriodId, number])
}

model SalesInvoiceLine {
  id                    Int                    @id @default(autoincrement())
  salesInvoiceId        Int
  rowOrder              Int                    @default(0)
  sourceInventoryLineId Int?
  goodsItemId           Int
  unitId                Int
  quantity              Decimal                @db.Decimal(36, 10)
  unitPrice             Decimal                @db.Decimal(36, 10)
  amount                Decimal                @db.Decimal(36, 10)
  discount              Decimal                @default(0) @db.Decimal(36, 10)
  /// amount/discount به ارز مبنا — دقیقاً هم‌الگوی PurchaseInvoiceLine.baseAmount/baseDiscount: فقط برای
  /// بایگانی/محاسبات (از جمله ارزش‌افزوده که همیشه به ارز مبنا محاسبه می‌شود) نگه داشته می‌شود؛ در UI
  /// نگهداری نمی‌شود و در پاسخ API هم برنمی‌گردد، با هر ذخیره‌ی فاکتور بازمحاسبه می‌شود.
  baseAmount            Decimal                @db.Decimal(36, 10)
  baseDiscount          Decimal                @default(0) @db.Decimal(36, 10)
  vatAmount             Decimal                @default(0) @db.Decimal(36, 10)
  description           String?
  goodsItem             GoodsItem              @relation(fields: [goodsItemId], references: [id])
  salesInvoice          SalesInvoice           @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  sourceInventoryLine   InventoryDocumentLine? @relation("SalesInvoiceSourceInventoryLine", fields: [sourceInventoryLineId], references: [id])
  unit                  UnitOfMeasure          @relation(fields: [unitId], references: [id])
}

// فاکتور برگشت از فروش — طبق تصمیم صریح کاربر، دقیقاً هم‌ساختار/هم‌رفتار SalesInvoice (پایه/ارز/تخفیف/
// ارزش‌افزوده/عدم وجود اکشن تایید/صدور مستقیم سند حسابداری از DRAFT)، فقط با مبنای «برگشت از فروش»
// (سند انبار SALES_RETURN — نگاه کنید به routes/salesReturns.ts، که طبق تصمیم صریح کاربر در کار دیگری
// دست‌نخورده می‌ماند) به‌جای «حواله فروش». مدل کاملاً مستقل از SalesInvoice است (نه جدول مشترک، برخلاف
// PurchaseCostLine) — عمداً، چون کاربر این‌بار درخواست اشتراک جدول نداده. sourceInventoryLineId دقیقاً
// هم‌الگوی SalesInvoiceLine (nullable، نه @unique — الگوی «مانده»، چون یک ردیف برگشت ممکن است طی چند
// فاکتور برگشت جداگانه صورتحساب شود).
model SalesReturnInvoice {
  id             Int                      @id @default(autoincrement())
  fiscalPeriodId Int
  number         Int
  date           DateTime                 @db.Date
  basis          SalesReturnInvoiceBasis
  customerId     Int
  salesTypeId    Int
  salesCenterId  Int
  currencyId     Int
  /// نرخ تبدیل ارز فاکتور به ارز مبنا — دقیقاً هم‌الگوی SalesInvoice.fxRate.
  fxRate         Decimal                  @default(1) @db.Decimal(18, 6)
  description    String?
  status         SalesDocStatus           @default(DRAFT)
  journalEntryId Int?                     @unique
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @default(now()) @updatedAt
  currency       Currency                 @relation(fields: [currencyId], references: [id])
  customer       Customer                 @relation(fields: [customerId], references: [id])
  salesType      SalesType                @relation(fields: [salesTypeId], references: [id])
  salesCenter    SalesCenter              @relation(fields: [salesCenterId], references: [id])
  fiscalPeriod   FiscalPeriod             @relation(fields: [fiscalPeriodId], references: [id])
  journalEntry   JournalEntry?            @relation(fields: [journalEntryId], references: [id])
  lines          SalesReturnInvoiceLine[]

  @@unique([fiscalPeriodId, number])
}

model SalesReturnInvoiceLine {
  id                    Int                    @id @default(autoincrement())
  salesReturnInvoiceId  Int
  rowOrder              Int                    @default(0)
  sourceInventoryLineId Int?
  goodsItemId           Int
  unitId                Int
  quantity              Decimal                @db.Decimal(36, 10)
  unitPrice             Decimal                @db.Decimal(36, 10)
  amount                Decimal                @db.Decimal(36, 10)
  discount              Decimal                @default(0) @db.Decimal(36, 10)
  /// amount/discount به ارز مبنا — دقیقاً هم‌الگوی SalesInvoiceLine.baseAmount/baseDiscount.
  baseAmount            Decimal                @db.Decimal(36, 10)
  baseDiscount          Decimal                @default(0) @db.Decimal(36, 10)
  vatAmount             Decimal                @default(0) @db.Decimal(36, 10)
  description           String?
  goodsItem             GoodsItem              @relation(fields: [goodsItemId], references: [id])
  salesReturnInvoice    SalesReturnInvoice     @relation(fields: [salesReturnInvoiceId], references: [id], onDelete: Cascade)
  sourceInventoryLine   InventoryDocumentLine? @relation("SalesReturnInvoiceSourceInventoryLine", fields: [sourceInventoryLineId], references: [id])
  unit                  UnitOfMeasure          @relation(fields: [unitId], references: [id])
}

model ChequeItem {
  id                      Int                            @id @default(autoincrement())
  direction               ChequeDirection
  number                  String
  dueDate                 DateTime                       @db.Date
  bankBranchId            Int?
  ownerBankAccountId      Int?
  partyId                 Int
  amount                  Decimal                        @db.Decimal(18, 2)
  currencyId              Int
  status                  ChequeStatus                   @default(IN_HAND)
  // شمارنده‌ی نسخه (فاز ۲.۲): با هر رویداد چرخه‌ی عمر (ایجاد، خرج/ظهرنویسی، واگذاری، برگشت از
  // واگذاری، نتیجه وصول/برگشت) یک واحد بالا می‌رود. همان مقدار روی ردیف سندی که آن رویداد را ایجاد
  // کرده (فیلد chequeStep در ۶ جدول ردیف مرتبط) هم ذخیره می‌شود؛ فقط وقتی chequeStep یک ردیف با
  // step فعلی همین چک برابر باشد، آن ردیف «آخرین اتفاق» برای این چک است و بدون برگشت از تایید کل
  // سند مادر، مستقیماً از همان سند قابل ویرایش/حذف (و افزودن ردیف تازه) است — نگاه کنید به توضیح
  // بالای هرکدام از فایل‌های routes/receipts.ts, payments.ts, chequeDeposits.ts,
  // chequeDepositReturns.ts, chequeClearingReceivable.ts, chequeClearingPayable.ts.
  step                    Int                            @default(1)
  // نوع چک (مستر «نوع چک دریافتی/پرداختی») — برای صدور سند حسابداری خرج‌کردن چک دریافتنی و چک پرداختنی:
  // receivableChequeTypeId از ردیف سند دریافت، payableChequeTypeId از ردیف سند پرداخت کپی می‌شود.
  receivableChequeTypeId  Int?
  payableChequeTypeId     Int?
  description             String?
  createdAt               DateTime                       @default(now())
  bankBranch              BankBranch?                    @relation(fields: [bankBranchId], references: [id])
  receivableChequeType    ReceivableChequeType?          @relation(fields: [receivableChequeTypeId], references: [id])
  payableChequeType       PayableChequeType?             @relation(fields: [payableChequeTypeId], references: [id])
  currency                Currency                       @relation(fields: [currencyId], references: [id])
  ownerBankAccount        BankAccount?                   @relation(fields: [ownerBankAccountId], references: [id])
  party                   Party                          @relation(fields: [partyId], references: [id])
  paymentInstrumentLines  PaymentInstrumentLine[]
  receiptInstrumentLines  ReceiptInstrumentLine[]
  depositLines            ChequeDepositLine[]
  depositReturnLines      ChequeDepositReturnLine[]
  clearingReceivableLines ChequeClearingReceivableLine[]
  clearingPayableLines    ChequeClearingPayableLine[]
  // طبق Documents/افتتاحیه دریافت و پرداخت و بستن سال.md: هر چک متعلق به یک دوره مالی است (فهرست‌ها و انتخابگرهای چک خودکار
  // به دوره مالی جاری محدود می‌شوند). چک‌های افتتاحیه (isOpening) یا دستی در «افتتاحیه دریافت و پرداخت» ثبت شده‌اند یا با
  // «بستن سال دریافت و پرداخت» از چک فعال سال قبل ساخته شده‌اند (parentChequeId → رکورد سال قبل، با همان شماره‌ی چک).
  fiscalPeriodId  Int
  fiscalPeriod    FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id])
  parentChequeId  Int?
  parentCheque    ChequeItem?  @relation("ChequeCarryForward", fields: [parentChequeId], references: [id], onDelete: SetNull)
  childCheques    ChequeItem[] @relation("ChequeCarryForward")
  isOpening       Boolean      @default(false)
  // فقط برای چک‌های افتتاحیه: «نوع دریافت»/«نوع پرداخت» (اختیاری)
  openingReceiptTypeId Int?
  openingPaymentTypeId Int?
