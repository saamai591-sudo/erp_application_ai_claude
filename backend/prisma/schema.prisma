model PurchaseInvoiceLine {
  id                    Int                    @id @default(autoincrement())
  purchaseInvoiceId     Int
  rowOrder              Int                    @default(0)
  sourceInventoryLineId Int?                   @unique
  goodsItemId           Int
  unitId                Int
  quantity              Decimal                @db.Decimal(36, 10)
  unitPrice             Decimal                @db.Decimal(36, 10)
  amount                Decimal                @db.Decimal(36, 10)
  discount              Decimal                @default(0) @db.Decimal(36, 10)
  /// amount/discount به ارز مبنا (amount|discount × fxRate هدر / baseVolume ارز فاکتور) — طبق تصمیم
  /// صریح کاربر فقط برای بایگانی/محاسبات (از جمله ارزش‌افزوده که همیشه به ارز مبنا محاسبه می‌شود) نگه
  /// داشته می‌شود؛ در UI نگهداری نمی‌شود و در پاسخ API هم برنمی‌گردد، فقط با هر ذخیره‌ی فاکتور بازمحاسبه
  /// می‌شود.
  baseAmount            Decimal                @db.Decimal(36, 10)
  baseDiscount          Decimal                @default(0) @db.Decimal(36, 10)
  vatAmount             Decimal                @default(0) @db.Decimal(36, 10)
  description           String?
  /// سهم این ردیف از اختلاف تسعیر پیش‌پرداخت خرید (Documents/تخصیص پیش‌پرداخت در فاکتور خرید.md) — فقط وقتی رویه‌ی معتبر در تاریخ فاکتور
  /// «تأثیر بر مبلغ معامله» باشد غیرصفر است؛ طبق تصمیم صریح کاربر به ارز مبناست (نه ارز amount) چون انبار مفهوم ارز ندارد،
  /// سیستمی و غیرنمایشی، با هر تایید/برگشت‌ازتایید فاکتور بازمحاسبه می‌شود.
  exchangeRateAdjustmentShare Decimal          @default(0) @db.Decimal(36, 10)
  /// baseAmount + exchangeRateAdjustmentShare، به ارز مبنا — طبق تصمیم صریح کاربر (نه ارز فاکتور)، چون تنها مصرف این مقدار
  /// قیمت‌گذاری CROSS_ENTITY رسید انبار در تایید فاکتور است و انبار هیچ ارزی جز ارز مبنا نمی‌شناسد؛ سند حسابداری
  /// (issue-journal-entry) وقتی معین موجودی خودش ارزی باشد، این مقدار را برعکس به ارز فاکتور برمی‌گرداند (نگاه کنید به
  /// یادداشت همان‌جا). سیستمی، غیرقابل‌ویرایش توسط کاربر و غیرنمایشی. بدون پیش‌پرداخت تخصیص‌یافته (یا رویه=سود/زیان تسعیر)
  /// همیشه برابر baseAmount است.
  cost                  Decimal                @default(0) @db.Decimal(36, 10)
  goodsItem             GoodsItem              @relation(fields: [goodsItemId], references: [id])
  purchaseInvoice       PurchaseInvoice        @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  sourceInventoryLine   InventoryDocumentLine? @relation("PurchaseInvoiceSourceInventoryLine", fields: [sourceInventoryLineId], references: [id])
  unit                  UnitOfMeasure          @relation(fields: [unitId], references: [id])
}

// طبق Documents/ServicePurchaseAndItsRelationToStockReceipt.md: مدل تسهیم/اثر تایید این سند («افزودن»
// یک ردیف Difference-only تازه به DocumentItemAmount؛ هر ردیف می‌تواند به رسید(های) دلخواه، نه لزوماً
// رسید(های) همین فاکتور، به‌صورت ۱-به-چند اشاره کند) کاملاً از فاکتور خرید کالا («جایگزینی» مبلغ نهایی
// رسید توسط PurchaseInvoiceLine.sourceInventoryLineId، ۱-به-۱) متفاوت بود — تا این‌که طبق تصمیم صریح
// کاربر، تب «سایر هزینه‌ها»ی فاکتور خرید کالا هم دقیقاً همین مدل/جدول را به اشتراک گرفت (نگاه کنید به
// PurchaseCostLine زیر)؛ دیگر دو مدل موازی مشابه (PurchaseInvoiceOtherCostLine سابق) وجود ندارد.
model ServicePurchaseInvoice {
  id                  Int                          @id @default(autoincrement())
  fiscalPeriodId      Int
  number              Int
  date                DateTime                     @db.Date
  vendorInvoiceNumber String?
  partyId             Int
  purchaseTypeId      Int
  currencyId          Int
  /// نرخ تبدیل ارز فاکتور به ارز مبنا — دقیقاً هم‌الگوی PurchaseInvoice.fxRate (کاربر وارد می‌کند، نه از
  /// جدول نرخ ارز؛ اگر ارز فاکتور همان ارز مبنا باشد همیشه ۱ ذخیره می‌شود).
  fxRate              Decimal                      @default(1) @db.Decimal(18, 6)
  description         String?
  status              RequestStatus                @default(DRAFT)
  approverId          Int?
  approvedAt          DateTime?
  journalEntryId      Int?                         @unique
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @default(now()) @updatedAt
  currency            Currency                     @relation(fields: [currencyId], references: [id])
  fiscalPeriod        FiscalPeriod                 @relation(fields: [fiscalPeriodId], references: [id])
  party               Party                        @relation(fields: [partyId], references: [id])
  purchaseType        PurchaseType                 @relation(fields: [purchaseTypeId], references: [id])
  approver            User?                        @relation("ServicePurchaseInvoiceApprover", fields: [approverId], references: [id])
  journalEntry        JournalEntry?                @relation(fields: [journalEntryId], references: [id])
  lines               PurchaseCostLine[]
  advanceAllocations  ServicePurchaseInvoiceAdvanceAllocation[]

  @@unique([fiscalPeriodId, number])
}

// جدول مشترک «ردیف هزینه» بین دو سند: تب «سایر هزینه‌ها»ی فاکتور خرید کالا (purchaseInvoiceId) و ردیف‌های
// فاکتور خرید خدمات (servicePurchaseInvoiceId) — طبق تصمیم صریح کاربر، دقیقاً یکی از این دو FK پر
// می‌شود (هرگز هر دو، هرگز هیچ‌کدام)؛ تضمین آن کاملاً روی nested-create هر روت تکیه دارد (هر روت فقط
// FK والد خودش را ست می‌کند)، نه یک CHECK level دیتابیس. باقی رفتار دقیقاً هم‌الگوی قبلی
// ServicePurchaseInvoiceLine (نگاه کنید به Documents/ServicePurchaseAndItsRelationToStockReceipt.md):
// بدون مبنا / رسید انبار؛ رسید انبار انتخاب‌شده کاملاً دلخواه است (نه لزوماً رسید سند والد)؛ تسهیم
// (allocations زیر) بین ردیف‌های همان رسید.
model PurchaseCostLine {
  id                       Int                     @id @default(autoincrement())
  purchaseInvoiceId        Int?
  servicePurchaseInvoiceId Int?
  rowOrder                 Int                     @default(0)
  serviceId                Int
  amount                   Decimal                 @db.Decimal(36, 10)
  discount                 Decimal                 @default(0) @db.Decimal(36, 10)
  /// amount/discount به ارز مبنا — دقیقاً هم‌الگوی PurchaseInvoiceLine.baseAmount/baseDiscount: فقط برای
  /// بایگانی/محاسبات (از جمله ارزش‌افزوده) نگه داشته می‌شود، در UI/پاسخ API نمی‌آید، با هر ذخیره بازمحاسبه می‌شود.
  baseAmount               Decimal                 @db.Decimal(36, 10)
  baseDiscount             Decimal                 @default(0) @db.Decimal(36, 10)
  vatAmount                Decimal                 @default(0) @db.Decimal(36, 10)
  // بدون مبنا / رسید انبار — طبق بند ۲ مستند، ساختار باید امکان افزودن مبناهای دیگر (مثل قرارداد) را در
  // آینده بدهد؛ چون این enum از قبل دقیقاً همین دو مقدار را دارد، دوباره استفاده شده (نه enum تازه).
  basis                    PurchaseInvoiceBasis    @default(NO_BASIS)
  // فقط وقتی basis=WAREHOUSE_RECEIPT پر می‌شود — رسید انبار انتخاب‌شده (سرصفحه، نه یک ردیف خاص)؛ تسهیم
  // بین همه‌ی ردیف‌های همین رسید انجام می‌شود (نگاه کنید به allocations زیر)
  sourceReceiptDocumentId  Int?
  // فقط وقتی basis=WAREHOUSE_RECEIPT پر می‌شود — نسبت مبلغ (VALUE) یا نسبت مقدار (QUANTITY)؛ WEIGHT این
  // enum برای این فرم معنا/کاربرد ندارد (کنترل در لایه‌ی اعتبارسنجی، نه دیتابیس)
  allocationMethod         CostAllocationBasis?
  description              String?
  purchaseInvoice          PurchaseInvoice?        @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  servicePurchaseInvoice   ServicePurchaseInvoice? @relation(fields: [servicePurchaseInvoiceId], references: [id], onDelete: Cascade)
  service                  GoodsItem               @relation(fields: [serviceId], references: [id])
  sourceReceiptDocument    InventoryDocument?      @relation(fields: [sourceReceiptDocumentId], references: [id])
  allocations              PurchaseCostAllocation[]
}

// لایه‌ی «Allocation» که مستند صریحاً بین ردیف فاکتور خرید خدمات و AmountLine خواسته (بند ۱۲): هر رکورد
// یعنی «از مبلغ این ردیف هزینه، این‌قدر به این ردیف رسید تخصیص یافته». با تایید فاکتور (هرکدام از دو
// سند بالا)، به‌ازای هر ردیف اینجا دقیقاً یک DocumentItemAmount (priceType=INBOUND_RELATED_COST) ساخته
// می‌شود.
model PurchaseCostAllocation {
  id                      Int                   @id @default(autoincrement())
  purchaseCostLineId      Int
  inventoryDocumentLineId Int
  allocatedAmount         Decimal               @db.Decimal(36, 10)
  purchaseCostLine        PurchaseCostLine      @relation(fields: [purchaseCostLineId], references: [id], onDelete: Cascade)
  inventoryDocumentLine   InventoryDocumentLine @relation(fields: [inventoryDocumentLineId], references: [id])
  amounts                 DocumentItemAmount[]

  @@unique([purchaseCostLineId, inventoryDocumentLineId])
}

model Customer {
  id              Int            @id @default(autoincrement())
  code            Int            @unique
  partyId         Int            @unique
  isActive        Boolean        @default(true)
  hasTransactions Boolean        @default(false)
  createdAt       DateTime       @default(now())
  party           Party          @relation(fields: [partyId], references: [id])
  salesInvoices   SalesInvoice[]
  salesReturnInvoices SalesReturnInvoice[]
