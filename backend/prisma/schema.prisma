  @@unique([warehouseId, parentId, code])
}

model GoodsGroupLevel {
  id               Int          @id @default(autoincrement())
  code             Int          @unique
  title            String       @unique
  order            Int          @unique
  codeLength       Int
  affectsGoodsCode Boolean      @default(true)
  createdAt        DateTime     @default(now())
