model SupplyRequest {
  id             Int                 @id @default(autoincrement())
  fiscalPeriodId Int
  number         Int
  date           DateTime            @db.Date
  basis          SupplyRequestBasis
  route          SupplyRoute
  orgUnitId      Int
  description    String?
  status         RequestStatus       @default(DRAFT)
  reviewerId     Int?
  reviewedAt     DateTime?
  approverId     Int?
  approvedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @default(now()) @updatedAt
  approver       User?               @relation("SupplyRequestApprover", fields: [approverId], references: [id])
  fiscalPeriod   FiscalPeriod        @relation(fields: [fiscalPeriodId], references: [id])
  orgUnit        OrgUnit             @relation(fields: [orgUnitId], references: [id])
  reviewer       User?               @relation("SupplyRequestReviewer", fields: [reviewerId], references: [id])
