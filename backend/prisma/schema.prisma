  levelId           Int
  code              String
  title             String
  isLastBranch      Boolean               @default(false)
  affectsGoodsTitle Boolean               @default(false)
  childCodeLength   Int?
  isActive          Boolean               @default(true)
  hasTransactions   Boolean               @default(false)
  /// نوع گروه (کالا/خدمت) — فقط روی گروه‌های ریشه (parentId = null) مقدار دارد؛ زیرشاخه‌ها نوع ریشه‌ی خودشان را به ارث می‌برند
