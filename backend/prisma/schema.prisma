model ChequeItem {
  id                      Int                            @id @default(autoincrement())
  direction               ChequeDirection
  number                  String
  dueDate                 DateTime                       @db.Date
  bankBranchId            Int?
  ownerBankAccountId      Int?
  partyId                 Int
  amount                  Decimal                        @db.Decimal(18, 2)
  currencyId              Int
  status                  ChequeStatus                   @default(IN_HAND)
  // شمارنده‌ی نسخه (فاز ۲.۲): با هر رویداد چرخه‌ی عمر (ایجاد، خرج/ظهرنویسی، واگذاری، برگشت از
  // واگذاری، نتیجه وصول/برگشت) یک واحد بالا می‌رود. همان مقدار روی ردیف سندی که آن رویداد را ایجاد
  // کرده (فیلد chequeStep در ۶ جدول ردیف مرتبط) هم ذخیره می‌شود؛ فقط وقتی chequeStep یک ردیف با
  // step فعلی همین چک برابر باشد، آن ردیف «آخرین اتفاق» برای این چک است و بدون برگشت از تایید کل
  // سند مادر، مستقیماً از همان سند قابل ویرایش/حذف (و افزودن ردیف تازه) است — نگاه کنید به توضیح
  // بالای هرکدام از فایل‌های routes/receipts.ts, payments.ts, chequeDeposits.ts,
  // chequeDepositReturns.ts, chequeClearingReceivable.ts, chequeClearingPayable.ts.
  step                    Int                            @default(1)
  description             String?
  createdAt               DateTime                       @default(now())
  bankBranch              BankBranch?                    @relation(fields: [bankBranchId], references: [id])
  currency                Currency                       @relation(fields: [currencyId], references: [id])
  ownerBankAccount        BankAccount?                   @relation(fields: [ownerBankAccountId], references: [id])
  party                   Party                          @relation(fields: [partyId], references: [id])
  paymentInstrumentLines  PaymentInstrumentLine[]
  receiptInstrumentLines  ReceiptInstrumentLine[]
  depositLines            ChequeDepositLine[]
  depositReturnLines      ChequeDepositReturnLine[]
  clearingReceivableLines ChequeClearingReceivableLine[]
  clearingPayableLines    ChequeClearingPayableLine[]
}

