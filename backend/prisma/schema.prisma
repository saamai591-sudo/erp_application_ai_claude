  code                           Int                              @unique
  title                          String                           @unique
  nature                         PurchaseNature
  hasTransactions                Boolean                          @default(false)
  createdAt                      DateTime                         @default(now())
  purchaseInvoices               PurchaseInvoice[]
  servicePurchaseInvoices        ServicePurchaseInvoice[]
  goodsServiceAccountingSettings GoodsServiceAccountingSetting[]
}

/// دقیقاً هم‌الگوی PurchaseType — طبق تصمیم صریح کاربر (۱۴۰۵/۰۶/۱۷).
model SalesType {
  id                             Int                              @id @default(autoincrement())
  code                           Int                              @unique
  title                          String                           @unique
  nature                         SalesNature
  hasTransactions                Boolean                          @default(false)
