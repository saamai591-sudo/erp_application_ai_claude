  // ChequeItem.step).
  chequeStep      Int?
  chequeDeposit   ChequeDeposit @relation(fields: [chequeDepositId], references: [id], onDelete: Cascade)
  chequeItem      ChequeItem    @relation(fields: [chequeItemId], references: [id])
}

