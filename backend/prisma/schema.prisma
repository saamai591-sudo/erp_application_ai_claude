model GoodsRequestLine {
  id                  Int                     @id @default(autoincrement())
  goodsRequestId      Int
  rowOrder            Int                     @default(0)
  goodsItemId         Int
  unitId              Int
  quantity            Decimal                 @db.Decimal(36, 10)
  approvedQuantity    Decimal?                @db.Decimal(36, 10)
  costCenterId        Int?
  projectId           Int?
  partyId             Int?
  description         String?
  approvalDescription String?
  costCenter          CostCenter?             @relation(fields: [costCenterId], references: [id])
  goodsItem           GoodsItem               @relation(fields: [goodsItemId], references: [id])
  goodsRequest        GoodsRequest            @relation(fields: [goodsRequestId], references: [id], onDelete: Cascade)
  party               Party?                  @relation(fields: [partyId], references: [id])
  project             Project?                @relation(fields: [projectId], references: [id])
  unit                UnitOfMeasure           @relation(fields: [unitId], references: [id])
  suppliedByLines     SupplyRequestLine[]     @relation("SupplyRequestSourceLine")
  warehouseIssueLines WarehouseIssueLine[]    @relation("WarehouseIssueSourceGoodsRequestLine")
