  inventoryLines         InventoryDocumentLine[] @relation("InventoryLineSourceSalesOrderLine")
}

model SalesDelivery {
  id             Int                 @id @default(autoincrement())
  warehouseId    Int
  fiscalPeriodId Int
  number         Int
  date           DateTime            @db.Date
