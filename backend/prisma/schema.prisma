/// طبق تصمیم صریح کاربر (۱۴۰۵/۰۶/۱۶): این فرم اکنون یک چرخه‌ی ذخیره→صدور واقعی دارد، دقیقاً هم‌الگوی
/// فاکتور خرید (DRAFT→APPROVED). با زدن «ذخیره»، ردیف‌های DocumentItemAmount مطابق فیلتر جاری از طریق
/// warehouseJournalEntryIssuanceId به همین هدر «قفل» می‌شوند (دیگر در پیش‌نمایش/candidates یک فرم دیگر
/// ظاهر نمی‌شوند) — تا وقتی سند صادر نشده، ذخیره‌ی دوباره مجاز است (قفل قبلی آزاد و دوباره محاسبه می‌شود).
/// با زدن «صدور سند حسابداری» دقیقاً همان ردیف‌های قفل‌شده (نه یک کوئری تازه) صاحب سند می‌شوند.
model WarehouseJournalEntryIssuance {
  id                 Int                                @id @default(autoincrement())
  fiscalPeriodId     Int
  number             Int
  toDate             DateTime                           @db.Date
  /// شناسه‌ی گروه‌های حسابداری انتخاب‌شده، جدا شده با کاما؛ null یعنی «همه‌ی گروه‌ها»
  accountingGroupIds String?
  rowCount           Int
  status             WarehouseJournalEntryIssuanceStatus @default(DRAFT)
  journalEntryId     Int?                               @unique
  createdAt          DateTime                           @default(now())
  fiscalPeriod       FiscalPeriod                       @relation(fields: [fiscalPeriodId], references: [id])
  journalEntry       JournalEntry?                      @relation(fields: [journalEntryId], references: [id])
  documentItemAmounts DocumentItemAmount[]

  @@unique([fiscalPeriodId, number])
}

enum WarehouseJournalEntryIssuanceStatus {
  DRAFT
  ISSUED
}

