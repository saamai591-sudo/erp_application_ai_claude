model JournalEntry {
  payrollSlips PayrollSlip[]
  id                  Int                  @id @default(autoincrement())
  consolidationSource ConsolidatedDocumentSource?
  settingUsages       AccountingSettingUsage[]
  fiscalPeriodId      Int
  number              Int
  referenceNumber     Int
  dailyNumber         Int
  date                DateTime             @db.Date
  documentTypeId      Int
