model SalesOrderLine {
  id                     Int                     @id @default(autoincrement())
  salesOrderId           Int
  rowOrder               Int                     @default(0)
  sourceSalesQuoteLineId Int?
  goodsItemId            Int
  unitId                 Int
  quantity               Decimal                 @db.Decimal(36, 10)
  unitPrice              Decimal                 @db.Decimal(36, 10)
  amount                 Decimal                 @db.Decimal(36, 10)
  /// طبق تصمیم صریح کاربر، هم‌الگوی SalesQuoteLine.vatAmount: همیشه به همان ارز هدر محاسبه/ذخیره
  /// می‌شود، نه ارز مبنا — این فرم هم fxRate ندارد.
  vatAmount              Decimal                 @default(0) @db.Decimal(36, 10)
  description            String?
